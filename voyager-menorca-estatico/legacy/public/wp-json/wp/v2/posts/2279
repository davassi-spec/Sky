=L.divIcon({className:\"\",html:DV+' class=\"sunset-arrow\" style=\"transform:rotate('+(B-90)+'deg)\">\u27a4'+DVC,iconSize:[28,28],iconAnchor:[14,14]});L.marker(e,{icon:ai,interactive:false}).addTo(map);bounds.push(e);}});regs.forEach(function(r){var ri=L.divIcon({className:\"\",html:DV+' class=\"reg-marker-ecl\">!'+DVC,iconSize:[34,34],iconAnchor:[17,17],popupAnchor:[0,-19]});L.marker([r.lat,r.lng],{icon:ri,title:r.name+\" (acceso regulado)\"}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#8a3d09;margin-bottom:5px;\">'+r.name+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+r.det+DVC);bounds.push([r.lat,r.lng]);});map.fitBounds(bounds,{padding:[32,32],maxZoom:12});L.control.scale({imperial:false,position:\"bottomleft\"}).addTo(map);var lg=L.control({position:\"topright\"});lg.onAdd=function(){var d=L.DomUtil.create(\"div\",\"eclipse-map-legend\");d.innerHTML='<strong>Leyenda<\/strong><span class=\"legend-zoo\">ZOO<\/span>Zona de observaci\u00f3n oficial<br \/><span class=\"legend-reg\">!<\/span>Acceso regulado \/ zona de riesgo<br \/><span class=\"legend-arrow\">\u27a4<\/span>Ocaso 288\u00b0 \u00b7 oeste-noroeste';return d;};lg.addTo(map);map.on(\"click\",function(){map.scrollWheelZoom.enable();});map.on(\"mouseout\",function(){map.scrollWheelZoom.disable();});}function ensureLeaflet(cb){if(window.L&&window.L.map){cb();return;}if(!document.querySelector('link[href*=\"'+LF+'\"]')){var l=document.createElement(\"link\");l.rel=\"stylesheet\";l.href=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".css\";document.head.appendChild(l);}var ex=document.querySelector('script[src*=\"'+LF+'\"]');if(ex){if(window.L&&window.L.map){cb();}else{ex.addEventListener(\"load\",cb);}}else{var js=document.createElement(\"script\");js.src=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".js\";js.onload=cb;document.head.appendChild(js);}}if(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",function(){ensureLeaflet(initEclipseMap);});}else{ensureLeaflet(initEclipseMap);}})();<\/script><\/div>\n<h2 id=\"zoo\">Las 9 zonas de observaci\u00f3n oficial (ZOO) de Menorca<\/h2>\n<div style=\"border-left:4px solid #08243c;background:#eef4f9;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>Actualizaci\u00f3n de agosto de 2026.<\/strong> El Govern de les Illes Balears ha habilitado <strong>26 zonas de observaci\u00f3n oficial (ZOO)<\/strong> en el conjunto de Baleares, <strong>nueve de ellas en Menorca<\/strong>. Se eligieron entre m\u00e1s de un centenar de emplazamientos posibles valorando visibilidad, accesibilidad, capacidad de acogida, aparcamiento y posibilidad de intervenci\u00f3n de los servicios de emergencia. El propio Govern lo dice con claridad: <strong>no son necesariamente los lugares desde donde mejor se ver\u00e1 el eclipse<\/strong>, sino aquellos donde puede garantizar mejor la seguridad de las personas.<\/p>\n<\/div>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Zona de observaci\u00f3n oficial<\/th>\n<th>Municipio<\/th>\n<th>Detalle<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td><strong>Cala en Bosc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Desde el aparcamiento del paseo mar\u00edtimo hasta el faro de Cap d\u2019Artrutx<\/td>\n<\/tr>\n<tr>\n<td><strong>Cala Blanca<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Del Clot de sa Cera al restaurante Es Mirador<\/td>\n<\/tr>\n<tr>\n<td><strong>Avinguda Los Delfines<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Urbanizaci\u00f3n de Cala en Blanes \/ Los Delfines, costa noroeste<\/td>\n<\/tr>\n<tr>\n<td><strong>Son Blanc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Franja litoral al sur del puerto, junto a Son Oleo<\/td>\n<\/tr>\n<tr>\n<td><strong>Carrer des Tamarells<\/strong><\/td>\n<td>Es Mercadal<\/td>\n<td>Platges de Fornells, costa norte<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Son Bou<\/strong><\/td>\n<td>Alaior<\/td>\n<td>Acceso recomendado por Torre Sol\u00ed, con bus lanzadera<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Sant Tom\u00e0s<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>Costa sur<\/td>\n<\/tr>\n<tr>\n<td><strong>Talis<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>Costa sur, junto a Sant Tom\u00e0s<\/td>\n<\/tr>\n<tr>\n<td><strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong><\/td>\n<td>Ma\u00f3<\/td>\n<td>Posible cierre al tr\u00e1fico a partir de las 19:00<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<p><strong>C\u00f3mo lo leo yo, como gu\u00eda local.<\/strong> Las ZOO resuelven la seguridad y el aparcamiento, no la visibilidad. Con el Sol a unos 2\u00b0 de altura y un acimut de 288\u00b0 (oeste-noroeste), las cuatro zonas de Ciutadella \u2014<strong>Cala en Bosc, Cala Blanca, Son Blanc y Avinguda Los Delfines<\/strong>\u2014 son las que combinan mejor el dispositivo oficial con un horizonte marino limpio en la direcci\u00f3n correcta. En las zonas de la costa sur (Son Bou, Sant Tom\u00e0s, Talis) y en el Passeig Mar\u00edtim de Ma\u00f3, la l\u00ednea del ocaso queda m\u00e1s rasante respecto a la propia costa o al casco urbano: son perfectamente v\u00e1lidas y seguras, pero conviene <strong>comprobar el perfil real del horizonte con la app Horitz\u00f3 Eclipsi 2026<\/strong> desde el punto concreto donde pienses colocarte.<\/p>\n<p>Y una recomendaci\u00f3n que vale m\u00e1s que cualquier lista: si puedes verlo desde tu propio alojamiento o desde una zona a la que llegues caminando, y tienes horizonte oeste, hazlo. Es la forma m\u00e1s segura de evitar desplazamientos, colapsos y sorpresas de \u00faltima hora.<\/p>\n<h2 id=\"donde\">Los mejores lugares para ver el eclipse en Menorca<\/h2>\n<p>Como el Sol estar\u00e1 casi tocando el horizonte, la clave no es la altura sino <strong>un horizonte oeste completamente abierto y sin obst\u00e1culos<\/strong>: sin monta\u00f1as, edificios, arboledas ni nubes bajas. Todos los puntos recomendados est\u00e1n en la mitad occidental de la isla. Los agrupo por tipo para que elijas seg\u00fan tu plan, pero ten en cuenta el <a href=\"#afluencia\">dispositivo oficial de accesos<\/a>: varios de ellos est\u00e1n regulados el 12 de agosto.<\/p>\n<h3>Mejores playas y calas para observarlo<\/h3>\n<ul>\n<li><strong>Cala en Bosc (zona de observaci\u00f3n oficial):<\/strong> costa abierta al ocaso, con paseo junto al mar, bares y aseos a mano. La ZOO abarca desde el aparcamiento del paseo mar\u00edtimo hasta el faro de Cap d\u2019Artrutx. El aparcamiento es amplio pero se llenar\u00e1 muy pronto ese d\u00eda, y a esa hora apenas queda sombra. El tr\u00e1fico se cerrar\u00e1 a partir de las 17:00, o antes si la afluencia lo exige.<\/li>\n<li><strong>Cala Blanca (zona de observaci\u00f3n oficial):<\/strong> algo menos concurrida, con horizonte abierto al oeste desde las rocas laterales de la cala y restaurantes en la propia urbanizaci\u00f3n. La ZOO va del Clot de sa Cera al restaurante Es Mirador. Se aparca en calle; conviene llegar con margen y caminar los \u00faltimos metros.<\/li>\n<li><strong>Cala Santandria:<\/strong> ensenada resguardada del viento a pocos minutos de Ciutadella, c\u00f3moda para familias, con bares junto a la arena. No es zona oficial, as\u00ed que no habr\u00e1 dispositivo espec\u00edfico: el aparcamiento en calle es limitado y cuanto antes llegues, mejor sitio.<\/li>\n<li><strong>Son Xoriguer y la zona de Cap d\u2019Artrutx:<\/strong> el extremo suroeste de la isla, con el faro de Artrutx como referencia, paseo llano orientado de lleno a la puesta de sol y servicios de Cala en Bosc a un corto paseo. Suele correr brisa marina: agradable en agosto, pero sujeta el tr\u00edpode.<\/li>\n<\/ul>\n<h3>Mejores faros<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (acceso regulado el 12 de agosto):<\/strong> ofrece un horizonte excelente hacia el oeste, pero el dispositivo oficial <strong>cierra el aparcamiento desde las 8:00<\/strong> y regula el acceso por la carretera CF-5. Ciutadella lo considera adem\u00e1s <strong>zona de riesgo<\/strong>, junto con Cala Morell y el Pont d\u2019en Gil, con control de la Polic\u00eda Local. No cuentes con poder llegar en coche ese d\u00eda. Fuera del 12 de agosto sigue siendo una maravilla: est\u00e1 en pleno <a href=\"https:\/\/voyagermenorca.com\/guia-turistico-cami-de-cavalls\/\">Cam\u00ed de Cavalls<\/a> y es una de las zonas de m\u00e1xima oscuridad de la isla.<\/li>\n<li><strong>Far d\u2019Artrutx:<\/strong> en el v\u00e9rtice suroeste, con orientaci\u00f3n perfecta al ocaso, terreno llano y aparcamiento relativamente cercano. Queda dentro de la zona de observaci\u00f3n oficial de Cala en Bosc: de los faros, el m\u00e1s c\u00f3modo y el \u00fanico con dispositivo oficial.<\/li>\n<li><strong>Far de Cavalleria (acceso regulado el 12 de agosto):<\/strong> sus acantilados abiertos al oeste ofrecen un horizonte limpio y un entorno espectacular, pero el <strong>Cam\u00ed de Tramuntana hasta el faro (CF-3) estar\u00e1 regulado<\/strong> ese d\u00eda, igual que el propio Cam\u00ed de Tramuntana en la rotonda de intersecci\u00f3n Me-15 \/ Me-7. La alternativa oficial en esa zona de la isla es el Carrer des Tamarells, en Platges de Fornells.<\/li>\n<\/ul>\n<p>Puedes ampliar en nuestra <a href=\"https:\/\/voyagermenorca.com\/guia-faros-menorca\/\">gu\u00eda de los 7 faros de Menorca<\/a>.<\/p>\n<h3>Mejores acantilados y miradores<\/h3>\n<ul>\n<li><strong>Acantilados de Punta Nati y de la costa norte de Ciutadella:<\/strong> altura y un horizonte marino de 180\u00b0, pero afectados por el mismo dispositivo de accesos que el faro de Punta Nati.<\/li>\n<li><strong>Pont d\u2019en Gil:<\/strong> el arco natural de la costa oeste, uno de los miradores de atardecer m\u00e1s famosos de la isla, pero <strong>considerado zona de riesgo el 12 de agosto<\/strong>, con control policial. Se llega caminando desde la zona de Cala en Blanes por un tramo de costa sin sombra ni servicios y con acantilado abierto: no es el sitio para una noche de m\u00e1xima afluencia. Alternativa oficial muy cercana: la <strong>Avinguda Los Delfines<\/strong>.<\/li>\n<li><strong>Passeig Mar\u00edtim de Ciutadella:<\/strong> llano, pavimentado y accesible, con vista despejada al mar, el puerto y el casco antiguo de fondo, y bares y servicios a un paso. No figura como zona oficial, pero es de lo m\u00e1s concurrido de la isla: reserva tu sitio con mucha antelaci\u00f3n. La zona oficial m\u00e1s pr\u00f3xima es Son Blanc. Ver nuestra gu\u00eda de <a href=\"https:\/\/voyagermenorca.com\/atardecer-menorca-9-miradores\/\">9 miradores para el atardecer en Menorca<\/a>.<\/li>\n<\/ul>\n<h3>Desde el mar<\/h3>\n<p>Observar el eclipse desde el mar puede ofrecer un horizonte despejado, pero requiere una planificaci\u00f3n profesional. Solo debe hacerse con un patr\u00f3n experimentado o una empresa autorizada, consultando previamente la previsi\u00f3n mar\u00edtima, los avisos de navegaci\u00f3n y las restricciones que puedan establecerse. El Consell Insular recuerda adem\u00e1s <strong>no fondear sobre praderas de posidonia<\/strong>, mantener distancia de seguridad entre embarcaciones, evitar maniobras de riesgo y planificar con antelaci\u00f3n el regreso a puerto, porque se prev\u00e9 una concentraci\u00f3n muy alta de embarcaciones justo al final del eclipse.<\/p>\n<h3>Yacimientos arqueol\u00f3gicos<\/h3>\n<p>El Consell Insular desplegar\u00e1 vigilantes en el <strong>castell de Santa \u00c0gueda<\/strong> y en <strong>Torre d\u2019en Galm\u00e8s<\/strong> y otros yacimientos de titularidad p\u00fablica, para ordenar los accesos y evitar que se suba a talaiots, torres y estructuras patrimoniales. Son monumentos de m\u00e1s de tres mil a\u00f1os: se miran, no se escalan.<\/p>\n<h3>Tabla comparativa de puntos de observaci\u00f3n<\/h3>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Lugar<\/th>\n<th>Tipo<\/th>\n<th>Horizonte oeste<\/th>\n<th>Afluencia prevista<\/th>\n<th>Acceso el 12 de agosto<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Cala en Bosc <em>(oficial)<\/em><\/td>\n<td>Playa<\/td>\n<td>Excelente<\/td>\n<td>Alta<\/td>\n<td>F\u00e1cil, con servicios; tr\u00e1fico cerrado desde las 17:00<\/td>\n<\/tr>\n<tr>\n<td>Cala Blanca <em>(oficial)<\/em><\/td>\n<td>Playa<\/td>\n<td>Excelente<\/td>\n<td>Media-alta<\/td>\n<td>F\u00e1cil; tr\u00e1fico cerrado desde las 17:00<\/td>\n<\/tr>\n<tr>\n<td>Son Blanc <em>(oficial)<\/em><\/td>\n<td>Litoral urbano<\/td>\n<td>Muy bueno<\/td>\n<td>Alta<\/td>\n<td>A pie desde Ciutadella; tr\u00e1fico cerrado desde las 17:00<\/td>\n<\/tr>\n<tr>\n<td>Avinguda Los Delfines <em>(oficial)<\/em><\/td>\n<td>Paseo urbano<\/td>\n<td>Muy bueno<\/td>\n<td>Media-alta<\/td>\n<td>F\u00e1cil; tr\u00e1fico cerrado desde las 17:00<\/td>\n<\/tr>\n<tr>\n<td>Cap d\u2019Artrutx \/ Far d\u2019Artrutx<\/td>\n<td>Faro\/costa<\/td>\n<td>Excelente<\/td>\n<td>Media<\/td>\n<td>Dentro de la zona oficial de Cala en Bosc<\/td>\n<\/tr>\n<tr>\n<td>Passeig Mar\u00edtim de Ciutadella<\/td>\n<td>Paseo urbano<\/td>\n<td>Muy bueno<\/td>\n<td>Muy alta<\/td>\n<td>F\u00e1cil, a pie desde el centro; sin dispositivo oficial<\/td>\n<\/tr>\n<tr>\n<td>Cala Santandria<\/td>\n<td>Cala<\/td>\n<td>Bueno<\/td>\n<td>Media-alta<\/td>\n<td>F\u00e1cil, familiar; sin dispositivo oficial<\/td>\n<\/tr>\n<tr>\n<td>Far de Punta Nati<\/td>\n<td>Faro\/acantilado<\/td>\n<td>Excelente<\/td>\n<td>Zona de riesgo<\/td>\n<td>Carretera CF-5 regulada y aparcamiento cerrado desde las 8:00<\/td>\n<\/tr>\n<tr>\n<td>Far de Cavalleria<\/td>\n<td>Faro\/acantilado<\/td>\n<td>Bueno<\/td>\n<td>Alta<\/td>\n<td>Acceso CF-3 regulado<\/td>\n<\/tr>\n<tr>\n<td>Desde el mar (costa oeste)<\/td>\n<td>Embarcaci\u00f3n<\/td>\n<td>Total<\/td>\n<td>\u2014<\/td>\n<td>Solo con patr\u00f3n experimentado o empresa autorizada<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"orientacion\">Orientaci\u00f3n del Sol y horizonte<\/h2>\n<p>En el momento del m\u00e1ximo, el Sol se encontrar\u00e1 hacia el <strong>oeste-noroeste, con un acimut de unos 288\u00b0<\/strong>. Traducido a la pr\u00e1ctica: sit\u00faate mirando al mar en la costa oeste y busca el punto por donde el Sol se est\u00e1 poniendo. Una br\u00fajula (o la de la app Horitz\u00f3 2026) te confirmar\u00e1 la direcci\u00f3n exacta. Comprueba el d\u00eda anterior, a la misma hora, que no haya ning\u00fan obst\u00e1culo (gr\u00faa, m\u00e1stil, promontorio) en esa l\u00ednea. El Govern hizo un ensayo oficial de visibilidad los d\u00edas 29 y 30 de abril precisamente para verificar estos puntos: si el Sol se ve\u00eda a esa hora esos d\u00edas, se ver\u00e1 tambi\u00e9n el 12 de agosto.<\/p>\n<h2 id=\"meteo\">Meteorolog\u00eda: probabilidad de cielos despejados<\/h2>\n<p>Agosto es, climatol\u00f3gicamente, uno de los meses m\u00e1s estables y secos de Menorca, con predominio de cielos despejados y baja probabilidad de precipitaci\u00f3n. Eso juega a favor. Pero un eclipse tan bajo sobre el horizonte tiene un enemigo espec\u00edfico: <strong>las nubes bajas sobre el mar<\/strong>, que pueden formarse aunque el resto del cielo est\u00e9 limpio. Recomendaciones:<\/p>\n<ul>\n<li>Revisa la previsi\u00f3n de <strong>AEMET<\/strong> y mapas de nubosidad los 3-4 d\u00edas previos, prestando atenci\u00f3n a la nubosidad baja en el horizonte marino.<\/li>\n<li>Ten siempre un <strong>plan B<\/strong> en otro punto de la costa oeste al que puedas desplazarte con margen, teniendo en cuenta las restricciones de tr\u00e1fico previstas.<\/li>\n<li>Recuerda que las <strong>nubes altas<\/strong> (cirros) todav\u00eda permiten ver el fen\u00f3meno; las bajas son las que lo arruinan.<\/li>\n<li>Desde el mar hay m\u00e1s margen para esquivar la nubosidad, pero solo con un patr\u00f3n experimentado o una empresa autorizada (ver el apartado \u00abDesde el mar\u00bb).<\/li>\n<\/ul>\n<h2 id=\"luminica\">Contaminaci\u00f3n lum\u00ednica y la ventaja Starlight de Menorca<\/h2>\n<p>Menorca es <strong>Reserva y Destino Tur\u00edstico Starlight<\/strong> desde 2019 (certificaci\u00f3n de la Fundaci\u00f3n Starlight), y toda la isla forma parte de una Reserva de la Biosfera. Cuenta con un Reglamento de Protecci\u00f3n del Cielo Nocturno y con <strong>zonas de m\u00e1xima oscuridad<\/strong> \u2014Punta Nati, Macarella-Son Saura, Cavalleria-Cala del Pilar, Monte Toro, s\u2019Albufera des Grau, entre otras\u2014 con una contaminaci\u00f3n lum\u00ednica pr\u00e1cticamente inexistente.<\/p>\n<p>Para el eclipse en s\u00ed, con el Sol a\u00fan sobre el horizonte, la contaminaci\u00f3n lum\u00ednica no es determinante. Pero se vuelve decisiva justo despu\u00e9s: si te quedas en un punto oscuro de la costa oeste tras la puesta de sol, tendr\u00e1s un cielo excepcional para la segunda parte de la noche (ver Perseidas, m\u00e1s abajo). Ten en cuenta que varias de esas zonas tienen el acceso regulado el 12 de agosto.<\/p>\n<h2 id=\"afluencia\">Restricciones de acceso, afluencia y movilidad: el dispositivo oficial<\/h2>\n<p>Se espera una afluencia muy alta de \u00abcazadores de eclipses\u00bb y visitantes de toda Europa, en pleno agosto y con la isla ya en temporada alta. El Govern balear activ\u00f3 el protocolo <strong>ECLIPBAL<\/strong>, dentro del Plan Territorial de Protecci\u00f3n Civil, y el dispositivo de seguridad, movilidad y protecci\u00f3n forestal ya est\u00e1 publicado, en coordinaci\u00f3n con el Consell Insular y los ayuntamientos. Estos son los puntos que m\u00e1s te afectan como visitante.<\/p>\n<h3>Restricciones generales<\/h3>\n<ul>\n<li>En las <strong>cuatro zonas oficiales de observaci\u00f3n de Ciutadella<\/strong>, el tr\u00e1fico se cerrar\u00e1 <strong>a partir de las 17:00<\/strong>, o antes si la afluencia lo exige.<\/li>\n<li>En el <strong>resto de Menorca<\/strong>, los horarios y las restricciones dependen de cada carretera y municipio. Con car\u00e1cter general, las restricciones en las v\u00edas afectadas se aplicar\u00e1n <strong>entre las 15:00 y las 21:00<\/strong>, aunque podr\u00e1n adelantarse o prolongarse por razones de seguridad.<\/li>\n<li>Las restricciones <strong>no afectan<\/strong> a residentes, servicios esenciales, transporte p\u00fablico ni desplazamientos debidamente justificados.<\/li>\n<\/ul>\n<h3>Accesos regulados o cerrados en Menorca<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (CF-5):<\/strong> acceso regulado y <strong>aparcamiento cerrado desde las 8:00<\/strong>.<\/li>\n<li><strong>Cam\u00ed de Tramuntana:<\/strong> regulaci\u00f3n en la rotonda de intersecci\u00f3n Me-15 \/ Me-7.<\/li>\n<li><strong>Far de Cavalleria (CF-3):<\/strong> Cam\u00ed de Tramuntana hasta el faro, regulado.<\/li>\n<li><strong>Monte Toro (Me-13):<\/strong> carretera des Mercadal al Toro, regulada.<\/li>\n<li><strong>Ferreries:<\/strong> cierre de los caminos de acceso a l\u2019Enclusa y al Cam\u00ed de Tramuntana d\u2019Ets Alocs, con cierres graduales (primero parcial en la Me-1, despu\u00e9s en el acceso a la finca de Binissu\u00e8s y, finalmente, acceso solo para residentes de las fincas del Cam\u00ed de Tramuntana y alojamientos tur\u00edsticos).<\/li>\n<li><strong>Sant Llu\u00eds:<\/strong> Passeig de Cap d\u2019en Font cerrado en las dos intersecciones con el carrer del Cal\u00f3 Blanc, y Passeig de la Mar (Binissaf\u00faller Roters) en los cruces con Llevant y Tramuntana, <strong>entre las 19:00 y las 21:30<\/strong>.<\/li>\n<li><strong>Ma\u00f3:<\/strong> posible cierre del Passeig Mar\u00edtim desde las 19:00 y restricciones en Binidal\u00ed desde las 18:30; controles en Es Canutells, Es Grau y otros puntos de afluencia; acceso restringido a Fav\u00e0ritx y cierre de las bater\u00edas durante la jornada.<\/li>\n<li><strong>Ciutadella:<\/strong> <strong>Cala Morell, el Far de Punta Nati y el Pont d\u2019en Gil<\/strong> est\u00e1n considerados zonas de riesgo, con control de la Polic\u00eda Local.<\/li>\n<\/ul>\n<h3>Pantallas para seguir el eclipse sin desplazarte<\/h3>\n<p>Si prefieres evitar carreteras y aglomeraciones, varios municipios instalar\u00e1n pantallas: <strong>Ciutadella<\/strong>, en la Pla\u00e7a des Born; <strong>Alaior<\/strong>, en Sa Pla\u00e7a; y <strong>Ma\u00f3<\/strong>, en los Cinemes Ocimax y en el puerto.<\/p>\n<h3>Aparcamiento y bus lanzadera<\/h3>\n<p>Para la zona de <strong>Son Bou<\/strong> se recomienda acceder por <strong>Torre Sol\u00ed<\/strong>, donde se habilitar\u00e1 un aparcamiento en Torre Sol\u00ed II con <strong>bus lanzadera continuo entre las 17:00 y las 00:30<\/strong>. Es, probablemente, la opci\u00f3n m\u00e1s c\u00f3moda de toda la isla si vas sin prisa y quieres olvidarte del coche.<\/p>\n<p><strong>Consecuencia pr\u00e1ctica:<\/strong> no dependas de un \u00fanico acceso ni improvises a \u00faltima hora. Las medidas se ir\u00e1n actualizando en los d\u00edas previos en funci\u00f3n de la afluencia prevista, as\u00ed que <strong>consulta <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">la informaci\u00f3n oficial del Govern<\/a> el mismo d\u00eda<\/strong>, y sigue en todo momento las indicaciones de los servicios de emergencia.<\/p>\n<h2 id=\"como-llegar\">C\u00f3mo llegar, aparcamiento y transporte p\u00fablico<\/h2>\n<h3>C\u00f3mo llegar a la costa oeste<\/h3>\n<p>La mayor\u00eda de puntos recomendados est\u00e1n en el t\u00e9rmino de Ciutadella, en el extremo oeste de la isla, a unos 45 minutos en coche del aeropuerto de Ma\u00f3 por la carretera general Me-1. Desde Ciutadella, las urbanizaciones del suroeste (Cala en Bosc, Cala Blanca, Cala Santandria) est\u00e1n a 10-15 minutos. Ese d\u00eda, cuenta con mucho m\u00e1s tiempo del habitual.<\/p>\n<h3>Aparcamiento<\/h3>\n<ul>\n<li>En Ciutadella hay aparcamiento gratuito en el paseo de Sant Nicolau y el paseo mar\u00edtimo, adem\u00e1s de zona azul en el centro.<\/li>\n<li>Si vas en coche a una de las zonas oficiales de Ciutadella, <strong>llega antes de las 17:00<\/strong>, porque el tr\u00e1fico puede cerrarse incluso antes seg\u00fan la afluencia. Siempre que sea posible, ve caminando desde tu alojamiento o utiliza el transporte p\u00fablico.<\/li>\n<li>En puntos naturales, el espacio es limitado y varios accesos est\u00e1n regulados: no aparques nunca fuera de las zonas permitidas ni bloquees caminos o accesos de emergencia.<\/li>\n<\/ul>\n<h3>Transporte p\u00fablico<\/h3>\n<p>Menorca cuenta con l\u00edneas regulares de autob\u00fas que conectan Ma\u00f3 y Ciutadella durante todo el a\u00f1o, y en verano hay servicios desde la estaci\u00f3n de Ciutadella hacia las calas del sur y suroeste. Ese d\u00eda habr\u00e1 m\u00e1s demanda de lo habitual y es posible que se refuercen o reorganicen algunas l\u00edneas: comprueba horarios actualizados con el operador. Ir en transporte p\u00fablico \u2014o usar el bus lanzadera de Torre Sol\u00ed para Son Bou\u2014 y caminar el \u00faltimo tramo puede ahorrarte el problema del aparcamiento.<\/p>\n<h2 id=\"seguridad\">Seguridad ocular: lo m\u00e1s importante de todo<\/h2>\n<p>Nunca se puede mirar directamente al Sol sin protecci\u00f3n adecuada, <strong>excepto cuando el disco solar queda completamente cubierto por la Luna durante la totalidad<\/strong>.<\/p>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-seguridad-eclipse-eso.jpg?w=800&#038;ssl=1\" alt=\"Infograf\u00eda en espa\u00f1ol sobre c\u00f3mo observar un eclipse solar con seguridad ocular\" \/><figcaption>C\u00f3mo observar el eclipse con seguridad ocular. Cr\u00e9dito: ESO \/ B. Tafreshi (twanight.org) \/ P. Hor\u00e1lek.<\/figcaption><\/figure>\n<ul>\n<li>Usa siempre <strong>gafas de eclipse homologadas<\/strong> (norma <strong>ISO 12312-2<\/strong>) siempre que mires directamente al Sol durante las fases parciales. Unas gafas de sol normales, por oscuras que parezcan, no protegen: dejan pasar radiaci\u00f3n infrarroja y ultravioleta que puede da\u00f1ar la retina sin que lo notes. Tampoco sirven radiograf\u00edas, cristales ahumados ni filtros caseros.<\/li>\n<li>Compra las gafas con antelaci\u00f3n y a un proveedor fiable: los d\u00edas previos se agotan. El Govern ha recordado al sector comercial que solo deben venderse productos que cumplan la normativa internacional.<\/li>\n<li><strong>Qu\u00edtate las gafas \u00fanicamente cuando el Sol est\u00e9 completamente cubierto y ya no se vea ninguna parte brillante. Vuelve a pon\u00e9rtelas inmediatamente cuando reaparezca el primer destello de luz.<\/strong> Las horas son solo orientativas: gu\u00edate por lo que ves, no por el reloj.<\/li>\n<li>Si usas c\u00e1mara, prism\u00e1ticos o telescopio, necesitan su <strong>propio filtro solar<\/strong> durante la parcial; mirar el Sol a trav\u00e9s de \u00f3ptica sin filtro es especialmente peligroso.<\/li>\n<li>Un m\u00e9todo alternativo y totalmente seguro es la <strong>proyecci\u00f3n indirecta<\/strong>: haz un peque\u00f1o agujero en una cartulina y proyecta la imagen del Sol sobre otra superficie, sin mirar nunca directamente.<\/li>\n<\/ul>\n<h2 id=\"equipo\">Equipo recomendado<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Imprescindible<\/th>\n<th>Recomendable<\/th>\n<th>Para fotograf\u00eda<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Gafas de eclipse ISO 12312-2 (una por persona + repuesto)<\/td>\n<td>Silla plegable o manta<\/td>\n<td>Tr\u00edpode estable<\/td>\n<\/tr>\n<tr>\n<td>Agua y algo de comer<\/td>\n<td>Gorra y protecci\u00f3n solar<\/td>\n<td>Filtro solar para el objetivo<\/td>\n<\/tr>\n<tr>\n<td>Reloj\/m\u00f3vil en hora local<\/td>\n<td>Bater\u00eda externa<\/td>\n<td>Teleobjetivo (200-500 mm ideal)<\/td>\n<\/tr>\n<tr>\n<td>Protecci\u00f3n para el m\u00f3vil si vas a fotografiar la parcial<\/td>\n<td>Linterna roja (no deslumbra)<\/td>\n<td>Disparador remoto o temporizador<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"fotografia\">Fotograf\u00eda del eclipse<\/h2>\n<p>Fotografiar un eclipse con el Sol a 2\u00b0 sobre el mar es dif\u00edcil y precioso a la vez. Ideas para que salga bien:<\/p>\n<ul>\n<li><strong>Fase parcial:<\/strong> filtro solar obligatorio en el objetivo. Sin \u00e9l, da\u00f1ar\u00e1s el sensor (y tu vista si usas visor \u00f3ptico).<\/li>\n<li><strong>Totalidad:<\/strong> cuando el Sol est\u00e9 completamente cubierto, retira el filtro para captar la corona. Usa exposiciones variadas (horquillado) porque el rango de brillo es enorme. Vuelve a poner el filtro en cuanto reaparezca el primer destello.<\/li>\n<li><strong>Con m\u00f3vil:<\/strong> filtro solar delante de la lente en la parcial; en la totalidad puedes quitarlo. Bloquea el enfoque y la exposici\u00f3n manualmente.<\/li>\n<li><strong>Composici\u00f3n:<\/strong> aprovecha que el Sol est\u00e1 baj\u00edsimo para incluir el mar, un faro o una silueta de costa. Es el gran valor diferencial de Menorca.<\/li>\n<li><strong>Consejo de oro:<\/strong> dedica la mayor parte de ese poco m\u00e1s de un minuto a <strong>mirar<\/strong>, no a la pantalla. La corona en directo no cabe en ninguna foto.<\/li>\n<\/ul>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" loading=\"lazy\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-ajustes-camara-eclipse-menorca-2026.jpg?w=800&#038;ssl=1\" alt=\"Infograf\u00eda con los ajustes r\u00e1pidos de c\u00e1mara para fotografiar el eclipse solar: filtro solar, ISO, apertura, velocidad y enfoque para la fase parcial y la totalidad\" \/><figcaption>Ajustes orientativos de c\u00e1mara para la fase parcial (con filtro solar obligatorio) y la totalidad. Revisa el histograma y adapta la exposici\u00f3n a tu equipo.<\/figcaption><\/figure>\n<h2 id=\"familias\">Consejos para familias, ni\u00f1os, mayores y movilidad reducida<\/h2>\n<h3>Para familias y ni\u00f1os<\/h3>\n<ul>\n<li>Es una experiencia educativa magn\u00edfica: expl\u00edcales antes c\u00f3mo funciona el sistema Sol-Tierra-Luna con una linterna y dos pelotas.<\/li>\n<li><strong>El Govern recomienda que los menores de seis a\u00f1os no observen directamente el eclipse.<\/strong> Para ellos se aconseja la proyecci\u00f3n indirecta, una pantalla o la retransmisi\u00f3n televisiva.<\/li>\n<li>Los dem\u00e1s menores deben estar <strong>constantemente supervisados por una persona adulta<\/strong>, con sus propias gafas homologadas durante toda la fase parcial.<\/li>\n<li>Elige un punto c\u00f3modo y con servicios cercanos (Cala en Bosc, Cala Blanca, Son Bou con bus lanzadera) para tener aseos y sombra durante la larga espera.<\/li>\n<li>Convierte la tarde en p\u00edcnic: har\u00e1 la espera llevadera y crear\u00e1 el recuerdo.<\/li>\n<\/ul>\n<h3>Para personas mayores<\/h3>\n<ul>\n<li>Prioriza puntos con acceso f\u00e1cil y poca caminata: Son Blanc, la Avinguda Los Delfines o Cala Santandria.<\/li>\n<li>Silla con respaldo, agua abundante y protecci\u00f3n solar; la espera puede ser de varias horas con calor.<\/li>\n<li>Evita los accesos por carretera estrecha y los tramos a pie de los faros, que adem\u00e1s est\u00e1n regulados ese d\u00eda.<\/li>\n<li>Las pantallas de la Pla\u00e7a des Born (Ciutadella), Sa Pla\u00e7a (Alaior) o el puerto de Ma\u00f3 son una alternativa muy c\u00f3moda.<\/li>\n<\/ul>\n<h3>Para personas con movilidad reducida<\/h3>\n<ul>\n<li>Las zonas oficiales llanas y pavimentadas de Ciutadella \u2014<strong>Son Blanc y la Avinguda Los Delfines<\/strong>\u2014 y el <strong>Passeig Mar\u00edtim de Ciutadella<\/strong> son las mejores opciones: firme llano, horizonte oeste y servicios cerca.<\/li>\n<li>Algunas playas de Ciutadella disponen de pasarelas; consulta cu\u00e1les mantienen el acceso ese d\u00eda.<\/li>\n<li>Llega bastante antes de las 17:00 para asegurar una plaza de aparcamiento accesible cercana, dado el dispositivo especial de tr\u00e1fico.<\/li>\n<li>Consulta en <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">la web oficial<\/a> si las zonas de observaci\u00f3n habilitan espacios reservados.<\/li>\n<\/ul>\n<h2 id=\"errores\">Errores que comete la mayor\u00eda de visitantes<\/h2>\n<ul>\n<li><strong>Elegir el sitio por el paisaje y no por el horizonte oeste.<\/strong> Un mirador precioso mirando al este o tapado por una colina no sirve para este eclipse.<\/li>\n<li><strong>Dar por hecho que una zona oficial es la que mejor se ve.<\/strong> Las ZOO se eligieron por seguridad y capacidad, no por visibilidad. Comprueba tu punto con Horitz\u00f3 2026.<\/li>\n<li><strong>Llegar tarde.<\/strong> En las zonas oficiales de Ciutadella el tr\u00e1fico se cierra desde las 17:00 y hay carreteras reguladas: quien salga a \u00faltima hora puede quedarse parado durante la totalidad.<\/li>\n<li><strong>Contar con llegar en coche a Punta Nati o Cavalleria.<\/strong> Ambos accesos est\u00e1n regulados el 12 de agosto y el aparcamiento de Punta Nati cierra a las 8:00.<\/li>\n<li><strong>Usar gafas de sol normales.<\/strong> No protegen. Solo valen las homologadas ISO 12312-2.<\/li>\n<li><strong>Comprar las gafas el mismo d\u00eda.<\/strong> Se agotan; c\u00f3mpralas con antelaci\u00f3n.<\/li>\n<li><strong>No comprobar el horizonte real.<\/strong> Un m\u00e1stil, una gr\u00faa o un banco de nubes bajas pueden tapar 2\u00b0.<\/li>\n<li><strong>Mirar la totalidad a trav\u00e9s del m\u00f3vil.<\/strong> V\u00edvela con los ojos; la c\u00e1mara no capta lo que ve el ojo.<\/li>\n<li><strong>Olvidar que es al atardecer.<\/strong> Despu\u00e9s no hay margen: el Sol se pone. No habr\u00e1 \u00absegunda oportunidad\u00bb ese d\u00eda.<\/li>\n<\/ul>\n<h2 id=\"historia\">Curiosidades hist\u00f3ricas: c\u00f3mo se vivieron eclipses anteriores en Espa\u00f1a<\/h2>\n<p>El 12 de agosto de 2026 no ser\u00e1 la primera vez que las Baleares se convierten en escenario mundial de un eclipse. El <strong>30 de agosto de 1905<\/strong>, un eclipse solar total cruz\u00f3 Espa\u00f1a y fue visible como total desde las islas. A diferencia del de 2026, aquel ocurri\u00f3 al <strong>mediod\u00eda<\/strong> (hacia las 12:02 h en Baleares) y la totalidad dur\u00f3 casi <strong>cuatro minutos<\/strong>, lo que lo convirti\u00f3 en una ocasi\u00f3n cient\u00edfica extraordinaria.<\/p>\n<p>Fue un acontecimiento social y cient\u00edfico de primer orden. A la Pen\u00ednsula y las islas se desplazaron decenas de expediciones internacionales: comisiones inglesas, alemanas y de la Academia de Ciencias de Rusia. En Burgos se lanzaron globos aerost\u00e1ticos \u2014el <em>J\u00fapiter<\/em>, el <em>Urano<\/em> y el <em>Marte<\/em>\u2014 y el joven ingeniero <strong>Emilio Herrera<\/strong> se convirti\u00f3 en una de las primeras personas en observar la totalidad desde el aire, dejando una descripci\u00f3n memorable de la corona sobre un mar de nubes. En Mallorca, las expediciones se instalaron en el Vel\u00f3dromo de Son Espanyolet y en el Grand Hotel; incluso se orden\u00f3 a las f\u00e1bricas cerrar durante el eclipse para que el humo no enturbiara la atm\u00f3sfera. Uno de los impulsores de la expedici\u00f3n brit\u00e1nica, G. F. Chambers, acab\u00f3 observ\u00e1ndolo <strong>desde el mar<\/strong> \u2014 una opci\u00f3n que, con la debida planificaci\u00f3n profesional, sigue teniendo sentido 121 a\u00f1os despu\u00e9s.<\/p>\n<p>En el conjunto de Espa\u00f1a, el \u00faltimo eclipse solar total antes del de 2026 fue el del <strong>17 de abril de 1912<\/strong>. Aquellos primeros a\u00f1os del siglo XX formaron un \u00abtr\u00edo\u00bb hist\u00f3rico (1900, 1905 y 1912) que la comunidad astron\u00f3mica internacional bautiz\u00f3 como \u00ablos eclipses espa\u00f1oles\u00bb. La historia rima: 2026, 2027 y 2028 forman el nuevo tr\u00edo ib\u00e9rico.<\/p>\n<h2 id=\"perseidas\">Un broche de oro para la noche: las Perseidas<\/h2>\n<p>La fecha del eclipse coincide casi exactamente con el m\u00e1ximo de las <strong>Perseidas<\/strong>, la conocida lluvia de estrellas de agosto. Si el cielo se mantiene despejado y te encuentras en un punto oscuro de la costa oeste \u2014una de las zonas Starlight de m\u00e1xima oscuridad\u2014, puedes quedarte tras la puesta de sol y disfrutar de un segundo espect\u00e1culo astron\u00f3mico esa misma noche: dos fen\u00f3menos celestes en una sola velada, algo verdaderamente excepcional. Menorca, como Reserva Starlight, es uno de los mejores lugares del Mediterr\u00e1neo para ello.<\/p>\n<h2 id=\"planificacion\">Planificaci\u00f3n completa del d\u00eda: checklist final<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Antes del d\u00eda<\/th>\n<th>El 12 de agosto<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Comprar gafas ISO 12312-2 (con antelaci\u00f3n)<\/td>\n<td>Llegar a tu punto antes de las 17:00 (zonas de Ciutadella)<\/td>\n<\/tr>\n<tr>\n<td>Elegir 1 zona de observaci\u00f3n oficial + 1 plan B<\/td>\n<td>Aparcar pronto o usar transporte p\u00fablico \/ bus lanzadera<\/td>\n<\/tr>\n<tr>\n<td>Descargar la app Horitz\u00f3 Eclipsi 2026 y verificar el horizonte<\/td>\n<td>Colocarse mirando al oeste-noroeste (acimut \u2248 288\u00b0)<\/td>\n<\/tr>\n<tr>\n<td>Revisar previsi\u00f3n AEMET los 3-4 d\u00edas previos<\/td>\n<td>Gafas puestas desde las 19:37:16 (primer contacto)<\/td>\n<\/tr>\n<tr>\n<td>Consultar accesos y restricciones en caib.es<\/td>\n<td>Quitarse las gafas solo cuando el Sol est\u00e9 totalmente cubierto<\/td>\n<\/tr>\n<tr>\n<td>Cargar c\u00e1mara\/m\u00f3vil y preparar filtro solar<\/td>\n<td>Volver a ponerse las gafas al primer destello de luz<\/td>\n<\/tr>\n<tr>\n<td>Preparar p\u00edcnic, agua, silla, protecci\u00f3n solar<\/td>\n<td>Quedarse a las Perseidas si el cielo acompa\u00f1a<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"faq\">Preguntas frecuentes<\/h2>\n<h3>\u00bfA qu\u00e9 hora es el eclipse en Menorca?<\/h3>\n<p>En Ciutadella, seg\u00fan el IGN, el eclipse parcial empieza a las <strong>19:37:16<\/strong> y la totalidad va de las <strong>20:30:16 a las 20:31:27<\/strong> (con el m\u00e1ximo a las 20:30:51). La puesta de sol se produce a las <strong>20:45:28<\/strong>. Los tiempos pueden variar algunos segundos seg\u00fan el punto exacto de observaci\u00f3n.<\/p>\n<h3>\u00bfCu\u00e1nto dura la totalidad?<\/h3>\n<p>En Ciutadella, <strong>aproximadamente 1 minuto y 11 segundos<\/strong> (dato del IGN para el municipio). Menorca es el primer punto de Baleares donde empieza la totalidad, con el Sol entre 1,4\u00b0 y 2\u00b0 sobre el horizonte seg\u00fan la ubicaci\u00f3n: la altura m\u00e1s baja de toda Espa\u00f1a.<\/p>\n<h3>\u00bfCu\u00e1les son las zonas de observaci\u00f3n oficial en Menorca?<\/h3>\n<p>Nueve: <strong>Cala en Bosc, Cala Blanca, Avinguda Los Delfines y Son Blanc<\/strong> (Ciutadella), <strong>Carrer des Tamarells<\/strong> (Platges de Fornells), <strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong> y las playas de <strong>Son Bou, Sant Tom\u00e0s y Talis<\/strong>. En las cuatro zonas de Ciutadella el tr\u00e1fico se cierra desde las 17:00. El Govern recuerda que son los puntos m\u00e1s seguros y accesibles, no necesariamente los de mejor visibilidad.<\/p>\n<h3>\u00bfSe har\u00e1 de noche en Menorca?<\/h3>\n<p>No por completo, ya que ocurre muy cerca de la puesta de sol. El cielo se oscurecer\u00e1 notablemente, con tono crepuscular en 360\u00b0, y bajar\u00e1 la temperatura, pero no ser\u00e1 una noche cerrada.<\/p>\n<h3>\u00bfNecesito ir a un sitio especial o puedo verlo desde cualquier parte de Menorca?<\/h3>\n<p>Toda la isla est\u00e1 dentro de la franja de totalidad, as\u00ed que t\u00e9cnicamente se puede ver desde cualquier punto. Lo que marca la diferencia es tener un <strong>horizonte oeste despejado<\/strong>, porque el Sol estar\u00e1 muy bajo. Si puedes verlo desde tu alojamiento con horizonte oeste, es la opci\u00f3n m\u00e1s c\u00f3moda y segura.<\/p>\n<h3>\u00bfY si est\u00e1 nublado ese d\u00eda?<\/h3>\n<p>Agosto suele dar cielos estables en Menorca, pero nadie lo garantiza. Las nubes altas permiten ver parte del fen\u00f3meno; las bajas en el horizonte oeste podr\u00edan tapar la totalidad. Revisa la previsi\u00f3n los d\u00edas previos, comprueba tu punto con la app Horitz\u00f3 2026 y ten un plan B.<\/p>\n<h3>\u00bfC\u00f3mo protejo la vista?<\/h3>\n<p>Con gafas de eclipse homologadas <strong>ISO 12312-2<\/strong> siempre que mires al Sol durante las fases parciales. Solo puedes quit\u00e1rtelas cuando el Sol est\u00e9 completamente cubierto, y debes volver a pon\u00e9rtelas en cuanto reaparezca el primer destello. Las gafas de sol, radiograf\u00edas o cristales ahumados no sirven.<\/p>\n<h3>\u00bfPuedo hacer fotos con el m\u00f3vil?<\/h3>\n<p>S\u00ed, con un filtro solar en la lente durante la parcial. Cuando el Sol est\u00e9 completamente cubierto puedes quitarlo. Bloquea enfoque y exposici\u00f3n manualmente y prepara el encuadre antes, porque la totalidad dura poco m\u00e1s de un minuto.<\/p>\n<h3>\u00bfEs seguro para ni\u00f1os?<\/h3>\n<p>El Govern recomienda que los <strong>menores de seis a\u00f1os no observen directamente<\/strong> el eclipse: para ellos, proyecci\u00f3n indirecta, una pantalla o la retransmisi\u00f3n televisiva. El resto de menores puede observarlo con gafas homologadas durante toda la parcial y bajo supervisi\u00f3n constante de un adulto. Es una experiencia educativa magn\u00edfica.<\/p>\n<h3>\u00bfCu\u00e1ndo fue el \u00faltimo eclipse total visible en Baleares?<\/h3>\n<p>El 30 de agosto de 1905. En el conjunto de Espa\u00f1a, el \u00faltimo eclipse total anterior al de 2026 fue el del <strong>17 de abril de 1912<\/strong>. Tras el eclipse total del 2 de agosto de 2027, no habr\u00e1 otro eclipse total en Espa\u00f1a hasta <strong>2053<\/strong>; el de 2028 ser\u00e1 <strong>anular<\/strong>, no total.<\/p>\n<h3>\u00bfHabr\u00e1 cortes de tr\u00e1fico o mucha gente?<\/h3>\n<p>S\u00ed. En las cuatro zonas oficiales de Ciutadella el tr\u00e1fico se cierra <strong>desde las 17:00<\/strong> (antes si hay mucha afluencia). En el resto de la isla, las restricciones dependen de cada v\u00eda y municipio, generalmente <strong>entre las 15:00 y las 21:00<\/strong>. Est\u00e1n regulados los accesos al Far de Punta Nati (CF-5, con el aparcamiento cerrado desde las 8:00), al Cam\u00ed de Tramuntana, al Far de Cavalleria (CF-3) y al Monte Toro (Me-13), adem\u00e1s de cierres en Ferreries y Sant Llu\u00eds. Consulta el detalle en el apartado <a href=\"#afluencia\">del dispositivo oficial<\/a>.<\/p>\n<h2 id=\"fuentes\">Fuentes oficiales y cient\u00edficas<\/h2>\n<p style=\"font-size:0.95em;\">Los datos de esta gu\u00eda proceden de fuentes oficiales y cient\u00edficas, que recomendamos consultar directamente para la informaci\u00f3n m\u00e1s actualizada:<\/p>\n<ul style=\"font-size:0.95em;\">\n<li><strong>Instituto Geogr\u00e1fico Nacional (IGN)<\/strong> \u2014 <a href=\"https:\/\/eclipses.ign.es\/\" target=\"_blank\" rel=\"noopener\">eclipses.ign.es<\/a>, <a href=\"https:\/\/astronomia.ign.es\/eclipses-de-sol-y-luna\/eclipse-total-sol-de-12-de-agosto-2026\" target=\"_blank\" rel=\"noopener\">ficha del eclipse<\/a> y <a href=\"https:\/\/visualizadores.ign.es\/eclipses\" target=\"_blank\" rel=\"noopener\">visualizador de eclipses<\/a> (horarios y datos por municipio).<\/li>\n<li><strong>Govern de les Illes Balears<\/strong> \u2014 <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">informaci\u00f3n oficial del eclipse y las restricciones<\/a> y <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/zones-d-observaci%C3%B3-oficial-zoo-\" target=\"_blank\" rel=\"noopener\">zonas de observaci\u00f3n oficial (ZOO)<\/a>.<\/li>\n<li><strong>Consell Insular de Menorca y ayuntamientos<\/strong> \u2014 dispositivo insular de movilidad, accesos y protecci\u00f3n del patrimonio.<\/li>\n<li><strong>Horitz\u00f3 Eclipsi 2026<\/strong> \u2014 <a href=\"https:\/\/www.horitzo2026.com\" target=\"_blank\" rel=\"noopener\">horitzo2026.com<\/a> (app oficial de visibilidad seg\u00fan el horizonte real).<\/li>\n<li><strong>Ministerio de Transportes y Movilidad Sostenible<\/strong> \u2014 <a href=\"https:\/\/www.transportes.gob.es\/movilidad-sostenible\/estudios-movilidad-big-data\/el-trio-de-eclipses-solares-y-la-movilidad\" target=\"_blank\" rel=\"noopener\">visor HERMES y estudio de movilidad del tr\u00edo de eclipses<\/a>.<\/li>\n<li><strong>NASA<\/strong> \u2014 <a href=\"https:\/\/science.nasa.gov\/eclipses\/safety\/\" target=\"_blank\" rel=\"noopener\">science.nasa.gov\/eclipses\/safety<\/a> (seguridad ocular) y <a href=\"https:\/\/ciencia.nasa.gov\/eclipses\/lo-que-necesitas-saber-sobre-los-eclipses-solares\/\" target=\"_blank\" rel=\"noopener\">ciencia.nasa.gov<\/a>.<\/li>\n<li><strong>European Southern Observatory (ESO)<\/strong> \u2014 material de seguridad ocular.<\/li>\n<li><strong>Fundaci\u00f3n Starlight<\/strong> y <strong>Consell Insular de Menorca<\/strong> \u2014 certificaci\u00f3n Starlight y cielo nocturno.<\/li>\n<li><strong>AEMET<\/strong> \u2014 previsi\u00f3n meteorol\u00f3gica.<\/li>\n<\/ul>\n<div style=\"border:1px solid #d7a553;background:#fbf6ec;padding:22px 24px;margin:32px 0;border-radius:14px;text-align:center;\">\n<p style=\"margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:1.25em;color:#08243c;font-weight:700;\">\u00bfVas a pasar varios d\u00edas en Menorca?<\/p>\n<p style=\"margin:0 0 18px;color:#4d5f6d;\">Descubre Ciutadella y la historia de la isla acompa\u00f1ado por un gu\u00eda oficial local.<\/p>\n<p style=\"margin:0;\">\n<a href=\"https:\/\/voyagermenorca.com\/excursiones\/\" style=\"display:inline-block;background:#08243c;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Ver visitas guiadas<\/a><br \/>\n<a href=\"https:\/\/api.whatsapp.com\/send?phone=34649902301\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#1f7a4d;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Contactar por WhatsApp<\/a>\n<\/p>\n<\/div>\n<p style=\"font-size:0.9em;color:#666;\">Gu\u00eda elaborada por <strong>Daniel Vaquera Sintes<\/strong>, gu\u00eda oficial de turismo de Menorca (GT-0138-ME). <strong>\u00daltima actualizaci\u00f3n: 7 de agosto de 2026<\/strong>, con las nueve zonas de observaci\u00f3n oficial (ZOO) de Menorca, los horarios municipales del IGN y el dispositivo de movilidad y accesos publicado por el Govern, el Consell Insular y los ayuntamientos. Las medidas pueden variar en los d\u00edas previos seg\u00fan la afluencia: consulta siempre la informaci\u00f3n oficial antes de desplazarte.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>El 12 de agosto de 2026 Menorca vivir\u00e1 su primer eclipse solar total en m\u00e1s de un siglo. Horarios exactos, las 9 zonas de observaci\u00f3n oficial (ZOO), el mapa de la costa oeste y c\u00f3mo verlo con seguridad.<\/p>\n","protected":false},"author":2,"featured_media":2298,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[11,24,266,318],"tags":[321,320,319],"class_list":["post-2279","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-aterdeceres-en-menorca","category-conoce-menorca","category-destino-starlight","category-eclipse","tag-eclipse-2026","tag-eclipse-menorca","tag-starlight"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v28.3 (Yoast SEO v28.8) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Eclipse solar total Menorca 2026: hora, mapa y d\u00f3nde verlo<\/title>\n<meta name=\"description\" content=\"Horarios exactos, mapa interactivo y mejores lugares para ver el eclipse solar total en Menorca el 12 de agosto de 2026, con consejos de seguridad.\" \/>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/voyagermenorca.com\/eclipse-solar-total-en-menorca-2026-guia-completa-mapas-y-consejos-para-turistas\/\" \/>\n<meta property=\"og:locale\" content=\"es_ES\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Eclipse solar total Menorca 2026: hora, mapa y d\u00f3nde verlo\" \/>\n<meta property=\"og:description\" content=\"Horarios exactos, mapa interactivo y mejores lugares para ver el eclipse solar total en Menorca el 12 de agosto de 2026, con consejos de seguridad.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/voyagermenorca.com\/eclipse-solar-total-en-menorca-2026-guia-completa-mapas-y-consejos-para-turistas\/\" \/>\n<meta property=\"og:site_name\" content=\"Visitas guiadas en Menorca\" \/>\n<meta property=\"article:published_time\" content=\"2026-07-07T09:44:13+00:00\" \/>\n<meta property=\"article:modified_time\" content=\"2026-08-07T19:42:50+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/eclipse-total-corona-visible-nasa-scaled.jpg?fit=2560%2C1664&ssl=1\" \/>\n\t<meta property=\"og:image:width\" content=\"2560\" \/>\n\t<meta property=\"og:image:height\" content=\"1664\" \/>\n\t<meta property=\"og:image:type\" content=\"image\/jpeg\" \/>\n<meta name=\"author\" content=\"Daniel Vaquera\" \/>\n<meta name=\"twitter:card\" content=\"summary_large_image\" \/>\n<meta name=\"twitter:title\" content=\"Eclipse solar total en Menorca 2026: horarios, mapa y mejores lugares\" \/>\n<meta name=\"twitter:creator\" content=\"@voyagermenorca\" \/>\n<meta name=\"twitter:label1\" content=\"Escrito por\" \/>\n\t<meta name=\"twitter:data1\" content=\"Daniel Vaquera\" \/>\n\t<meta name=\"twitter:label2\" cont