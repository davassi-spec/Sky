00f3rico emblem\u00e1tico de Menorca.'}\n];\nvar map=L.map(mapElement,{scrollWheelZoom:false,tap:true});\nL.tileLayer(TILES,{maxZoom:19,attribution:TILES_ATTR}).addTo(map);\nvar allMarkers=[];var centerMarkers=[];var byN={};\nfunction iconFor(place){return L.divIcon({className:'',html:'<span class=\"vm-numbered-marker '+(place.type==='nearby'?'vm-nearby':'')+'\">'+place.n+'<\/span>',iconSize:[30,30],iconAnchor:[15,15],popupAnchor:[0,-16]});}\nplaces.forEach(function(place){\nbyN[place.n]=place;\nvar box=makeEl('div','vm-popup');\nbox.appendChild(makeEl('h3','',place.n+'. '+place.name));\nbox.appendChild(makeEl('p','',place.text));\nvar link=makeEl('a','','Abrir en Google Maps');\nlink.href=GMAPS+encodeURIComponent(place.lat+','+place.lng);\nlink.target='_blank';\nlink.rel='noopener noreferrer';\nbox.appendChild(link);\nvar marker=L.marker([place.lat,place.lng],{icon:iconFor(place),title:place.name,alt:place.name}).addTo(map).bindPopup(box);\nallMarkers.push(marker);\nif(place.type==='center'){centerMarkers.push(marker);}\n});\nvar walkOrder=[1,7,2,3,4,6,5,8];\nvar urbanRoute=walkOrder.map(function(n){return [byN[n].lat,byN[n].lng];});\nL.polyline(urbanRoute,{weight:4,opacity:0.65,dashArray:'8 8',color:'#0e7490'}).addTo(map);\nfunction fitMarkers(markers,maxZoom){var group=L.featureGroup(markers);map.fitBounds(group.getBounds().pad(0.18),{maxZoom:maxZoom});}\nvar btnCenter=document.getElementById('vm-show-center');\nvar btnAll=document.getElementById('vm-show-all');\nif(btnCenter){btnCenter.addEventListener('click',function(){fitMarkers(centerMarkers,16);});}\nif(btnAll){btnAll.addEventListener('click',function(){fitMarkers(allMarkers,13);});}\nfitMarkers(centerMarkers,16);\nsetTimeout(function(){map.invalidateSize();},300);\nsetTimeout(function(){map.invalidateSize();},1000);\n}\nfunction loadAssets(cb){\nif(window.L){cb();return;}\nif(!document.getElementById('vm-lf-css')){\nvar cssEl=document.createElement('link');cssEl.id='vm-lf-css';cssEl.rel='stylesheet';cssEl.href=CSS;document.head.appendChild(cssEl);\n}\nvar existing=document.getElementById('vm-lf-js');\nif(existing){\nif(window.L){cb();return;}\nexisting.addEventListener('load',cb);\nexisting.addEventListener('error',function(){retryInit(cb);});\nreturn;\n}\nvar jsEl=document.createElement('script');jsEl.id='vm-lf-js';jsEl.src=JS;jsEl.async=true;\njsEl.onload=cb;\njsEl.onerror=function(){retryInit(cb);};\ndocument.head.appendChild(jsEl);\n}\nvar attempts=0;\nfunction retryInit(cb){\nattempts++;\nif(window.L){cb();return;}\nif(attempts>40){showLoadError();return;}\nsetTimeout(function(){if(window.L){cb();}else{retryInit(cb);}},250);\n}\nfunction boot(){loadAssets(function(){initMap();});}\nsetTimeout(function(){if(!window.L){showLoadError();}},15000);\nif(document.readyState==='complete'||document.readyState==='interactive'){\nsetTimeout(boot,0);\n}else{\ndocument.addEventListener('DOMContentLoaded',boot);\nwindow.addEventListener('load',boot);\n}\n})();\n<\/script><\/p>\n<h2 id=\"historia\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/landmark.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Tres nombres, una ciudad: breve historia de Ciutadella<\/h2>\n<p>Pocas ciudades cuentan su historia tan bien como Ciutadella. Ha tenido <strong>tres nombres<\/strong>, uno por cada gran etapa de su pasado, y cada uno dej\u00f3 una capa que todav\u00eda se puede leer paseando por sus calles.<\/p>\n<h3>De los or\u00edgenes a Iamo (la ciudad romana)<\/h3>\n<p>Menorca empez\u00f3 a poblarse hace unos <strong>4.200 a\u00f1os<\/strong>, y el poniente de la isla ya era entonces un lugar habitado, como demuestran los poblados talay\u00f3ticos que rodean la ciudad. Tras la conquista romana de Menorca en el <strong>123 a.C.<\/strong>, el asentamiento pas\u00f3 a formar parte del mundo romano y fue conocido como <strong>Iamo<\/strong>, un n\u00facleo de vocaci\u00f3n portuaria y comercial.<\/p>\n<h3>Madina Minurqa (la ciudad isl\u00e1mica)<\/h3>\n<p>A partir de <strong>902-903<\/strong>, Menorca fue incorporada a al-\u00c1ndalus, entonces bajo el <strong>Emirato omeya de C\u00f3rdoba<\/strong>. En \u00e9poca isl\u00e1mica, Ciutadella fue conocida como <strong>Madina Minurqa<\/strong> y se convirti\u00f3 en el principal centro urbano y pol\u00edtico de la isla. Apenas quedan vestigios materiales, pero s\u00ed una herencia enorme: decenas de <strong>top\u00f3nimos<\/strong> que empiezan por &#8220;Bini-&#8221; (de <em>beni<\/em>, &#8220;hijos de&#8221;) y el trazado laber\u00edntico de algunas calles del casco antiguo.<\/p>\n<h3>Ciutadella de Menorca (la ciudad cristiana)<\/h3>\n<p>En <strong>1287<\/strong>, el rey <strong>Alfonso III de Arag\u00f3n<\/strong> conquist\u00f3 la isla. Sobre el solar de la mezquita mayor se levant\u00f3 la catedral, y Ciutadella se consolid\u00f3 durante siglos como <strong>capital religiosa, administrativa y nobiliaria<\/strong> de Menorca. De ah\u00ed sus palacios, sus conventos y ese aire se\u00f1orial que a\u00fan se respira.<\/p>\n<h3>&#8220;S&#8217;any de sa desgr\u00e0cia&#8221;: el saqueo turco de 1558<\/h3>\n<p>En <strong>1558<\/strong>, una flota otomana con m\u00e1s de un centenar de naves asedi\u00f3 la ciudad. Tras <strong>unos nueve d\u00edas de asedio y resistencia<\/strong>, Ciutadella fue arrasada y alrededor de <strong>3.500 habitantes de Menorca<\/strong> fueron capturados y vendidos como esclavos en el Imperio otomano. El <strong>obelisco de la Pla\u00e7a des Born<\/strong> conmemora aquel episodio, que los ciutadellencs siguen recordando como <em>&#8220;s&#8217;any de sa desgr\u00e0cia&#8221;<\/em>.<\/p>\n<h3>Perder la capitalidad: el siglo brit\u00e1nico<\/h3>\n<p>Durante el <strong>dominio brit\u00e1nico del siglo XVIII<\/strong>, el gobierno y buena parte de las instituciones administrativas se concentraron en Ma\u00f3, cuyo puerto ten\u00eda un enorme valor estrat\u00e9gico. Desde entonces, <strong>Ma\u00f3 es la capital administrativa<\/strong> y <strong>Ciutadella conserva la sede episcopal<\/strong>\u2026 y, seg\u00fan sus vecinos, el t\u00edtulo de ciudad m\u00e1s bella de la isla. Si quieres comparar las dos ciudades, aqu\u00ed tienes nuestra <a href=\"https:\/\/voyagermenorca.com\/en\/visita-guiada-mahon-menorca\/\">gu\u00eda completa de Ma\u00f3<\/a>.<\/p>\n<h2 id=\"plazas\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/compass.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Las plazas y calles que no te puedes perder<\/h2>\n<h3>Pla\u00e7a des Born<\/h3>\n<p>El coraz\u00f3n monumental de Ciutadella y, para muchos, una de las plazas m\u00e1s bonitas de Espa\u00f1a. Antigua plaza de armas, aqu\u00ed se concentran el <strong>Ayuntamiento<\/strong> (sobre el antiguo alc\u00e1zar), el <strong>Teatre des Born<\/strong> y varios palacios aristocr\u00e1ticos. En el centro, el <strong>obelisco<\/strong> recuerda el asalto turco de 1558. Al caer la tarde, la luz dorada sobre las fachadas es un espect\u00e1culo en s\u00ed misma.<\/p>\n<h3>Ses Voltes<\/h3>\n<p>El tramo porticado del <strong>Carrer de Josep Maria Quadrado<\/strong>, conocido por todo el mundo como <strong>Ses Voltes<\/strong>, es la arteria comercial del casco antiguo. Sus arcadas encaladas proteg\u00edan del sol y de la lluvia; hoy cobijan tiendas tradicionales, zapater\u00edas donde encontrar las aut\u00e9nticas <em>avarques<\/em>, pasteler\u00edas y peque\u00f1as boutiques. Es tambi\u00e9n uno de los puntos por donde pasan los caballos durante Sant Joan.<\/p>\n<h3>Pla\u00e7a de la Llibertat (Pla\u00e7a des Peix)<\/h3>\n<p>Uno de los rincones con m\u00e1s autenticidad de la ciudad. Alrededor del <strong>mercado de pescado<\/strong> y del mercado municipal, las terrazas se llenan a la hora del <strong>vermut<\/strong>, y por las ma\u00f1anas puedes encontrar pescado local y producto fresco de Menorca, queso Ma\u00f3-Menorca y pan de pay\u00e9s. Si quieres ver la Ciutadella de los ciutadellencs, es aqu\u00ed.<\/p>\n<h3>La Contramurada y las calles del silencio<\/h3>\n<p>La <strong>Contramurada<\/strong> sigue el trazado de la antigua muralla y abraza todo el casco antiguo. Pero la verdadera magia est\u00e1 en desviarse: perderse por calles estrechas como <strong>Sant Crist\u00f2fol, Santa Clara o el Carrer del Silenci<\/strong>, donde el ruido baja y solo te acompa\u00f1an tus pasos, balcones de hierro forjado y fachadas se\u00f1oriales de piedra clara.<\/p>\n<h2 id=\"monumentos\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/church.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>La ciudad monumental: catedral, palacios e iglesias<\/h2>\n<h3>Catedral de Menorca (Santa Maria)<\/h3>\n<p>Construida tras la conquista de <strong>1287<\/strong> sobre el solar de la <strong>antigua mezquita mayor<\/strong>, siguiendo las l\u00edneas del <strong>g\u00f3tico catal\u00e1n<\/strong> del siglo XIV. Es <strong>uno de los edificios hist\u00f3ricos m\u00e1s antiguos y emblem\u00e1ticos que contin\u00faan en uso<\/strong> en Ciutadella \u2014m\u00e1s de 700 a\u00f1os de historia, marcados tambi\u00e9n por saqueos, restauraciones y reconstrucciones\u2014 y obtuvo el rango de catedral en <strong>1795<\/strong>. Su exterior sobrio, casi de fortaleza, contrasta con una nave \u00fanica, alta y luminosa que impresiona al entrar. F\u00edjate tambi\u00e9n en la <strong>Porta de la Llum<\/strong> y en los elementos incorporados al templo a lo largo de los siglos.<\/p>\n<h3>Palacios se\u00f1oriales<\/h3>\n<ul>\n<li><strong>Palau Torre-Saura (Cas Comte).<\/strong> En el Born. F\u00edjate en la <strong>cara femenina con los ojos cubiertos por un velo<\/strong> que corona la puerta. El rostro velado ha dado lugar a diversas interpretaciones: una tradici\u00f3n popular dice que simboliza que la casa recibe a todos sin juzgar qui\u00e9n entra, aunque su significado original no se conoce con certeza.<\/li>\n<li><strong>Palau Salort (Can Salort).<\/strong> Tambi\u00e9n en el Born, con su elegante mirador de arcadas. <strong>Abre al p\u00fablico en determinadas \u00e9pocas del a\u00f1o<\/strong> y permite conocer el interior de una residencia aristocr\u00e1tica menorquina, con salones llenos de retratos familiares y mobiliario de \u00e9poca.<\/li>\n<li><strong>Palau Olivar.<\/strong> Frente a la catedral, otra casa noble que abre sus puertas por temporadas y permite asomarse al siglo XVIII menorqu\u00edn.<\/li>\n<li><strong>Claustre del Seminari.<\/strong> Un claustro sereno y ajardinado que hoy alberga el <strong>Museu Dioces\u00e0 de Menorca<\/strong>, con piezas talay\u00f3ticas y arte sacro. Uno de los rincones m\u00e1s tranquilos de la ciudad.<\/li>\n<\/ul>\n<div style=\"border-left:4px solid #0e7490;background:#f0f9fb;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>\ud83d\udca1 Consejo del gu\u00eda.<\/strong> Delante del Palau Torre-Saura casi todo el mundo mira la fachada y sigue andando. Yo siempre pido a mis grupos que se paren bajo la puerta y levanten la vista hacia la cara velada. Cuando cuento una de las interpretaciones populares de la cara velada \u2014que en esa casa se recib\u00eda a todos sin mirar qui\u00e9n era\u2014 la plaza cambia para ellos. Ciutadella est\u00e1 llena de detalles as\u00ed: la ciudad no se ve, se lee.<\/p>\n<\/div>\n<h2 id=\"puerto\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/anchor.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>El puerto antiguo y los miradores<\/h2>\n<p>El puerto de Ciutadella ocupa una <strong>estrecha y profunda entrada natural del mar<\/strong> que penetra hasta el casco urbano. Por la ma\u00f1ana es un puerto vivo, con pescadores y lla\u00fcts tradicionales; por la noche, los restaurantes iluminan el muelle y se crea una de las atm\u00f3sferas m\u00e1s agradables de la isla. Es conocido tambi\u00e9n por el fen\u00f3meno de la <strong>rissaga<\/strong>, una oscilaci\u00f3n brusca del nivel del mar asociada a determinadas condiciones atmosf\u00e9ricas, que puede provocar r\u00e1pidas subidas y bajadas del agua en el puerto.<\/p>\n<p>Para las mejores vistas: el <strong>Mirador del Port<\/strong> (detr\u00e1s del Ayuntamiento), el <strong>Basti\u00f3 de sa Font<\/strong> (hoy Museu Municipal) y, sobre todo, el <strong>Castell de Sant Nicolau<\/strong>, la torre defensiva del siglo XVII que vigila la bocana. Por su orientaci\u00f3n occidental, Ciutadella y su costa ofrecen <strong>algunos de los mejores lugares de Menorca para contemplar la puesta de sol<\/strong>, con la silueta de Mallorca en el horizonte los d\u00edas claros. Otro cl\u00e1sico del atardecer, ya en la costa a pocos minutos del centro, es el arco natural del <strong>Pont d&#8217;en Gil<\/strong>. Si te gustan estos momentos, tenemos una gu\u00eda con <a href=\"https:\/\/voyagermenorca.com\/en\/sunset-menorca-9-viewpoints\/\">los mejores miradores para el atardecer en Menorca<\/a> \u2014 y no pierdas de vista que esta costa oeste ser\u00e1 protagonista durante <a href=\"https:\/\/voyagermenorca.com\/en\/total-solar-eclipse-in-menorca-2026-complete-guide-maps-and-tips-for-tourists\/\">el eclipse solar total del 12 de agosto de 2026<\/a>.<\/p>\n<h2 id=\"alrededores\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/palmtree.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Los alrededores: calas, talay\u00f3tico y Lithica<\/h2>\n<ul>\n<li><strong>Cala en Turqueta, Macarella y Macarelleta:<\/strong> el para\u00edso turquesa del sur, a unos 25\u201340 minutos por carretera, aunque en verano los accesos y traslados pueden alargar el recorrido. Macarella tiene servicios; Macarelleta es m\u00e1s peque\u00f1a y escondida, con tradici\u00f3n naturista. En verano, mejor en bus lanzadera o llegando temprano. Tienes m\u00e1s opciones en nuestra gu\u00eda de <a href=\"https:\/\/voyagermenorca.com\/en\/las-mejores-playas-de-menorca-y-cuales-evitar-en-temporada-alta\/\">las mejores playas de Menorca<\/a>.<\/li>\n<li><strong>Son Saura y Cala des Talaier:<\/strong> arenales amplios y pinares, algo menos masificados. Ambas calas est\u00e1n unidas por el sendero costero <strong>GR-223<\/strong>, que rodea toda la isla: si te gusta caminar, \u00e9chale un vistazo a nuestra <a href=\"https:\/\/voyagermenorca.com\/en\/tourist-guide-cami-de-cavalls\/\">gu\u00eda del Cam\u00ed de Cavalls<\/a>.<\/li>\n<li><strong>Playas de Algaiarens (La Vall):<\/strong> en la costa norte, paisaje m\u00e1s agreste y dos playas abiertas para quien huye de las multitudes.<\/li>\n<li><strong>Naveta des Tudons:<\/strong> a 5 km por la carretera de Ma\u00f3, uno de los monumentos funerarios prehist\u00f3ricos m\u00e1s emblem\u00e1ticos y mejor conservados de Menorca, y una de las joyas de la <a href=\"https:\/\/voyagermenorca.com\/en\/menorca-talayotica-guia\/\">Menorca Talay\u00f3tica<\/a>. Fue utilizada aproximadamente entre 1400 y 900 a.C.<\/li>\n<li><strong>Lithica (Pedreres de s&#8217;Hostal):<\/strong> antigua cantera de mar\u00e8s reconvertida en jardines, laberintos y espacio cultural. Al atardecer es pura poes\u00eda.<\/li>\n<\/ul>\n<h2 id=\"comer\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/utensils.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>D\u00f3nde comer y qu\u00e9 pedir en Ciutadella<\/h2>\n<p>La cocina de Ciutadella mezcla mar y campo, y se disfruta tanto en un restaurante del puerto como en una barra de mercado.<\/p>\n<ul>\n<li><strong>Pla\u00e7a des Peix y mercado:<\/strong> el territorio del <strong>vermut<\/strong> y el tapeo marinero por excelencia. <a href=\"https:\/\/www.google.com\/maps\/search\/?api=1&#038;query=Pla%C3%A7a+de+la+Llibertat+Ciutadella+Menorca\" target=\"_blank\" rel=\"noopener\">Ver en Google Maps<\/a><\/li>\n<li><strong>Restaurantes del puerto antiguo:<\/strong> pescado fresco, marisco y arroces a pie de agua, con las velas de los barcos de fondo. <a href=\"https:\/\/www.google.com\/maps\/search\/?api=1&#038;query=restaurantes+puerto+de+Ciutadella+Menorca\" target=\"_blank\" rel=\"noopener\">Ver en Google Maps<\/a><\/li>\n<li><strong>Casco antiguo:<\/strong> cocina de autor y bistr\u00f3s en patios y casas se\u00f1oriales, para una cena con m\u00e1s calma.<\/li>\n<\/ul>\n<h3>Qu\u00e9 pedir: sabores de Ciutadella<\/h3>\n<ul>\n<li><strong>Caldereta de llagosta:<\/strong> el gran plato de la isla, sobre todo en los restaurantes del puerto.<\/li>\n<li><strong>Arr\u00f2s cald\u00f3s de peix:<\/strong> la alternativa marinera que nunca falla.<\/li>\n<li><strong>Formatge Ma\u00f3-Menorca D.O.P.:<\/strong> tierno, semicurado y curado; p\u00eddelo con aceite y pimienta.<\/li>\n<li><strong>Sobrassada, carn i xulla y formatjades:<\/strong> la despensa payesa.<\/li>\n<li><strong>Pomada:<\/strong> mezcla de gin de Menorca y limonada, especialmente popular durante las fiestas.<\/li>\n<li><strong>Pastissets, crespells y ensa\u00efmada:<\/strong> para el dulce final.<\/li>\n<\/ul>\n<h2 id=\"compras\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/shopping-bag.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Comprar artesan\u00eda y producto local<\/h2>\n<ul>\n<li><strong>Avarques menorquinas.<\/strong> La sandalia tradicional menorquina de piel, popularizada con su caracter\u00edstica suela de caucho. Busca el sello de artesan\u00eda garantizada y desconf\u00eda de los precios demasiado bajos: la avarca artesana tiene un coste m\u00ednimo razonable.<\/li>\n<li><strong>Bisuter\u00eda y malla de plata.<\/strong> Ciutadella fue potencia bisutera y todav\u00eda quedan talleres con piezas de gran calidad.<\/li>\n<li><strong>Queso, sobrasada y gin.<\/strong> Directamente del mercado o de las tiendas de producto local de Ses Voltes.<\/li>\n<li><strong>La tradici\u00f3n menorquina de la silla plegable.<\/strong> En Ciutadella existe una larga tradici\u00f3n vinculada a la fabricaci\u00f3n de sillas plegables de tijera. La versi\u00f3n atribuida a Miguel \u00c1ngel Anglada se populariz\u00f3 en el siglo XX y se asocia localmente con la conocida silla de director.<\/li>\n<\/ul>\n<h2 id=\"curiosidades\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/lightbulb.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Curiosidades que casi nadie te cuenta<\/h2>\n<ul>\n<li><strong>La catedral est\u00e1 sobre una mezquita.<\/strong> El templo cristiano se levant\u00f3 sobre el solar de la mezquita mayor de Madina Minurqa, y el campanario aprovecha la base del antiguo alminar.<\/li>\n<li><strong>La cara con los ojos velados de Cas Comte.<\/strong> Corona la puerta del Palau Torre-Saura y ha dado lugar a varias interpretaciones populares; la m\u00e1s repetida dice que la casa recib\u00eda a todos sin mirar qui\u00e9n era, aunque su sentido original no se conoce con certeza.<\/li>\n<li><strong>La tradici\u00f3n de la silla plegable menorquina.<\/strong> En Ciutadella hay una larga tradici\u00f3n de sillas plegables de tijera; la versi\u00f3n atribuida a Miguel \u00c1ngel Anglada se populariz\u00f3 en el siglo XX y localmente se relaciona con la conocida silla de director.<\/li>\n<li><strong>Ciutadella perdi\u00f3 la capital por un puerto.<\/strong> El de Ma\u00f3, uno de los mayores puertos naturales del Mediterr\u00e1neo, concentr\u00f3 el gobierno durante el dominio brit\u00e1nico del siglo XVIII.<\/li>\n<li><strong>La melod\u00eda del Jaleo procede de la \u201cJota estudiantina\u201d<\/strong> de la zarzuela <em>El Postill\u00f3n de la Rioja<\/em>, compuesta por Crist\u00f3bal Oudrid en 1856. Seg\u00fan el relato tradicional, cuando empez\u00f3 a interpretarse al paso de los caballos a finales del siglo XIX, el movimiento de los animales y el revuelo de la multitud contribuyeron a dar al acto su forma y su nombre actuales.<\/li>\n<li><strong>La rissaga puede vaciar el puerto.<\/strong> Esta oscilaci\u00f3n del nivel del mar, ligada a cambios bruscos de presi\u00f3n atmosf\u00e9rica, puede provocar r\u00e1pidas subidas y bajadas del agua en cuesti\u00f3n de minutos.<\/li>\n<\/ul>\n<h2 id=\"sant-joan\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/flame.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Las fiestas de Sant Joan: la m\u00e1s espectacular de Menorca<\/h2>\n<p>Si visitas Ciutadella el <strong>23 y 24 de junio<\/strong>, vivir\u00e1s la fiesta m\u00e1s intensa de la isla. La comitiva, encabezada por los jinetes llamados <strong>caixers<\/strong>, mantiene una representaci\u00f3n simb\u00f3lica de los antiguos estamentos de la sociedad ciutadellenca, con cargos vinculados a la nobleza, el clero, los payeses y los oficios urbanos. La <em>qualcada<\/em> recorre la ciudad mientras los caballos de raza menorquina se encabritan entre la multitud al ritmo del <strong>Jaleo<\/strong>.<\/p>\n<ul>\n<li><strong>Dia des Be<\/strong> (domingo anterior): durante el Dia des Be, <em>s&#8217;Homo des Be<\/em> recorre Ciutadella descalzo llevando sobre los hombros un cordero vivo adornado, acompa\u00f1ado por la comitiva que anuncia la proximidad de las fiestas.<\/li>\n<li><strong>Primer toc<\/strong> (23 de junio, 14:00): el <em>fabioler<\/em> pide permiso y su flauta y tambor dan comienzo a la fiesta.<\/li>\n<li><strong>Caragol des Born:<\/strong> los caballos giran en la gran plaza entre miles de personas.<\/li>\n<li><strong>Jocs des Pla<\/strong> (24 de junio): juegos ecuestres de tradici\u00f3n hist\u00f3rica, relacionados con ejercicios caballerescos de origen medieval, junto al puerto.<\/li>\n<\/ul>\n<p><strong>Consejos de gu\u00eda:<\/strong> ve con ropa que se pueda ensuciar, <strong>respeta siempre el espacio de los caballos<\/strong>, no los toques por detr\u00e1s, y reserva alojamiento con <strong>much\u00edsima<\/strong> antelaci\u00f3n. Si viajas con ni\u00f1os, busca los horarios y zonas m\u00e1s tranquilos. Tienes el programa completo en nuestra <a href=\"https:\/\/voyagermenorca.com\/en\/fiestas-sant-joan-2026\/\">gu\u00eda de Sant Joan 2026<\/a>.<\/p>\n<h2 id=\"clima\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/cloud-sun.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Clima y temperatura media: cu\u00e1ndo venir<\/h2>\n<p>Ciutadella comparte el <strong>clima mediterr\u00e1neo<\/strong> de Menorca: inviernos suaves, veranos c\u00e1lidos y la tramontana como protagonista ocasional. Por su orientaci\u00f3n occidental, ofrece algunos de los mejores lugares de la isla para contemplar la puesta de sol.<\/p>\n<table>\n<thead>\n<tr>\n<th>Mes<\/th>\n<th>T\u00aa media<\/th>\n<th>Mar<\/th>\n<th>Ambiente<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Enero<\/td>\n<td>~11 \u00b0C<\/td>\n<td>~14 \u00b0C<\/td>\n<td>Tranquilo; Sant Antoni (17 de enero)<\/td>\n<\/tr>\n<tr>\n<td>Abril<\/td>\n<td>~14\u201315 \u00b0C<\/td>\n<td>~15 \u00b0C<\/td>\n<td>Ideal para pasear el casco antiguo<\/td>\n<\/tr>\n<tr>\n<td>Mayo<\/td>\n<td>~17\u201318 \u00b0C<\/td>\n<td>~17 \u00b0C<\/td>\n<td>Excelente: c\u00e1lido y sin agobios<\/td>\n<\/tr>\n<tr>\n<td>Junio<\/td>\n<td>~21\u201322 \u00b0C<\/td>\n<td>~22 \u00b0C<\/td>\n<td>Verano y ba\u00f1o; \u00a1Sant Joan!<\/td>\n<\/tr>\n<tr>\n<td>Julio<\/td>\n<td>~24\u201325 \u00b0C<\/td>\n<td>~25 \u00b0C<\/td>\n<td>Pleno verano; reservar todo<\/td>\n<\/tr>\n<tr>\n<td>Agosto<\/td>\n<td>~25 \u00b0C<\/td>\n<td>~26 \u00b0C<\/td>\n<td>El mes m\u00e1s c\u00e1lido y concurrido<\/td>\n<\/tr>\n<tr>\n<td>Septiembre<\/td>\n<td>~22\u201323 \u00b0C<\/td>\n<td>~25 \u00b0C<\/td>\n<td>Insuperable: mar caliente, menos gente<\/td>\n<\/tr>\n<tr>\n<td>Diciembre<\/td>\n<td>~12 \u00b0C<\/td>\n<td>~16 \u00b0C<\/td>\n<td>Suave; ambiente navide\u00f1o<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><strong>\u00bfCu\u00e1ndo venir?<\/strong> Para buen tiempo sin masificaci\u00f3n: <strong>junio y septiembre<\/strong>. Para turismo cultural y senderismo: <strong>abril, mayo y octubre<\/strong>. Y si puedes elegir fecha, <strong>Sant Joan (23\u201324 de junio)<\/strong> es el momento m\u00e1s m\u00e1gico\u2026 y el m\u00e1s concurrido.<\/p>\n<h2 id=\"practico\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/info.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Informaci\u00f3n pr\u00e1ctica para visitar Ciutadella<\/h2>\n<h3>C\u00f3mo llegar y moverse<\/h3>\n<p>Ciutadella est\u00e1 en el extremo oeste de Menorca, a unos <strong>45 minutos en coche del aeropuerto de Ma\u00f3<\/strong> por la carretera general Me-1. Cuenta con <strong>puerto de ferris<\/strong> con conexiones a Mallorca y la pen\u00ednsula. El casco antiguo es <strong>peatonal y compacto<\/strong>: todo se hace andando.<\/p>\n<h3>D\u00f3nde aparcar<\/h3>\n<p>Hay varias zonas de estacionamiento alrededor del casco antiguo y del paseo de Sant Nicolau. Algunas plazas pueden ser gratuitas y otras reguladas (zona azul en la Contramurada y alrededores del Born), por lo que conviene comprobar la se\u00f1alizaci\u00f3n vigente. En verano, cuanto antes llegues, mejor.<\/p>\n<h3>La mejor forma de descubrir Ciutadella: con un gu\u00eda local<\/h3>\n<p>Ciutadella tiene tanta historia concentrada en tan poco espacio que es f\u00e1cil quedarse solo en las fachadas. En nuestra <a href=\"https:\/\/voyagermenorca.com\/en\/ciutadella-visita-guiada-ruta-a-pie\/\"><strong>visita guiada de Ciutadella<\/strong><\/a> recorremos la catedral, la Pla\u00e7a des Born, los palacios, Ses Voltes y el puerto conectando los puntos: qui\u00e9n viv\u00eda en cada palacio, c\u00f3mo se vivi\u00f3 el asalto turco y por qu\u00e9 Sant Joan es como es. Dura unas <strong>dos horas<\/strong>, adaptamos el ritmo al grupo y buscamos la sombra en verano.<\/p>\n<p><a href=\"https:\/\/wa.me\/34649902301?text=Hola%2C%20me%20gustar%C3%ADa%20reservar%20una%20visita%20guiada%20por%20Ciutadella.\" target=\"_blank\" rel=\"noopener\"><strong>Reserva tu visita guiada por WhatsApp<\/strong><\/a> y te respondemos lo antes posible.<\/p>\n<div style=\"border-left:4px solid #0e7490;background:#f0f9fb;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>\ud83d\udca1 Consejo del gu\u00eda.<\/strong> Si vas por libre, hazlo al rev\u00e9s de casi todo el mundo: casco antiguo por la ma\u00f1ana temprano y puerto por la tarde. Y si prefieres que alguien te cuente la ciudad, ven una ma\u00f1ana con nosotros y dedica la tarde a Sant Nicolau o a una cala: en dos horas de visita te llevas las claves para que el resto del viaje por Menorca se entienda mucho mejor. Tambi\u00e9n puedes ver <a href=\"https:\/\/voyagermenorca.com\/en\/field-trips\/\">todas nuestras excursiones<\/a> por la isla.<\/p>\n<\/div>\n<h2 id=\"faq\"><img loading=\"lazy\" decoding=\"async\" src=\"https:\/\/api.iconify.design\/lucide\/circle-help.svg?color=%230e7490\" alt=\"\" width=\"22\" height=\"22\" style=\"display:inline-block;vertical-align:-3px;margin-right:8px\" \/>Preguntas frecuentes sobre qu\u00e9 ver en Ciutadella<\/h2>\n<h3>\u00bfQu\u00e9 es imprescindible ver en Ciutadella?<\/h3>\n<p>La <strong>Catedral de Menorca<\/strong>, la <strong>Pla\u00e7a des Born<\/strong>, <strong>Ses Voltes<\/strong>, la <strong>Pla\u00e7a des Peix<\/strong> y el <strong>puerto antiguo<\/strong> al atardecer desde el Castell de Sant Nicolau. Con m\u00e1s tiempo, la Naveta des Tudons y Lithica est\u00e1n a pocos minutos.<\/p>\n<h3>\u00bfQu\u00e9 ver en Ciutadella en un d\u00eda?<\/h3>\n<p>En un d\u00eda completo da tiempo a todo lo esencial: casco antiguo por la ma\u00f1ana (Born, Catedral, Ses Voltes y Pla\u00e7a des Peix), comida en el puerto, tarde tranquila entre palacios y bastiones, y puesta de sol en Sant Nicolau. Tienes el <a href=\"#itinerario\">itinerario detallado hora a hora<\/a> al principio de esta gu\u00eda.<\/p>\n<h3>\u00bfCu\u00e1nto tiempo se necesita para visitar Ciutadella?<\/h3>\n<p>El casco antiguo se ve bien en <strong>medio d\u00eda<\/strong>; un <strong>d\u00eda completo<\/strong> permite a\u00f1adir el puerto y el atardecer sin prisas; y con <strong>d\u00eda y medio<\/strong> entran la Naveta des Tudons, Lithica o una cala del sur.<\/p>\n<h3>\u00bfCu\u00e1l es la mejor hora para visitar Ciutadella?<\/h3>\n<p><strong>Primera hora de la ma\u00f1ana<\/strong> (antes de las 10:00) para el casco antiguo, con las calles tranquilas y la luz suave, y la <strong>\u00faltima hora de la tarde<\/strong> para el puerto y la puesta de sol en Sant Nicolau. En verano, evita el casco antiguo entre las 13:00 y las 17:00, cuando aprieta el calor.<\/p>\n<h3>\u00bfQu\u00e9 hacer en Ciutadella con ni\u00f1os?<\/h3>\n<p>El paseo por el <strong>puerto<\/strong> viendo los lla\u00fcts, la explanada del <strong>Castell de Sant Nicolau<\/strong>, un helado bajo las arcadas de <strong>Ses Voltes<\/strong> y, a las afueras, los laberintos de <strong>Lithica<\/strong>, que a los ni\u00f1os les encantan. Las calas cercanas de arena fina completan el plan. El casco antiguo, al ser peatonal, es muy c\u00f3modo con carrito.<\/p>\n<h3>\u00bfSe puede visitar Ciutadella sin coche?<\/h3>\n<p>S\u00ed. Hay <strong>l\u00ednea regular de autob\u00fas entre Ma\u00f3 y Ciutadella<\/strong> durante todo el a\u00f1o, y en verano salen buses desde la estaci\u00f3n de autobuses hacia las calas del sur. El casco antiguo es peatonal y todo lo esencial se hace a pie; solo para la Naveta des Tudons o las playas m\u00e1s apartadas agradecer\u00e1s transporte.<\/p>\n<h3>\u00bfQu\u00e9 hacer en Ciutadella si llueve?<\/h3>\n<p>Es de las pocas ciudades donde la lluvia no arruina el plan: la <strong>Catedral<\/strong>, el <strong>Museu Dioces\u00e0<\/strong> en el Claustre del Seminari, el <strong>Palau Salort<\/strong>, el <strong>Museu Municipal (Basti\u00f3 de sa Font)<\/strong> y el <strong>mercado<\/strong> se visitan a cubierto, y las arcadas de Ses Voltes se construyeron precisamente para pasear protegido. Remata con una pasteler\u00eda tradicional.<\/p>\n<h3>\u00bfQu\u00e9 se puede ver gratis en Ciutadella?<\/h3>\n<p>Casi todo lo esencial: la <strong>Pla\u00e7a des Born<\/strong>, <strong>Ses Voltes<\/strong>, la <strong>Pla\u00e7a des Peix<\/strong>, el <strong>puerto antiguo<\/strong>, la Contramurada, las calles del casco hist\u00f3rico y el exterior del <strong>Castell de Sant Nicolau<\/strong> con su puesta de sol. Solo la catedral, los palacios visitables y los museos tienen entrada de pago.<\/p>\n<h3>\u00bfD\u00f3nde ver el atardecer en Ciutadella?<\/h3>\n<p>Los dos cl\u00e1sicos son el <strong>Castell de Sant Nicolau<\/strong>, junto a la bocana del puerto, y el arco natural del <strong>Pont d&#8217;en Gil<\/strong>. Por su orientaci\u00f3n occidental, Ciutadella ofrece algunos de los mejores lugares de Menorca para la puesta de sol; los d\u00edas claros se ve la silueta de Mallorca.<\/p>\n<h3>\u00bfCu\u00e1nto dura una visita guiada?<\/h3>\n<p>Nuestras visitas guiadas est\u00e1ndar por el casco antiguo duran <strong>aproximadamente dos horas<\/strong>: tiempo suficiente para ver lo esencial con calma, hacer fotos y entender la historia de la ciudad.<\/p>\n<h3>\u00bfEn qu\u00e9 idiomas se ofrece la visita?<\/h3>\n<p>Ofrecemos tours regulares en <strong>catal\u00e1n, espa\u00f1ol, ingl\u00e9s y franc\u00e9s<\/strong>. Bajo petici\u00f3n, tambi\u00e9n en <strong>holand\u00e9s, italiano, alem\u00e1n y portugu\u00e9s<\/strong>, seg\u00fan disponibilidad.<\/p>\n<h3>\u00bfD\u00f3nde est\u00e1 el punto de encuentro?<\/h3>\n<p>El punto habitual es la <strong>Pla\u00e7a d&#8217;Alfons III<\/strong>, conocida como &#8220;Sa Contramurada&#8221;. Si te va mejor otro lugar, lo acordamos sin problema.<\/p>\n<h3>\u00bfSe puede ver Ciutadella a pie?<\/h3>\n<p>S\u00ed: el casco hist\u00f3rico es <strong>peatonal y compacto<\/strong>. Deja el coche en los aparcamientos del centro o del puerto y disfruta caminando.<\/p>\n<h3>\u00bfD\u00f3nde aparcar en Ciutadella?<\/h3>\n<p>Hay varias zonas de estacionamiento alrededor del casco antiguo y del paseo de Sant Nicolau: algunas plazas pueden ser gratuitas y otras reguladas (zona azul), as\u00ed que conviene comprobar la se\u00f1alizaci\u00f3n vigente. En verano, llega a primera hora.<\/p>\n<h3>\u00bfQu\u00e9 es mejor visitar, Ciutadella o Ma\u00f3?<\/h3>\n<p>Merece la pena ver las dos: Ciutadella es la antigua capital se\u00f1orial, de catedral, palacios y atardeceres; Ma\u00f3 gira en torno a su gran puerto natural y la herencia brit\u00e1nica. Si dudas, empieza por esta gu\u00eda y sigue con nuestra <a href=\"https:\/\/voyagermenorca.com\/en\/visita-guiada-mahon-menorca\/\">gu\u00eda de Ma\u00f3<\/a>.<\/p>\n<div style=\"display:flex;gap:20px;align-items:flex-start;border:1px solid #e0e0e0;border-radius:12px;padding:20px;margin:32px 0;background:#fafafa;flex-wrap:wrap;\">\n<div>\n<p style=\"margin:0 0 6px;\"><strong>Sobre el autor \u2014 Daniel Vaquera<\/strong><\/p>\n<p style=\"margin:0;font-size:0.95em;\">Gu\u00eda oficial de turismo de las Illes Balears (n\u00ba GT-0138-ME) y fundador de <a href=\"https:\/\/voyagermenorca.com\/en\/quienes-somos\/\">Voyager Menorca<\/a>. Nacido y residente en Ciutadella, lleva a\u00f1os ense\u00f1ando la isla en catal\u00e1n, espa\u00f1ol, ingl\u00e9s, franc\u00e9s e italiano, y es secretario de la asociaci\u00f3n de gu\u00edas de Menorca (APITMe). Cada dato de esta gu\u00eda sale de recorrer estas calles casi a diario.<\/p>\n<\/div>\n<\/div>\n<h2>M\u00e1s gu\u00edas de Menorca<\/h2>\n<ul>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/visita-guiada-mahon-menorca\/\">Descubre Ma\u00f3: la gu\u00eda definitiva de la capital \u2192<\/a><\/li>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/las-mejores-playas-de-menorca-y-cuales-evitar-en-temporada-alta\/\">Las mejores playas de Menorca \u2192<\/a><\/li>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/menorca-talayotica-guia\/\">Menorca Talay\u00f3tica: gu\u00eda del patrimonio prehist\u00f3rico \u2192<\/a><\/li>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/tourist-guide-cami-de-cavalls\/\">Gu\u00eda del Cam\u00ed de Cavalls (GR-223) \u2192<\/a><\/li>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/guia-faros-menorca\/\">Los 7 faros de Menorca \u2192<\/a><\/li>\n<li><a href=\"https:\/\/voyagermenorca.com\/en\/sunset-menorca-9-viewpoints\/\">Atardeceres en Menorca: 9 miradores \u2192<\/a><\/li>\n<\/ul>\n<p><script type=\"application\/ld+json\">\n{\n  \"@context\": \"https:\/\/schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"BlogPosting\",\n      \"mainEntityOfPage\": {\n        \"@type\": \"WebPage\",\n        \"@id\": \"https:\/\/voyagermenorca.com\/que-ver-en-ciutadella-menorca\/\"\n      },\n      \"headline\": \"Qu\u00e9 ver en Ciutadella de Menorca: la gu\u00eda de un gu\u00eda local (2026)\",\n      \"description\": \"Catedral, Pla\u00e7a des Born, Ses Voltes y puerto: qu\u00e9 ver en Ciutadella con itinerario de 1 d\u00eda, tiempos de visita y consejos de un gu\u00eda oficial de Menorca.\",\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Daniel Vaquera\",\n        \"jobTitle\": \"Gu\u00eda oficial de turismo de las Illes Balears\",\n        \"identifier\": \"GT-0138-ME\",\n        \"knowsLanguage\": [\"ca\", \"es\", \"en\", \"fr\", \"it\"],\n        \"url\": \"https:\/\/voyagermenorca.com\/quienes-somos\/\",\n        \"sameAs\": [\"https:\/\/www.instagram.com\/voyagermenorca\/\"],\n        \"worksFor\": {\n          \"@type\": \"Organization\",\n          \"name\": \"Voyager Menorca\",\n          \"url\": \"https:\/\/voyagermenorca.com\/\"\n        }\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Voyager Menorca\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https:\/\/voyagermenorca.com\/logo.png\"\n        }\n      },\n      \"datePublished\": \"2026-01-02\",\n      \"dateModified\": \"2026-07-11\"\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 es imprescindible ver en Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"La Catedral de Menorca, la Pla\u00e7a des Born, Ses Voltes, la Pla\u00e7a des Peix y el puerto antiguo al atardecer desde el Castell de Sant Nicolau. Con m\u00e1s tiempo, la Naveta des Tudons y Lithica est\u00e1n a pocos minutos de la ciudad.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 ver en Ciutadella en un d\u00eda?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"En un d\u00eda completo da tiempo a todo lo esencial: casco antiguo por la ma\u00f1ana (Pla\u00e7a des Born, Catedral, Ses Voltes y Pla\u00e7a des Peix), comida en el puerto, tarde tranquila entre palacios y bastiones, y puesta de sol desde el Castell de Sant Nicolau. El centro hist\u00f3rico es peatonal y compacto, y todo se hace a pie.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfCu\u00e1nto tiempo se necesita para visitar Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"El casco antiguo se ve bien en medio d\u00eda; un d\u00eda completo permite a\u00f1adir el puerto y el atardecer sin prisas; y con d\u00eda y medio entran la Naveta des Tudons, Lithica o una cala del sur como Cala en Turqueta.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfCu\u00e1l es la mejor hora para visitar Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Primera hora de la ma\u00f1ana, antes de las 10:00, para el casco antiguo con las calles tranquilas, y la \u00faltima hora de la tarde para el puerto y la puesta de sol en el Castell de Sant Nicolau. En verano conviene evitar el casco antiguo entre las 13:00 y las 17:00 por el calor.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 hacer en Ciutadella con ni\u00f1os?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"El paseo por el puerto viendo los lla\u00fcts, la explanada del Castell de Sant Nicolau, un helado bajo las arcadas de Ses Voltes y los laberintos de Lithica, a las afueras. Las calas cercanas completan el plan, y el casco antiguo peatonal es muy c\u00f3modo con carrito.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfSe puede visitar Ciutadella sin coche?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"S\u00ed. Hay l\u00ednea regular de autob\u00fas entre Ma\u00f3 y Ciutadella durante todo el a\u00f1o, y en verano salen buses desde la estaci\u00f3n de autobuses hacia las calas del sur. El casco antiguo es peatonal y todo lo esencial se hace a pie.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 hacer en Ciutadella si llueve?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"La Catedral, el Museu Dioces\u00e0 en el Claustre del Seminari, el Palau Salort, el Museu Municipal en el Basti\u00f3 de sa Font y el mercado se visitan a cubierto, y las arcadas de Ses Voltes se construyeron precisamente para pasear protegido de la lluvia y el sol.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 se puede ver gratis en Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Casi todo lo esencial es gratuito: la Pla\u00e7a des Born, Ses Voltes, la Pla\u00e7a des Peix, el puerto antiguo, la Contramurada, las calles del casco hist\u00f3rico y el exterior del Castell de Sant Nicolau con su puesta de sol. Solo la catedral, los palacios visitables y los museos tienen entrada de pago.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfD\u00f3nde ver el atardecer en Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Los dos puntos cl\u00e1sicos son el Castell de Sant Nicolau, junto a la bocana del puerto, y el arco natural del Pont d'en Gil, en la costa a pocos minutos de la ciudad. Por su orientaci\u00f3n occidental, Ciutadella ofrece algunos de los mejores lugares de Menorca para la puesta de sol; los d\u00edas claros se distingue la silueta de Mallorca.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfCu\u00e1nto dura una visita guiada por Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Nuestras visitas guiadas est\u00e1ndar por el casco antiguo duran aproximadamente dos horas: tiempo suficiente para ver lo esencial con calma, hacer fotos y entender la historia de la ciudad.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfEn qu\u00e9 idiomas se ofrece la visita guiada?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Ofrecemos tours regulares en catal\u00e1n, espa\u00f1ol, ingl\u00e9s y franc\u00e9s. Bajo petici\u00f3n, tambi\u00e9n en holand\u00e9s, italiano, alem\u00e1n y portugu\u00e9s, seg\u00fan disponibilidad.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfD\u00f3nde est\u00e1 el punto de encuentro de la visita guiada?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"El punto habitual es la Pla\u00e7a d'Alfons III, conocida como Sa Contramurada, en la entrada del casco antiguo de Ciutadella. Si te va mejor otro lugar, lo acordamos sin problema.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfSe puede ver Ciutadella a pie?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"S\u00ed: el casco hist\u00f3rico es peatonal y compacto. Deja el coche en los aparcamientos del centro o del puerto y disfruta caminando.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfD\u00f3nde aparcar en Ciutadella?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Hay varias zonas de estacionamiento alrededor del casco antiguo y del paseo de Sant Nicolau: algunas plazas pueden ser gratuitas y otras reguladas en zona azul, por lo que conviene comprobar la se\u00f1alizaci\u00f3n vigente. En verano conviene llegar a primera hora.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"\u00bfQu\u00e9 es mejor visitar, Ciutadella o Ma\u00f3?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Merece la pena ver las dos: Ciutadella es la antigua capital se\u00f1orial, de catedral, palacios y atardeceres; Ma\u00f3, la capital actual, gira en torno a uno de los mayores puertos naturales del Mediterr\u00e1neo y a su herencia brit\u00e1nica. Si buscas casco antiguo monumental y puestas de sol, Ciutadella; si te interesan el gran puerto y el siglo XVIII, Ma\u00f3.\"\n          }\n        }\n      ]\n    },\n    {\n      \"@type\": \"TouristTrip\",\n      \"name\": \"Visita guiada por el casco antiguo de Ciutadella\",\n      \"description\": \"Tour a pie para descubrir la historia y los secretos de Ciutadella con un gu\u00eda local oficial.\",\n      \"provider\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Voyager Menorca\"\n      },\n      \"itinerary\": [\n        { \"@type\": \"TouristAttraction\", \"name\": \"Pla\u00e7a des Born\" },\n        { \"@type\": \"TouristAttraction\", \"name\": \"Catedral de Santa Maria\" },\n        { \"@type\": \"TouristAttraction\", \"name\": \"Ses Voltes\" },\n        { \"@type\": \"TouristAttraction\", \"name\": \"Pla\u00e7a de la Llibertat\" },\n        { \"@type\": \"TouristAttraction\", \"name\": \"Puerto de Ciutadella\" },\n        { \"@type\": \"TouristAttraction\", \"name\": \"Castell de Sant Nicolau\" }\n      ],\n      \"offers\": {\n        \"@type\": \"Offer\",\n        \"priceCurrency\": \"EUR\",\n        \"url\": \"https:\/\/wa.me\/34649902301\",\n        \"availability\": \"https:\/\/schema.org\/InStock\"\n      }\n    }\n  ]\n}\n<\/script><\/p>\n","protected":false},"excerpt":{"rendered":"<p>The Cathedral, Pla\u00e7a des Born, Ses Voltes, and the port: what to see in Ciutadella with a 1-day itinerary, visiting times, and tips from an official Menorca guide.<\/p>\n","protected":false},"author":2,"featured_media":2266,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[199,263,72,117,116],"tags":[200,78,203,87,60,