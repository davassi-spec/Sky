2*180\/Math.PI,lo2*180\/Math.PI];}var bounds=[];zoos.forEach(function(z){var zi=L.divIcon({className:\"\",html:DV+' class=\"zoo-marker-ecl\">ZOO'+DVC,iconSize:[46,26],iconAnchor:[23,13],popupAnchor:[0,-14]});L.marker([z.lat,z.lng],{icon:zi,title:\"Zona de observaci\u00f3n oficial: \"+z.name}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#1f5f3f;margin-bottom:5px;\">'+z.name+' (ZOO)'+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+z.det+' \u00b7 ubicaci\u00f3n orientativa'+DVC);bounds.push([z.lat,z.lng]);if(z.arrow){var e=dp(z.lat,z.lng,B,K);L.polyline([[z.lat,z.lng],e],{color:\"#f2a533\",weight:4,opacity:0.95,dashArray:\"8 6\"}).addTo(map);var ai=L.divIcon({className:\"\",html:DV+' class=\"sunset-arrow\" style=\"transform:rotate('+(B-90)+'deg)\">\u27a4'+DVC,iconSize:[28,28],iconAnchor:[14,14]});L.marker(e,{icon:ai,interactive:false}).addTo(map);bounds.push(e);}});regs.forEach(function(r){var ri=L.divIcon({className:\"\",html:DV+' class=\"reg-marker-ecl\">!'+DVC,iconSize:[34,34],iconAnchor:[17,17],popupAnchor:[0,-19]});L.marker([r.lat,r.lng],{icon:ri,title:r.name+\" (acceso regulado)\"}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#8a3d09;margin-bottom:5px;\">'+r.name+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+r.det+DVC);bounds.push([r.lat,r.lng]);});map.fitBounds(bounds,{padding:[32,32],maxZoom:12});L.control.scale({imperial:false,position:\"bottomleft\"}).addTo(map);var lg=L.control({position:\"topright\"});lg.onAdd=function(){var d=L.DomUtil.create(\"div\",\"eclipse-map-legend\");d.innerHTML='<strong>Leyenda<\/strong><span class=\"legend-zoo\">ZOO<\/span>Zona de observaci\u00f3n oficial<br \/><span class=\"legend-reg\">!<\/span>Acceso regulado \/ zona de riesgo<br \/><span class=\"legend-arrow\">\u27a4<\/span>Ocaso 288\u00b0 \u00b7 oeste-noroeste';return d;};lg.addTo(map);map.on(\"click\",function(){map.scrollWheelZoom.enable();});map.on(\"mouseout\",function(){map.scrollWheelZoom.disable();});}function ensureLeaflet(cb){if(window.L&&window.L.map){cb();return;}if(!document.querySelector('link[href*=\"'+LF+'\"]')){var l=document.createElement(\"link\");l.rel=\"stylesheet\";l.href=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".css\";document.head.appendChild(l);}var ex=document.querySelector('script[src*=\"'+LF+'\"]');if(ex){if(window.L&&window.L.map){cb();}else{ex.addEventListener(\"load\",cb);}}else{var js=document.createElement(\"script\");js.src=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".js\";js.onload=cb;document.head.appendChild(js);}}if(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",function(){ensureLeaflet(initEclipseMap);});}else{ensureLeaflet(initEclipseMap);}})();<\/script><\/div>\n<h2 id=\"zoo\">Les 9 zones d&#8217;observaci\u00f3 oficial (ZOO) de Menorca<\/h2>\n<div style=\"border-left:4px solid #08243c;background:#eef4f9;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>Actualitzaci\u00f3 d&#8217;agost de 2026.<\/strong> El Govern de les Illes Balears ha habilitat <strong>26 zones d&#8217;observaci\u00f3 oficial (ZOO)<\/strong> al conjunt de Balears, <strong>nou d&#8217;elles a Menorca<\/strong>. Es van triar entre m\u00e9s d&#8217;un centenar d&#8217;empla\u00e7aments possibles valorant visibilitat, accessibilitat, capacitat d&#8217;acollida, aparcament i possibilitat d&#8217;intervenci\u00f3 dels serveis d&#8217;emerg\u00e8ncia. El propi Govern ho diu amb claredat: <strong>no s\u00f3n necess\u00e0riament els llocs des d&#8217;on millor es veur\u00e0 l&#8217;eclipsi<\/strong>, sin\u00f3 aquells on pot garantir millor la seguretat de les persones.  <\/p>\n<\/div>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Zona d&#8217;observaci\u00f3 oficial<\/th>\n<th>Municipi<\/th>\n<th>Detall<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td><strong>Cala en Bosc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Des de l&#8217;aparcament del passeig mar\u00edtim fins al far de Cap d&#8217;Artrutx<\/td>\n<\/tr>\n<tr>\n<td><strong>Cala Blanca<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Del Clot de sa Cera al restaurant Es Mirador<\/td>\n<\/tr>\n<tr>\n<td><strong>Avinguda Los Delfines<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Urbanitzaci\u00f3 de Cala en Blanes \/ Los Delfines, costa nord-oest<\/td>\n<\/tr>\n<tr>\n<td><strong>Son Blanc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Franja litoral al sud del port, al costat de Son Oleo<\/td>\n<\/tr>\n<tr>\n<td><strong>Carrer des Tamarells<\/strong><\/td>\n<td>Es Mercadal<\/td>\n<td>Platges de Fornells, costa nord<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Son Bou<\/strong><\/td>\n<td>Alaior<\/td>\n<td>Acc\u00e9s recomanat per Torre Sol\u00ed, amb bus llan\u00e7adora<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Sant Tom\u00e0s<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>Costa sud<\/td>\n<\/tr>\n<tr>\n<td><strong>Talis<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>Costa sud, al costat de Sant Tom\u00e0s<\/td>\n<\/tr>\n<tr>\n<td><strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong><\/td>\n<td>Ma\u00f3<\/td>\n<td>Possible tancament al tr\u00e0nsit a partir de les 19:00<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<p><strong>Com ho llegeixo jo, com a guia local.<\/strong> Les ZOO resolen la seguretat i l&#8217;aparcament, no la visibilitat. Amb el Sol a uns 2\u00b0 d&#8217;al\u00e7ada i un azimut de 288\u00b0 (oest-nord-oest), les quatre zones de Ciutadella \u2014<strong>Cala en Bosc, Cala Blanca, Son Blanc i Avinguda Los Delfines<\/strong>\u2014 s\u00f3n les que combinen millor el dispositiu oficial amb un horitz\u00f3 mar\u00ed net en la direcci\u00f3 correcta. A les zones de la costa sud (Son Bou, Sant Tom\u00e0s, Talis) i al Passeig Mar\u00edtim de Ma\u00f3, la l\u00ednia del ponent queda m\u00e9s rasant respecte a la pr\u00f2pia costa o al casc urb\u00e0: s\u00f3n perfectament v\u00e0lides i segures, per\u00f2 conv\u00e9 <strong>comprovar el perfil real de l&#8217;horitz\u00f3 amb l&#8217;app Horitz\u00f3 Eclipsi 2026<\/strong> des del punt concret on pensis col\u00b7locar-te.  <\/p>\n<p>I una recomanaci\u00f3 que val m\u00e9s que qualsevol llista: si pots veure-ho des del teu propi allotjament o des d&#8217;una zona a la qual arribis caminant, i tens horitz\u00f3 oest, fes-ho. \u00c9s la forma m\u00e9s segura d&#8217;evitar despla\u00e7aments, col\u00b7lapses i sorpreses d&#8217;\u00faltima hora. <\/p>\n<h2 id=\"donde\">Els millors llocs per veure l&#8217;eclipsi a Menorca<\/h2>\n<p>Com que el Sol estar\u00e0 gaireb\u00e9 tocant l&#8217;horitz\u00f3, la clau no \u00e9s l&#8217;al\u00e7ada sin\u00f3 <strong>un horitz\u00f3 oest completament obert i sense obstacles<\/strong>: sense muntanyes, edificis, arbredes ni n\u00favols baixos. Tots els punts recomanats s\u00f3n a la meitat occidental de l&#8217;illa. Els agrupo per tipus perqu\u00e8 tri\u00efs segons el teu pla, per\u00f2 tingues en compte el <a href=\"#afluencia\">dispositiu oficial d&#8217;accessos<\/a>: diversos d&#8217;ells estan regulats el 12 d&#8217;agost.  <\/p>\n<h3>Millors platges i cales per observar-lo<\/h3>\n<ul>\n<li><strong>Cala en Bosc (zona d&#8217;observaci\u00f3 oficial):<\/strong> costa oberta al capvespre, amb passeig al costat del mar, bars i lavabos a m\u00e0. La ZOO abasta des de l&#8217;aparcament del passeig mar\u00edtim fins al far de Cap d&#8217;Artrutx. L&#8217;aparcament \u00e9s ampli per\u00f2 s&#8217;omplir\u00e0 molt aviat aquell dia, i a aquella hora amb prou feines queda ombra. El tr\u00e0nsit es tancar\u00e0 a partir de les 17:00, o abans si l&#8217;aflu\u00e8ncia ho exigeix.   <\/li>\n<li><strong>Cala Blanca (zona d&#8217;observaci\u00f3 oficial):<\/strong> una mica menys concorreguda, amb horitz\u00f3 obert a l&#8217;oest des de les roques laterals de la cala i restaurants a la pr\u00f2pia urbanitzaci\u00f3. La ZOO va del Clot de sa Cera al restaurant Es Mirador. S&#8217;aparca al carrer; conv\u00e9 arribar amb marge i caminar els \u00faltims metres.  <\/li>\n<li><strong>Cala Santandria:<\/strong> cala resguardada del vent a pocs minuts de Ciutadella, c\u00f2moda per a fam\u00edlies, amb bars vora l&#8217;arena. No \u00e9s zona oficial, aix\u00ed que no hi haur\u00e0 dispositiu espec\u00edfic: l&#8217;aparcament al carrer \u00e9s limitat i com m\u00e9s aviat arribis, millor lloc. <\/li>\n<li><strong>Son Xoriguer i la zona de Cap d&#8217;Artrutx:<\/strong> l&#8217;extrem sud-oest de l&#8217;illa, amb el far d&#8217;Artrutx com a refer\u00e8ncia, passeig pla orientat de ple a la posta de sol i serveis de Cala en Bosc a un curt passeig. Sol c\u00f3rrer brisa marina: agradable a l&#8217;agost, per\u00f2 subjecta el tr\u00edpode. <\/li>\n<\/ul>\n<h3>Millors fars<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (acc\u00e9s regulat el 12 d&#8217;agost):<\/strong> ofereix un horitz\u00f3 excel\u00b7lent cap a l&#8217;oest, per\u00f2 el dispositiu oficial <strong>tanca l&#8217;aparcament des de les 8:00<\/strong> i regula l&#8217;acc\u00e9s per la carretera CF-5. Ciutadella ho considera a m\u00e9s <strong>zona de risc<\/strong>, juntament amb Cala Morell i el Pont d&#8217;en Gil, amb control de la Policia Local. No comptis amb poder arribar-hi en cotxe aquell dia. Fora del 12 d&#8217;agost continua sent una meravella: \u00e9s en ple <a href=\"https:\/\/voyagermenorca.com\/ca\/guia-turistico-cami-de-cavalls\/\">Cam\u00ed de Cavalls<\/a> i \u00e9s una de les zones de m\u00e0xima foscor de l&#8217;illa.   <\/li>\n<li><strong>Far d&#8217;Artrutx:<\/strong> al v\u00e8rtex sud-oest, amb orientaci\u00f3 perfecta al ponent, terreny pla i aparcament relativament proper. Queda dins de la zona d&#8217;observaci\u00f3 oficial de Cala en Bosc: dels fars, el m\u00e9s c\u00f2mode i l&#8217;\u00fanic amb dispositiu oficial. <\/li>\n<li><strong>Far de Cavalleria (acc\u00e9s regulat el 12 d&#8217;agost):<\/strong> els seus penya-segats oberts a l&#8217;oest ofereixen un horitz\u00f3 net i un entorn espectacular, per\u00f2 el <strong>Cam\u00ed de Tramuntana fins al far (CF-3) estar\u00e0 regulat<\/strong> aquell dia, igual que el propi Cam\u00ed de Tramuntana a la rotonda d&#8217;intersecci\u00f3 Me-15 \/ Me-7. L&#8217;alternativa oficial en aquella zona de l&#8217;illa \u00e9s el Carrer des Tamarells, a Platges de Fornells. <\/li>\n<\/ul>\n<p>Pots ampliar a la nostra <a href=\"https:\/\/voyagermenorca.com\/ca\/guia-faros-menorca\/\">guia dels 7 fars de Menorca<\/a>.<\/p>\n<h3>Millors penya-segats i miradors<\/h3>\n<ul>\n<li><strong>Penya-segats de Punta Nati i de la costa nord de Ciutadella:<\/strong> al\u00e7ada i un horitz\u00f3 mar\u00ed de 180\u00b0, per\u00f2 afectats pel mateix dispositiu d&#8217;accessos que el far de Punta Nati.<\/li>\n<li><strong>Pont d&#8217;en Gil:<\/strong> l&#8217;arc natural de la costa oest, un dels miradors de posta de sol m\u00e9s famosos de l&#8217;illa, per\u00f2 <strong>considerat zona de risc el 12 d&#8217;agost<\/strong>, amb control policial. S&#8217;hi arriba caminant des de la zona de Cala en Blanes per un tram de costa sense ombra ni serveis i amb penya-segat obert: no \u00e9s el lloc per a una nit de m\u00e0xima aflu\u00e8ncia. Alternativa oficial molt propera: l&#8217;<strong>Avinguda Los Delfines<\/strong>.  <\/li>\n<li><strong>Passeig Mar\u00edtim de Ciutadella:<\/strong> pla, pavimentat i accessible, amb vista despejada al mar, el port i el casc antic de fons, i bars i serveis a un pas. No figura com a zona oficial, per\u00f2 \u00e9s dels m\u00e9s concorreguts de l&#8217;illa: reserva el teu lloc amb molta antelaci\u00f3. La zona oficial m\u00e9s propera \u00e9s Son Blanc. Veure la nostra guia de <a href=\"https:\/\/voyagermenorca.com\/ca\/capvespre-menorca-9-miradors\/\">9 miradors per a la posta de sol a Menorca<\/a>.   <\/li>\n<\/ul>\n<h3>Des del mar<\/h3>\n<p>Observar l&#8217;eclipsi des del mar pot oferir un horitz\u00f3 despedat, per\u00f2 requereix una planificaci\u00f3 professional. Nom\u00e9s s&#8217;ha de fer amb un patr\u00f3 experimentat o una empresa autoritzada, consultant pr\u00e8viament la previsi\u00f3 mar\u00edtima, els avisos de navegaci\u00f3 i les restriccions que puguin establir-se. El Consell Insular recorda a m\u00e9s <strong>no fondejar sobre praderies de posid\u00f2nia<\/strong>, mantenir dist\u00e0ncia de seguretat entre embarcacions, evitar maniobres de risc i planificar amb antelaci\u00f3 el retorn a port, perqu\u00e8 es preveu una concentraci\u00f3 molt alta d&#8217;embarcacions just al final de l&#8217;eclipsi.  <\/p>\n<h3>Jaciments arqueol\u00f2gics<\/h3>\n<p>El Consell Insular desplegar\u00e0 vigilants al <strong>castell de Santa \u00c0gueda<\/strong> i a <strong>Torre d&#8217;en Galm\u00e8s<\/strong> i altres jaciments de titularitat p\u00fablica, per ordenar els accessos i evitar que es pugi a talaiots, torres i estructures patrimonials. S\u00f3n monuments de m\u00e9s de tres mil anys: es miren, no s&#8217;escalen. <\/p>\n<h3>Taula comparativa de punts d&#8217;observaci\u00f3<\/h3>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Lloc<\/th>\n<th>Tipus<\/th>\n<th>Horitz\u00f3 oest<\/th>\n<th>Aflu\u00e8ncia prevista<\/th>\n<th>Acc\u00e9s el 12 d&#8217;agost<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Cala en Bosc <em>(oficial)<\/em><\/td>\n<td>Platja<\/td>\n<td>Excel\u00b7lent<\/td>\n<td>Alta<\/td>\n<td>F\u00e0cil, amb serveis; tr\u00e0nsit tancat des de les 17:00<\/td>\n<\/tr>\n<tr>\n<td>Cala Blanca <em>(oficial)<\/em><\/td>\n<td>Platja<\/td>\n<td>Excel\u00b7lent<\/td>\n<td>Mitjana-alta<\/td>\n<td>F\u00e0cil; tr\u00e0nsit tancat des de les 17:00<\/td>\n<\/tr>\n<tr>\n<td>Son Blanc <em>(oficial)<\/em><\/td>\n<td>Litoral urb\u00e0<\/td>\n<td>Molt bo<\/td>\n<td>Alta<\/td>\n<td>A peu des de Ciutadella; tr\u00e0nsit tancat des de les 17:00<\/td>\n<\/tr>\n<tr>\n<td>Avinguda Los Delfines <em>(oficial)<\/em><\/td>\n<td>Passeig urb\u00e0<\/td>\n<td>Molt bo<\/td>\n<td>Mitjana-alta<\/td>\n<td>F\u00e0cil; tr\u00e0nsit tancat des de les 17:00<\/td>\n<\/tr>\n<tr>\n<td>Cap d&#8217;Artrutx \/ Far d&#8217;Artrutx<\/td>\n<td>Far\/costa<\/td>\n<td>Excel\u00b7lent<\/td>\n<td>Mitjana<\/td>\n<td>Dins de la zona oficial de Cala en Bosc<\/td>\n<\/tr>\n<tr>\n<td>Passeig Mar\u00edtim de Ciutadella<\/td>\n<td>Passeig urb\u00e0<\/td>\n<td>Molt bo<\/td>\n<td>Molt alta<\/td>\n<td>F\u00e0cil, a peu des del centre; sense dispositiu oficial<\/td>\n<\/tr>\n<tr>\n<td>Cala Santandria<\/td>\n<td>Cala<\/td>\n<td>Bo<\/td>\n<td>Mitjana-alta<\/td>\n<td>F\u00e0cil, familiar; sense dispositiu oficial<\/td>\n<\/tr>\n<tr>\n<td>Far de Punta Nati<\/td>\n<td>Far\/penya-segat<\/td>\n<td>Excel\u00b7lent<\/td>\n<td>Zona de risc<\/td>\n<td>Carretera CF-5 regulada i aparcament tancat des de les 8:00<\/td>\n<\/tr>\n<tr>\n<td>Far de Cavalleria<\/td>\n<td>Far\/penya-segat<\/td>\n<td>Bo<\/td>\n<td>Alta<\/td>\n<td>Acc\u00e9s CF-3 regulat<\/td>\n<\/tr>\n<tr>\n<td>Des del mar (costa oest)<\/td>\n<td>Embarcaci\u00f3<\/td>\n<td>Total<\/td>\n<td>\u2014<\/td>\n<td>Nom\u00e9s amb patr\u00f3 experimentat o empresa autoritzada<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"orientacion\">Orientaci\u00f3 del Sol i horitz\u00f3<\/h2>\n<p>En el moment del m\u00e0xim, el Sol es trobar\u00e0 cap a l&#8217;<strong>oest-nord-oest, amb un azimut d&#8217;uns 288\u00b0<\/strong>. Tradu\u00eft a la pr\u00e0ctica: situa&#8217;t mirant al mar a la costa oest i busca el punt per on el Sol s&#8217;est\u00e0 ponent. Una br\u00faixola (o la de l&#8217;app Horitz\u00f3 2026) et confirmar\u00e0 la direcci\u00f3 exacta. Comprova el dia anterior, a la mateixa hora, que no hi hagi cap obstacle (grua, pal, promontori) en aquella l\u00ednia. El Govern va fer un assaig oficial de visibilitat els dies 29 i 30 d&#8217;abril precisament per verificar aquests punts: si el Sol es veia a aquella hora aquells dies, es veur\u00e0 tamb\u00e9 el 12 d&#8217;agost.    <\/p>\n<h2 id=\"meteo\">Meteorologia: probabilitat de cels despejats<\/h2>\n<p>Agost \u00e9s, climatol\u00f2gicament, un dels mesos m\u00e9s estables i secs de Menorca, amb predomini de cels despejats i baixa probabilitat de precipitaci\u00f3. Aix\u00f2 juga a favor. Per\u00f2 un eclipsi tan baix sobre l&#8217;horitz\u00f3 t\u00e9 un enemic espec\u00edfic: <strong>els n\u00favols baixos sobre el mar<\/strong>, que poden formar-se encara que la resta del cel estigui net. Recomanacions:   <\/p>\n<ul>\n<li>Revisa la previsi\u00f3 d&#8217;<strong>AEMET<\/strong> i mapes de nuvolositat els 3-4 dies previs, parant atenci\u00f3 a la nuvolositat baixa a l&#8217;horitz\u00f3 mar\u00ed.<\/li>\n<li>Tingues sempre un <strong>pla B<\/strong> en un altre punt de la costa oest al qual puguis despla\u00e7ar-te amb marge, tenint en compte les restriccions de tr\u00e0nsit previstes.<\/li>\n<li>Recorda que els <strong>n\u00favols alts<\/strong> (cirrus) encara permeten veure el fenomen; els baixos s\u00f3n els que l&#8217;arru\u00efnen.<\/li>\n<li>Des del mar hi ha m\u00e9s marge per esquivar la nuvolositat, per\u00f2 nom\u00e9s amb un patr\u00f3 experimentat o una empresa autoritzada (vegeu l&#8217;apartat \u201cDes del mar\u201d).<\/li>\n<\/ul>\n<h2 id=\"luminica\">Contaminaci\u00f3 lum\u00ednica i l&#8217;avantatge Starlight de Menorca<\/h2>\n<p>Menorca \u00e9s <strong>Reserva i Dest\u00ed Tur\u00edstic Starlight<\/strong> des de 2019 (certificaci\u00f3 de la Fundaci\u00f3n Starlight), i tota l&#8217;illa forma part d&#8217;una Reserva de la Biosfera. Compta amb un Reglament de Protecci\u00f3 del Cel Nocturn i amb <strong>zones de m\u00e0xima foscor<\/strong> \u2014Punta Nati, Macarella-Son Saura, Cavalleria-Cala del Pilar, Monte Toro, s&#8217;Albufera des Grau, entre d&#8217;altres\u2014 amb una contaminaci\u00f3 lum\u00ednica pr\u00e0cticament inexistent. <\/p>\n<p>Per a l&#8217;eclipsi en si, amb el Sol encara sobre l&#8217;horitz\u00f3, la contaminaci\u00f3 lum\u00ednica no \u00e9s determinant. Per\u00f2 es torna decisiva just despr\u00e9s: si et quedes en un punt fosc de la costa oest despr\u00e9s de la posta de sol, tindr\u00e0s un cel excepcional per a la segona part de la nit (veure Perseides, m\u00e9s avall). Tingues en compte que diverses d&#8217;aquestes zones tenen l&#8217;acc\u00e9s regulat el 12 d&#8217;agost.  <\/p>\n<h2 id=\"afluencia\">Restriccions d&#8217;acc\u00e9s, aflu\u00e8ncia i mobilitat: el dispositiu oficial<\/h2>\n<p>S&#8217;espera una aflu\u00e8ncia molt alta de \u201cca\u00e7adors d&#8217;eclipsis\u201d i visitants de tota Europa, en ple agost i amb l&#8217;illa ja en temporada alta. El Govern balear va activar el protocol <strong>ECLIPBAL<\/strong>, dins del Pla Territorial de Protecci\u00f3 Civil, i el dispositiu de seguretat, mobilitat i protecci\u00f3 forestal ja est\u00e0 publicat, en coordinaci\u00f3 amb el Consell Insular i els ajuntaments. Aquests s\u00f3n els punts que m\u00e9s t&#8217;afecten com a visitant.  <\/p>\n<h3>Restriccions generals<\/h3>\n<ul>\n<li>A les <strong>quatre zones oficials d&#8217;observaci\u00f3 de Ciutadella<\/strong>, el tr\u00e0nsit es tancar\u00e0 <strong>a partir de les 17:00<\/strong>, o abans si l&#8217;aflu\u00e8ncia ho exigeix.<\/li>\n<li>A la <strong>resta de Menorca<\/strong>, els horaris i les restriccions depenen de cada carretera i municipi. Amb car\u00e0cter general, les restriccions a les vies afectades s&#8217;aplicaran <strong>entre les 15:00 i les 21:00<\/strong>, encara que podran avan\u00e7ar-se o prolongar-se per raons de seguretat. <\/li>\n<li>Les restriccions <strong>no afecten<\/strong> residents, serveis essencials, transport p\u00fablic ni despla\u00e7aments degudament justificats.<\/li>\n<\/ul>\n<h3>Accessos regulats o tancats a Menorca<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (CF-5):<\/strong> acc\u00e9s regulat i <strong>aparcament tancat des de les 8:00<\/strong>.<\/li>\n<li><strong>Cam\u00ed de Tramuntana:<\/strong> regulaci\u00f3 a la rotonda d&#8217;intersecci\u00f3 Me-15 \/ Me-7.<\/li>\n<li><strong>Far de Cavalleria (CF-3):<\/strong> Cam\u00ed de Tramuntana fins al far, regulat.<\/li>\n<li><strong>Monte Toro (Me-13):<\/strong> carretera des Mercadal al Toro, regulada.<\/li>\n<li><strong>Ferreries:<\/strong> tancament dels camins d&#8217;acc\u00e9s a l&#8217;Enclusa i al Cam\u00ed de Tramuntana d&#8217;Ets Alocs, amb tancaments graduals (primer parcial a la Me-1, despr\u00e9s a l&#8217;acc\u00e9s a la finca de Binissu\u00e8s i, finalment, acc\u00e9s nom\u00e9s per a residents de les finques del Cam\u00ed de Tramuntana i allotjaments tur\u00edstics).<\/li>\n<li><strong>Sant Llu\u00eds:<\/strong> Passeig de Cap d&#8217;en Font tancat a les dues interseccions amb el carrer del Cal\u00f3 Blanc, i Passeig de la Mar (Binissaf\u00faller Roters) als encreuaments amb Llevant i Tramuntana, <strong>entre les 19:00 i les 21:30<\/strong>.<\/li>\n<li><strong>Ma\u00f3:<\/strong> possible tancament del Passeig Mar\u00edtim des de les 19:00 i restriccions a Binidal\u00ed des de les 18:30; controls a Es Canutells, Es Grau i altres punts d&#8217;aflu\u00e8ncia; acc\u00e9s restringit a Fav\u00e0ritx i tancament de les bateries durant la jornada.<\/li>\n<li><strong>Ciutadella:<\/strong> <strong>Cala Morell, el Far de Punta Nati i el Pont d&#8217;en Gil<\/strong> estan considerats zones de risc, amb control de la Policia Local.<\/li>\n<\/ul>\n<h3>Pantalles per seguir l&#8217;eclipsi sense despla\u00e7ar-te<\/h3>\n<p>Si prefereixes evitar carreteres i aglomeracions, diversos municipis instal\u00b7laran pantalles: <strong>Ciutadella<\/strong>, a la pla\u00e7a des Born; <strong>Alaior<\/strong>, a sa Pla\u00e7a; i <strong>Ma\u00f3<\/strong>, als Cinemes Ocimax i al port.<\/p>\n<h3>Aparcament i bus llan\u00e7adora<\/h3>\n<p>Per a la zona de <strong>Son Bou<\/strong> es recomana accedir per <strong>Torre Sol\u00ed<\/strong>, on s&#8217;habilitar\u00e0 un aparcament a Torre Sol\u00ed II amb <strong>bus llan\u00e7adora continu entre les 17:00 i les 00:30<\/strong>. \u00c9s, probablement, l&#8217;opci\u00f3 m\u00e9s c\u00f2moda de tota l&#8217;illa si vas sense pressa i vols oblidar-te del cotxe. <\/p>\n<p><strong>Conseq\u00fc\u00e8ncia pr\u00e0ctica:<\/strong> no depenguis d&#8217;un \u00fanic acc\u00e9s ni improvisis a \u00faltima hora. Les mesures s&#8217;aniran actualitzant els dies previs en funci\u00f3 de l&#8217;aflu\u00e8ncia prevista, aix\u00ed que <strong>consulta <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">la informaci\u00f3 oficial del Govern<\/a> el mateix dia<\/strong>, i segueix en tot moment les indicacions dels serveis d&#8217;emerg\u00e8ncia. <\/p>\n<h2 id=\"como-llegar\">Com arribar-hi, aparcament i transport p\u00fablic<\/h2>\n<h3>Com arribar a la costa oest<\/h3>\n<p>La majoria de punts recomanats s\u00f3n al terme de Ciutadella, a l&#8217;extrem oest de l&#8217;illa, a uns 45 minuts en cotxe de l&#8217;aeroport de Ma\u00f3 per la carretera general Me-1. Des de Ciutadella, les urbanitzacions del sud-oest (Cala en Bosc, Cala Blanca, Cala Santandria) s\u00f3n a 10-15 minuts.  Aquell dia, compta amb molt m\u00e9s temps de l&#8217;habitual.<\/p>\n<h3>Aparcament<\/h3>\n<ul>\n<li>A Ciutadella hi ha aparcament gratu\u00eft al passeig de Sant Nicolau i al passeig mar\u00edtim, a m\u00e9s de zona blava al centre.<\/li>\n<li>Si vas en cotxe a una de les zones oficials de Ciutadella, <strong>arriba abans de les 17:00<\/strong>, perqu\u00e8 el tr\u00e0nsit pot tancar-se fins i tot abans segons l&#8217;aflu\u00e8ncia. Sempre que sigui possible, ves caminant des del teu allotjament o utilitza el transport p\u00fablic. <\/li>\n<li>En punts naturals, l&#8217;espai \u00e9s limitat i diversos accessos estan regulats: no aparquis mai fora de les zones permeses ni bloquegis camins o accessos d&#8217;emerg\u00e8ncia.<\/li>\n<\/ul>\n<h3>Transport p\u00fablic<\/h3>\n<p>Menorca compta amb l\u00ednies regulars d&#8217;autob\u00fas que connecten Ma\u00f3 i Ciutadella durant tot l&#8217;any, i a l&#8217;estiu hi ha serveis des de l&#8217;estaci\u00f3 de Ciutadella cap a les cales del sud i sud-oest. Aquell dia hi haur\u00e0 m\u00e9s demanda de l&#8217;habitual i \u00e9s possible que es reforcin o reorganitzin algunes l\u00ednies: comprova horaris actualitzats amb l&#8217;operador. Anar en transport p\u00fablic \u2014o usar el bus llan\u00e7adora de Torre Sol\u00ed per a Son Bou\u2014 i caminar l&#8217;\u00faltim tram pot estalviar-te el problema de l&#8217;aparcament.  <\/p>\n<h2 id=\"seguridad\">Seguretat ocular: el m\u00e9s important de tot<\/h2>\n<p>Mai es pot mirar directament al Sol sense protecci\u00f3 adequada, <strong>excepte quan el disc solar queda completament cobert per la Lluna durant la totalitat<\/strong>.<\/p>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-seguridad-eclipse-eso.jpg?w=800&#038;ssl=1\" alt=\"Infografia en espanyol sobre com observar un eclipsi solar amb seguretat ocular\"><figcaption>Com observar l&#8217;eclipsi amb seguretat ocular. Cr\u00e8dit: ESO \/ B. Tafreshi (twanight.org) \/ P. Hor\u00e1lek. <\/figcaption><\/figure>\n<ul>\n<li>Utilitza sempre <strong>ulleres d&#8217;eclipsi homologades<\/strong> (norma <strong>ISO 12312-2<\/strong>) sempre que miris directament al Sol durant les fases parcials. Unes ulleres de sol normals, per fosques que semblin, no protegeixen: deixen passar radiaci\u00f3 infraroja i ultraviolada que pot danyar la retina sense que ho notis. Tampoc serveixen radiografies, vidres fumats ni filtres casolans.  <\/li>\n<li>Compra les ulleres amb antelaci\u00f3 i a un prove\u00efdor fiable: els dies previs s&#8217;esgoten. El Govern ha recordat al sector comercial que nom\u00e9s s&#8217;han de vendre productes que compleixin la normativa internacional. <\/li>\n<li><strong>Treu-te les ulleres \u00fanicament quan el Sol estigui completament cobert i ja no es vegi cap part brillant. Torna a posar-te-les immediatament quan reaparegui el primer espurneig de llum. <\/strong> Les hores s\u00f3n nom\u00e9s orientatives: guia&#8217;t pel que veus, no pel rellotge.<\/li>\n<li>Si utilitzes c\u00e0mera, prism\u00e0tics o telescopi, necessiten el seu <strong>propi filtre solar<\/strong> durant la parcial; mirar el Sol a trav\u00e9s d&#8217;\u00f2ptica sense filtre \u00e9s especialment perill\u00f3s.<\/li>\n<li>Un m\u00e8tode alternatiu i totalment segur \u00e9s la <strong>projecci\u00f3 indirecta<\/strong>: fes un petit forat en una cartolina i projecta la imatge del Sol sobre una altra superf\u00edcie, sense mirar mai directament.<\/li>\n<\/ul>\n<h2 id=\"equipo\">Equip recomanat<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Imprescindible<\/th>\n<th>Recomanable<\/th>\n<th>Per a fotografia<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Ulleres d&#8217;eclipsi ISO 12312-2 (una per persona + recanvi)<\/td>\n<td>Cadira plegable o manta<\/td>\n<td>Tr\u00edpode estable<\/td>\n<\/tr>\n<tr>\n<td>Aigua i alguna cosa per menjar<\/td>\n<td>Gorra i protecci\u00f3 solar<\/td>\n<td>Filtre solar per a l&#8217;objectiu<\/td>\n<\/tr>\n<tr>\n<td>Rellotge\/m\u00f2bil en hora local<\/td>\n<td>Bateria externa<\/td>\n<td>Teleobjectiu (200-500 mm ideal)<\/td>\n<\/tr>\n<tr>\n<td>Protecci\u00f3 per al m\u00f2bil si fotografiar\u00e0s la parcial<\/td>\n<td>Llanterna vermella (no enlluerna)<\/td>\n<td>Disparador remot o temporitzador<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"fotografia\">Fotografia de l&#8217;eclipsi<\/h2>\n<p>Fotografiar un eclipsi amb el Sol a 2\u00b0 sobre el mar \u00e9s dif\u00edcil i preci\u00f3s alhora. Idees perqu\u00e8 surti b\u00e9: <\/p>\n<ul>\n<li><strong>Fase parcial:<\/strong> filtre solar obligatori a l&#8217;objectiu. Sense ell, danyar\u00e0s el sensor (i la teva vista si utilitzes visor \u00f2ptic). <\/li>\n<li><strong>Totalitat:<\/strong> quan el Sol estigui completament cobert, retira el filtre per captar la corona. Utilitza exposicions variades (horquillat) perqu\u00e8 el rang de brillantor \u00e9s enorme. Torna a posar el filtre tan bon punt reaparegui el primer espurneig.  <\/li>\n<li><strong>Amb m\u00f2bil:<\/strong> filtre solar davant de la lent a la parcial; a la totalitat pots treure&#8217;l. Bloqueja l&#8217;enfocament i l&#8217;exposici\u00f3 manualment. <\/li>\n<li><strong>Composici\u00f3:<\/strong> aprofita que el Sol est\u00e0 baix\u00edssim per incloure el mar, un far o una silueta de costa. \u00c9s el gran valor diferencial de Menorca. <\/li>\n<li><strong>Consell d&#8217;or:<\/strong> dedica la major part d&#8217;aquest poc m\u00e9s d&#8217;un minut a <strong>mirar<\/strong>, no a la pantalla. La corona en directe no cap en cap foto. <\/li>\n<\/ul>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" loading=\"lazy\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-ajustes-camara-eclipse-menorca-2026.jpg?w=800&#038;ssl=1\" alt=\"Infografia amb els ajustos r\u00e0pids de c\u00e0mera per fotografiar l\u2019eclipsi solar: filtre solar, ISO, obertura, velocitat i enfocament per a la fase parcial i la totalitat\"><figcaption>Ajustos orientatius de c\u00e0mera per a la fase parcial (amb filtre solar obligatori) i la totalitat. Revisa l\u2019histograma i adapta l\u2019exposici\u00f3 al teu equip. <\/figcaption><\/figure>\n<h2 id=\"familias\">Consells per a fam\u00edlies, nens, gent gran i mobilitat redu\u00efda<\/h2>\n<h3>Per a fam\u00edlies i nens<\/h3>\n<ul>\n<li>\u00c9s una experi\u00e8ncia educativa magn\u00edfica: explica&#8217;ls abans com funciona el sistema Sol-Terra-Lluna amb una llanterna i dues pilotes.<\/li>\n<li><strong>El Govern recomana que els menors de sis anys no observin directament l&#8217;eclipsi.<\/strong> Per a ells s&#8217;aconsella la projecci\u00f3 indirecta, una pantalla o la retransmissi\u00f3 televisiva.<\/li>\n<li>Els altres menors han d&#8217;estar <strong>constantment supervisats per una persona adulta<\/strong>, amb les seves pr\u00f2pies ulleres homologades durant tota la fase parcial.<\/li>\n<li>Tria un punt c\u00f2mode i amb serveis propers (Cala en Bosc, Cala Blanca, Son Bou amb bus llan\u00e7adora) per tenir banys i ombra durant la llarga espera.<\/li>\n<li>Converteix la tarda en p\u00edcnic: far\u00e0 l&#8217;espera m\u00e9s suportable i crear\u00e0 el record.<\/li>\n<\/ul>\n<h3>Per a persones grans<\/h3>\n<ul>\n<li>Prioritza punts amb acc\u00e9s f\u00e0cil i poca caminada: Son Blanc, l&#8217;avinguda Los Delfines o Cala Santandria.<\/li>\n<li>Cadira amb respatller, aigua abundant i protecci\u00f3 solar; l&#8217;espera pot ser de diverses hores amb calor.<\/li>\n<li>Evita els accessos per carretera estreta i els trams a peu dels fars, que a m\u00e9s estan regulats aquell dia.<\/li>\n<li>Les pantalles de la pla\u00e7a des Born (Ciutadella), sa Pla\u00e7a (Alaior) o el port de Ma\u00f3 s\u00f3n una alternativa molt c\u00f2moda.<\/li>\n<\/ul>\n<h3>Per a persones amb mobilitat redu\u00efda<\/h3>\n<ul>\n<li>Les zones oficials planes i pavimentades de Ciutadella \u2014<strong>Son Blanc i l&#8217;avinguda Los Delfines<\/strong>\u2014 i el <strong>Passeig Mar\u00edtim de Ciutadella<\/strong> s\u00f3n les millors opcions: ferm pla, horitz\u00f3 oest i serveis a prop.<\/li>\n<li>Algunes platges de Ciutadella disposen de passarel\u00b7les; consulta quines mantenen l&#8217;acc\u00e9s aquell dia.<\/li>\n<li>Arriba for\u00e7a abans de les 17:00 per assegurar una pla\u00e7a d&#8217;aparcament accessible propera, at\u00e8s el dispositiu especial de tr\u00e0nsit.<\/li>\n<li>Consulta al <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">web oficial<\/a> si les zones d&#8217;observaci\u00f3 habiliten espais reservats.<\/li>\n<\/ul>\n<h2 id=\"errores\">Errors que comet la majoria de visitants<\/h2>\n<ul>\n<li><strong>Triar el lloc pel paisatge i no per l&#8217;horitz\u00f3 oest.<\/strong> Un mirador preci\u00f3s mirant a l&#8217;est o tapat per un tur\u00f3 no serveix per a aquest eclipsi.<\/li>\n<li><strong>Donar per fet que una zona oficial \u00e9s la que millor es veu.<\/strong> Les ZOO es van triar per seguretat i capacitat, no per visibilitat. Comprova el teu punt amb Horitz\u00f3 2026. <\/li>\n<li><strong>Arribar tard.<\/strong> A les zones oficials de Ciutadella el tr\u00e0nsit es tanca des de les 17:00 i hi ha carreteres regulades: qui surti a \u00faltima hora pot quedar-se aturat durant la totalitat.<\/li>\n<li><strong>Comptar a arribar en cotxe a Punta Nati o Cavalleria.<\/strong> Tots dos accessos estan regulats el 12 d&#8217;agost i l&#8217;aparcament de Punta Nati tanca a les 8:00.<\/li>\n<li><strong>Utilitzar ulleres de sol normals.<\/strong> No protegeixen. Nom\u00e9s valen les homologades ISO 12312-2. <\/li>\n<li><strong>Comprar les ulleres el mateix dia.<\/strong> S&#8217;esgoten; compra-les amb antelaci\u00f3.<\/li>\n<li><strong>No comprovar l&#8217;horitz\u00f3 real.<\/strong> Un pal, una grua o un banc de n\u00favols baixos poden tapar 2\u00b0.<\/li>\n<li><strong>Mirar la totalitat a trav\u00e9s del m\u00f2bil.<\/strong> Viu-la amb els ulls; la c\u00e0mera no capta el que veu l&#8217;ull.<\/li>\n<li><strong>Oblidar que \u00e9s al capvespre.<\/strong> Despr\u00e9s no hi ha marge: el Sol es pon. No hi haur\u00e0 \u201csegona oportunitat\u201d aquell dia. <\/li>\n<\/ul>\n<h2 id=\"historia\">Curiositats hist\u00f2riques: com es van viure eclipsis anteriors a Espanya<\/h2>\n<p>El 12 d&#8217;agost de 2026 no ser\u00e0 la primera vegada que les Balears es converteixen en escenari mundial d&#8217;un eclipsi. El <strong>30 d&#8217;agost de 1905<\/strong>, un eclipsi solar total va creuar Espanya i va ser visible com a total des de les illes. A difer\u00e8ncia del de 2026, aquell va oc\u00f3rrer al <strong>migdia<\/strong> (cap a les 12:02 h a les Balears) i la totalitat va durar gaireb\u00e9 <strong>quatre minuts<\/strong>, cosa que el va convertir en una ocasi\u00f3 cient\u00edfica extraordin\u00e0ria.  <\/p>\n<p>Va ser un esdeveniment social i cient\u00edfic de primer ordre. A la Pen\u00ednsula i les illes es van despla\u00e7ar desenes d&#8217;expedicions internacionals: comissions angleses, alemanyes i de l&#8217;Acad\u00e8mia de Ci\u00e8ncies de R\u00fassia. A Burgos es van llan\u00e7ar globus aerost\u00e0tics \u2014el <em>J\u00fapiter<\/em>, l&#8217;<em>Ur\u00e0<\/em> i el <em>Mart<\/em>\u2014 i el jove enginyer <strong>Emilio Herrera<\/strong> es va convertir en una de les primeres persones a observar la totalitat des de l&#8217;aire, deixant una descripci\u00f3 memorable de la corona sobre un mar de n\u00favols. A Mallorca, les expedicions es van instal\u00b7lar al Vel\u00f2drom de Son Espanyolet i al Grand Hotel; fins i tot es va ordenar a les f\u00e0briques tancar durant l&#8217;eclipsi perqu\u00e8 el fum no enterbol\u00eds l&#8217;atmosfera. Un dels impulsors de l&#8217;expedici\u00f3 brit\u00e0nica, G. F. Chambers, va acabar observant-lo <strong>des del mar<\/strong> \u2014 una opci\u00f3 que, amb la deguda planificaci\u00f3 professional, continua tenint sentit 121 anys despr\u00e9s.    <\/p>\n<p>En el conjunt d&#8217;Espanya, l&#8217;\u00faltim eclipsi solar total abans del de 2026 va ser el del <strong>17 d&#8217;abril de 1912<\/strong>. Aquells primers anys del segle XX van formar un \u201ctrio\u201d hist\u00f2ric (1900, 1905 i 1912) que la comunitat astron\u00f2mica internacional va batejar com \u201cels eclipsis espanyols\u201d. La hist\u00f2ria rima: 2026, 2027 i 2028 formen el nou trio ib\u00e8ric.  <\/p>\n<h2 id=\"perseidas\">Un colof\u00f3 d&#8217;or per a la nit: les Perseides<\/h2>\n<p>La data de l&#8217;eclipsi coincideix gaireb\u00e9 exactament amb el m\u00e0xim de les <strong>Perseides<\/strong>, la coneguda pluja d&#8217;estels d&#8217;agost. Si el cel es mant\u00e9 clar i et trobes en un punt fosc de la costa oest \u2014una de les zones Starlight de m\u00e0xima foscor\u2014, pots quedar-te despr\u00e9s de la posta de sol i gaudir d&#8217;un segon espectacle astron\u00f2mic aquella mateixa nit: dos fen\u00f2mens celestes en una sola vetllada, una cosa veritablement excepcional. Menorca, com a Reserva Starlight, \u00e9s un dels millors llocs del Mediterrani per a aix\u00f2.  <\/p>\n<h2 id=\"planificacion\">Planificaci\u00f3 completa del dia: checklist final<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Abans del dia<\/th>\n<th>El 12 d&#8217;agost<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Comprar ulleres ISO 12312-2 (amb antelaci\u00f3)<\/td>\n<td>Arribar al teu punt abans de les 17:00 (zones de Ciutadella)<\/td>\n<\/tr>\n<tr>\n<td>Triar 1 zona d&#8217;observaci\u00f3 oficial + 1 pla B<\/td>\n<td>Aparcar aviat o usar transport p\u00fablic \/ bus llan\u00e7adora<\/td>\n<\/tr>\n<tr>\n<td>Descarregar l&#8217;app Horitz\u00f3 Eclipsi 2026 i verificar l&#8217;horitz\u00f3<\/td>\n<td>Col\u00b7locar-se mirant a l&#8217;oest-nord-oest (azimut \u2248 288\u00b0)<\/td>\n<\/tr>\n<tr>\n<td>Revisar previsi\u00f3 AEMET els 3-4 dies previs<\/td>\n<td>Ulleres posades des de les 19:37:16 (primer contacte)<\/td>\n<\/tr>\n<tr>\n<td>Consultar accessos i restriccions a caib.es<\/td>\n<td>Treure&#8217;s les ulleres nom\u00e9s quan el Sol estigui totalment cobert<\/td>\n<\/tr>\n<tr>\n<td>Carregar c\u00e0mera\/m\u00f2bil i preparar filtre solar<\/td>\n<td>Tornar a posar-se les ulleres al primer espurneig de llum<\/td>\n<\/tr>\n<tr>\n<td>Preparar p\u00edcnic, aigua, cadira, protecci\u00f3 solar<\/td>\n<td>Quedar-se a les Perseides si el cel acompanya<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"faq\">Preguntes freq\u00fcents<\/h2>\n<h3>A quina hora \u00e9s l&#8217;eclipsi a Menorca?<\/h3>\n<p>A Ciutadella, segons l&#8217;IGN, l&#8217;eclipsi parcial comen\u00e7a a les <strong>19:37:16<\/strong> i la totalitat va de les <strong>20:30:16 a les 20:31:27<\/strong> (amb el m\u00e0xim a les 20:30:51). La posta de sol es produeix a les <strong>20:45:28<\/strong>. Els temps poden variar alguns segons segons el punt exacte d&#8217;observaci\u00f3.  <\/p>\n<h3>Quant dura la totalitat?<\/h3>\n<p>A Ciutadella, <strong>aproximadament 1 minut i 11 segons<\/strong> (dada de l&#8217;IGN per al municipi). Menorca \u00e9s el primer punt de les Balears on comen\u00e7a la totalitat, amb el Sol entre 1,4\u00b0 i 2\u00b0 sobre l&#8217;horitz\u00f3 segons la ubicaci\u00f3: l&#8217;altura m\u00e9s baixa de tot Espanya. <\/p>\n<h3>Quines s\u00f3n les zones d&#8217;observaci\u00f3 oficial a Menorca?<\/h3>\n<p>Nou: <strong>Cala en Bosc, Cala Blanca, Avinguda Los Delfines i Son Blanc<\/strong> (Ciutadella), <strong>Carrer des Tamarells<\/strong> (Platges de Fornells), <strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong> i les platges de <strong>Son Bou, Sant Tom\u00e0s i Talis<\/strong>. A les quatre zones de Ciutadella el tr\u00e0nsit es tanca des de les 17:00. El Govern recorda que s\u00f3n els punts m\u00e9s segurs i accessibles, no necess\u00e0riament els de millor visibilitat.  <\/p>\n<h3>Es far\u00e0 de nit a Menorca?<\/h3>\n<p>No del tot, ja que ocorre molt a prop de la posta de sol. El cel s&#8217;enfosquir\u00e0 notablement, amb to crepuscular en 360\u00b0, i baixar\u00e0 la temperatura, per\u00f2 no ser\u00e0 una nit tancada. <\/p>\n<h3>Necessito anar a un lloc especial o puc veure&#8217;l des de qualsevol part de Menorca?<\/h3>\n<p>Tota l&#8217;illa est\u00e0 dins la franja de totalitat, aix\u00ed que t\u00e8cnicament es pot veure des de qualsevol punt. El que marca la difer\u00e8ncia \u00e9s tenir un <strong>horitz\u00f3 oest buidat<\/strong>, perqu\u00e8 el Sol estar\u00e0 molt baix. Si pots veure&#8217;l des del teu allotjament amb horitz\u00f3 oest, \u00e9s l&#8217;opci\u00f3 m\u00e9s c\u00f2moda i segura.  <\/p>\n<h3>I si est\u00e0 ennuvolat aquell dia?<\/h3>\n<p>L\u2019agost sol donar cels estables a Menorca, per\u00f2 ning\u00fa ho garanteix. Els n\u00favols alts permeten veure part del fenomen; els baixos a l\u2019horitz\u00f3 oest podrien tapar la totalitat. Revisa la previsi\u00f3 els dies previs, comprova el teu punt amb l\u2019app Horitz\u00f3 2026 i tingues un pla B.  <\/p>\n<h3>Com protegeixo la vista?<\/h3>\n<p>Amb ulleres d&#8217;eclipsi homologades <strong>ISO 12312-2<\/strong> sempre que miris al Sol durant les fases parcials. Nom\u00e9s pots treure-te-les quan el Sol estigui completament cobert, i has de tornar a posar-te-les tan bon punt reaparegui el primer espurneig. Les ulleres de sol, radiografies o vidres fumats no serveixen.  <\/p>\n<h3>Puc fer fotos amb el m\u00f2bil?<\/h3>\n<p>S\u00ed, amb un filtre solar a la lent durant la parcial. Quan el Sol estigui completament cobert el pots treure. Bloqueja l&#8217;enfocament i l&#8217;exposici\u00f3 manualment i prepara l&#8217;enquadrament abans, perqu\u00e8 la totalitat dura poc m\u00e9s d&#8217;un minut.  <\/p>\n<h3>\u00c9s segur per a nens?<\/h3>\n<p>El Govern recomana que els <strong>menors de sis anys no observin directament<\/strong> l&#8217;eclipsi: per a ells, projecci\u00f3 indirecta, una pantalla o la retransmissi\u00f3 televisiva. La resta de menors pot observar-lo amb ulleres homologades durant tota la parcial i sota supervisi\u00f3 constant d&#8217;un adult. \u00c9s una experi\u00e8ncia educativa magn\u00edfica.  <\/p>\n<h3>Quan va ser l&#8217;\u00faltim eclipsi total visible a les Balears?<\/h3>\n<p>El 30 d&#8217;agost de 1905. En el conjunt d&#8217;Espanya, l&#8217;\u00faltim eclipsi total anterior al de 2026 va ser el del <strong>17 d&#8217;abril de 1912<\/strong>. Despr\u00e9s de l&#8217;eclipsi total del 2 d&#8217;agost de 2027, no hi haur\u00e0 un altre eclipsi total a Espanya fins al <strong>2053<\/strong>; el de 2028 ser\u00e0 <strong>anular<\/strong>, no total.  <\/p>\n<h3>Hi haur\u00e0 talls de tr\u00e0nsit o molta gent?<\/h3>\n<p>S\u00ed. A les quatre zones oficials de Ciutadella el tr\u00e0nsit es tanca <strong>des de les 17:00<\/strong> (abans si hi ha molta aflu\u00e8ncia). A la resta de l&#8217;illa, les restriccions depenen de cada via i municipi, generalment <strong>entre les 15:00 i les 21:00<\/strong>. Estan regulats els accessos al Far de Punta Nati (CF-5, amb l&#8217;aparcament tancat des de les 8:00), al Cam\u00ed de Tramuntana, al Far de Cavalleria (CF-3) i al Monte Toro (Me-13), a m\u00e9s de tancaments a Ferreries i Sant Llu\u00eds. Consulta el detall a l&#8217;apartat <a href=\"#afluencia\">del dispositiu oficial<\/a>.    <\/p>\n<h2 id=\"fuentes\">Fonts oficials i cient\u00edfiques<\/h2>\n<p style=\"font-size:0.95em;\">Les dades d\u2019aquesta guia provenen de fonts oficials i cient\u00edfiques, que recomanem consultar directament per a la informaci\u00f3 m\u00e9s actualitzada:<\/p>\n<ul style=\"font-size:0.95em;\">\n<li><strong>Instituto Geogr\u00e1fico Nacional (IGN)<\/strong> \u2014 <a href=\"https:\/\/eclipses.ign.es\/\" target=\"_blank\" rel=\"noopener\">eclipses.ign.es<\/a>, <a href=\"https:\/\/astronomia.ign.es\/eclipses-de-sol-y-luna\/eclipse-total-sol-de-12-de-agosto-2026\" target=\"_blank\" rel=\"noopener\">fitxa de l&#8217;eclipsi<\/a> i <a href=\"https:\/\/visualizadores.ign.es\/eclipses\" target=\"_blank\" rel=\"noopener\">visualitzador d&#8217;eclipsis<\/a> (horaris i dades per municipi).<\/li>\n<li><strong>Govern de les Illes Balears<\/strong> \u2014 <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">informaci\u00f3 oficial de l&#8217;eclipsi i les restriccions<\/a> i <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/zones-d-observaci%C3%B3-oficial-zoo-\" target=\"_blank\" rel=\"noopener\">zones d&#8217;observaci\u00f3 oficial (ZOO)<\/a>.<\/li>\n<li><strong>Consell Insular de Menorca i ajuntaments<\/strong> \u2014 dispositiu insular de mobilitat, accessos i protecci\u00f3 del patrimoni.<\/li>\n<li><strong>Horitz\u00f3 Eclipsi 2026<\/strong> \u2014 <a href=\"https:\/\/www.horitzo2026.com\" target=\"_blank\" rel=\"noopener\">horitzo2026.com<\/a> (app oficial de visibilitat segons l\u2019horitz\u00f3 real).<\/li>\n<li><strong>Ministeri de Transports i Mobilitat Sostenible<\/strong> \u2014 <a href=\"https:\/\/www.transportes.gob.es\/movilidad-sostenible\/estudios-movilidad-big-data\/el-trio-de-eclipses-solares-y-la-movilidad\" target=\"_blank\" rel=\"noopener\">visor HERMES i estudi de mobilitat del trio d&#8217;eclipsis<\/a>.<\/li>\n<li><strong>NASA<\/strong> \u2014 <a href=\"https:\/\/science.nasa.gov\/eclipses\/safety\/\" target=\"_blank\" rel=\"noopener\">science.nasa.gov\/eclipses\/safety<\/a> (seguretat ocular) i <a href=\"https:\/\/ciencia.nasa.gov\/eclipses\/lo-que-necesitas-saber-sobre-los-eclipses-solares\/\" target=\"_blank\" rel=\"noopener\">ciencia.nasa.gov<\/a>.<\/li>\n<li><strong>European Southern Observatory (ESO)<\/strong> \u2014 material de seguretat ocular.<\/li>\n<li><strong>Fundaci\u00f3n Starlight<\/strong> i <strong>Consell Insular de Menorca<\/strong> \u2014 certificaci\u00f3 Starlight i cel nocturn.<\/li>\n<li><strong>AEMET<\/strong> \u2014 previsi\u00f3 meteorol\u00f2gica.<\/li>\n<\/ul>\n<div style=\"border:1px solid #d7a553;background:#fbf6ec;padding:22px 24px;margin:32px 0;border-radius:14px;text-align:center;\">\n<p style=\"margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:1.25em;color:#08243c;font-weight:700;\">Vols passar diversos dies a Menorca?<\/p>\n<p style=\"margin:0 0 18px;color:#4d5f6d;\">Descobreix Ciutadella i la hist\u00f2ria de l&#8217;illa acompanyat per un guia oficial local.<\/p>\n<p style=\"margin:0;\">\n<a href=\"https:\/\/voyagermenorca.com\/ca\/excursions\/\" style=\"display:inline-block;background:#08243c;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Veure visites guiades<\/a><br \/>\n<a href=\"https:\/\/api.whatsapp.com\/send?phone=34649902301\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#1f7a4d;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Contactar per WhatsApp<\/a>\n<\/p>\n<\/div>\n<p style=\"font-size:0.9em;color:#666;\">Guia elaborada per <strong>Daniel Vaquera Sintes<\/strong>, guia oficial de turisme de Menorca (GT-0138-ME). <strong>\u00daltima actualitzaci\u00f3: 7 d&#8217;agost de 2026<\/strong>, amb les nou zones d&#8217;observaci\u00f3 oficial (ZOO) de Menorca, els horaris municipals de l&#8217;IGN i el dispositiu de mobilitat i accessos publicat pel Govern, el Consell Insular i els ajuntaments. Les mesures poden variar els dies previs segons l&#8217;aflu\u00e8ncia: consulta sempre la informaci\u00f3 oficial abans de despla\u00e7ar-te. <\/p>\n","protected":false},"excerpt":{"rendered":"<p>El 12 d&#8217;agost de 2026 Menorca viur\u00e0 el seu primer eclipsi solar total en m\u00e9s d&#8217;un segle. Horaris exactes, les 9 zones d&#8217;observaci\u00f3 oficial (ZOO), el mapa de la costa oest i com veure&#8217;l amb seguretat. <\/p>\n","protected":false},"author":2,"featured_media":2327,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[145,275,146,326],"tags":[329,328,327],"class_list":["post-2288","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-capvespres-a-menorca","category-destinacio-starlight","category-discover-menorca","category-eclipsi","tag-eclipsi-2026","tag-eclipsi-menorca","tag-starlight"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v28.3 (Yoast SEO v28.8) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Eclipsi solar total Menorca 2026: hora, mapa i on veure&#039;l<\/title>\n<meta name=\"description\" content=\"Horaris exactes, mapa interactiu i millors llocs per veure l&#039;eclips