us:8px; font-weight:700; margin-right:.4rem; }\n    .tagline { color:#2a2a2a; margin-top:.4rem; }\n\n    .tip, .local { background:#fff7e6; border:1px solid #f1dfb7; padding:.5rem .6rem; border-radius:8px; }\n    .local { background:#eef6ff; border-color:#cfe2ff; }\n\n    ul.clean { padding-left: 1.1rem; }\n    .grid { display:grid; gap: 12px; grid-template-columns: 1fr; }\n    @media (min-width: 720px){ .grid.two { grid-template-columns: 1fr 1fr; } }\n\n    .footer { color:#666; margin:1.4rem 0 0; }\n    blockquote { margin: .7rem 0; padding: .5rem .65rem; background:#f9fafb; border-left: 4px solid #e5e7eb; border-radius:6px; }\n    .anchor { scroll-margin-top: 80px; }\n  <\/style>\n\n  \n  <script data-jetpack-boost=\"ignore\" type=\"application\/ld+json\">\n  {\"@context\":\"https:\/\/schema.org\",\"@graph\":[\n    {\"@type\":\"Article\",\"headline\":\"Ciutadella con ojos de gu\u00eda: historia, ruta a pie, mercados y sabores locales\",\n     \"author\":{\"@type\":\"Person\",\"name\":\"Daniel Vaquera\"},\n     \"datePublished\":\"2025-10-04\",\n     \"image\":[\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Plaza%20D%27es%20Born%20-%20panoramio.jpg?width=1200\"],\n     \"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https:\/\/voyagermenorca.com\/blog\/ciutadella-ruta-historia-mercados-restaurantes\/\"}},\n    {\"@type\":\"FAQPage\",\"mainEntity\":[\n      {\"@type\":\"Question\",\"name\":\"\u00bfCu\u00e1nto dura la ruta a pie por Ciutadella?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Aproximadamente 2 horas a ritmo tranquilo, con paradas para fotos y an\u00e9cdotas.\"}},\n      {\"@type\":\"Question\",\"name\":\"\u00bfEn qu\u00e9 idiomas se ofrece la visita?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Espa\u00f1ol, ingl\u00e9s, franc\u00e9s, italiano y catal\u00e1n.\"}},\n      {\"@type\":\"Question\",\"name\":\"\u00bfD\u00f3nde empieza la visita?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"En la Plaza de las Palmeras. Tras reservar te env\u00edo la ubicaci\u00f3n exacta.\"}}]}\n  ]}\n  <\/script>\n\n\n  <article class=\"wrap\">\n    <header>\n      <h1>Ciutadella \u00e0 travers les yeux d'un guide : histoire, itin\u00e9raire \u00e0 pied, march\u00e9s et saveurs locales<\/h1>\n      <p class=\"lead\">Ciutadella ne se parcourt pas : <em>elle se lit<\/em>. Il y a des chapitres en pierre \u2014 palais, temples \u2014, des paragraphes parfum\u00e9s de march\u00e9 et des notes de bas de page qui n'apparaissent que si l'on prend son temps. Ici, je vous raconte comment je la vis lors de mes visites : avec des histoires, de petites astuces et un itin\u00e9raire con\u00e7u pour savourer la ville sans se presser.  <\/p>\n\n      <div class=\"cta\">\n        <a class=\"whatsapp\" href=\"https:\/\/wa.me\/34649902301\" rel=\"noopener\" aria-label=\"Contactar por WhatsApp\">Contacter par WhatsApp<\/a>\n        <a class=\"button\" href=\"https:\/\/voyagermenorca.com\/fr\/visite-guidee-de-ciutadella\/\">R\u00e9server une visite guid\u00e9e<\/a>\n        <p class=\"tagline\">Langues : <strong>espagnol, anglais, fran\u00e7ais, italien et catalan<\/strong> \u00b7 Point de rencontre : <strong>Plaza de las Palmeras<\/strong><\/p>\n      <\/div>\n\n      <figure>\n        <img fetchpriority=\"high\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Plaza%20D%27es%20Born%20-%20panoramio.jpg?width=1600\" srcset=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Plaza%20D%27es%20Born%20-%20panoramio.jpg?width=800 800w, https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Plaza%20D%27es%20Born%20-%20panoramio.jpg?width=1200 1200w, https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Plaza%20D%27es%20Born%20-%20panoramio.jpg?width=1600 1600w\" sizes=\"(max-width: 768px) 100vw, 960px\" width=\"1600\" height=\"1000\" loading=\"eager\" decoding=\"async\" alt=\"Pla\u00e7a des Born avec ob\u00e9lisque et fa\u00e7ades seigneuriales\">\n        <figcaption>Pla\u00e7a des Born. Photo : Panoramio\/Wikimedia Commons (CC BY-SA 3.0). <\/figcaption>\n      <\/figure>\n    <\/header>\n\n    <section class=\"toc\">\n      <strong>Contenu<\/strong>\n      <ul class=\"clean\">\n        <li><a href=\"#ruta\">Itin\u00e9raire \u00e0 pied (15 arr\u00eats avec histoire et astuces)<\/a><\/li>\n        <li><a href=\"#mercados\">March\u00e9s et artisanat<\/a><\/li>\n        <li><a href=\"#comer\">O\u00f9 manger (classiques locaux et nouveaut\u00e9s)<\/a><\/li>\n        <li><a href=\"#fiestas\">Festes de Sant Joan (et comment se pr\u00e9parer)<\/a><\/li>\n        <li><a href=\"#faqs\">Foire aux questions<\/a><\/li>\n      <\/ul>\n    <\/section>\n\n    \n    <section id=\"ruta\" class=\"anchor\">\n      <h2>Itin\u00e9raire \u00e0 pied dans Ciutadella (2 h environ) \u2014 15 arr\u00eats avec \u00e2me<\/h2>\n\n      <h3 id=\"born\">1) Pla\u00e7a des Born \u00b7 la porte d'entr\u00e9e de la ville<\/h3>\n      <p>Un salon urbain \u00e0 vocation de sc\u00e8ne. L'ob\u00e9lisque rappelle 1558 ; autour, des palais qui murmurent d'anciens noms de famille. Ici, je marque la \u00ab carte mentale \u00bb pour nous orienter : la vieille ville, le port et le rythme de la visite.  <\/p>\n      <div class=\"tip\">Astuce locale : revenez au cr\u00e9puscule \u2014 la lumi\u00e8re descendante et la pierre dor\u00e9e font de la magie pour les photos.<\/div>\n\n      <h3 id=\"voltes\">2) Mirador de Ses Voltes<\/h3>\n      <p>Penchez-vous sur les arcades : un couloir ombrag\u00e9, des boutiques et des conversations de toujours. L'\u00e9cho des pas fait partie du caract\u00e8re de Ciutadella. <\/p>\n\n      <h3 id=\"catedral\">3) Cath\u00e9drale de Minorque (Santa Maria)<\/h3>\n      <p>Gothique sobre \u00e0 l'ext\u00e9rieur, recueillement \u00e0 l'int\u00e9rieur. Nous entrons si les horaires le permettent ; sinon, je vous raconte pourquoi le temple explique tant de choses sur l'ancienne capitale eccl\u00e9siastique. <\/p>\n\n      <figure>\n        <img loading=\"lazy\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Exterior%20Catedral%20Ciutadela%20de%20Menorca.JPG?width=1400\" width=\"1400\" height=\"933\" loading=\"lazy\" decoding=\"async\" alt=\"Cath\u00e9drale de Minorque, fa\u00e7ade gothique \u00e0 Ciutadella\">\n        <figcaption>Cath\u00e9drale de Minorque. Photo : Wikimedia Commons (CC BY-SA 3.0 ES). <\/figcaption>\n      <\/figure>\n\n      <h3 id=\"torre-saura\">4) Palau de Torre-Saura<\/h3>\n      <p>Une le\u00e7on en pierre de ce qu'\u00e9tait la noblesse minorquine. Observez la ferronnerie et les proportions : \u00e9l\u00e9gance sans cris. <\/p>\n\n      <figure>\n        <img loading=\"lazy\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Palau%20de%20Torre-Saura.jpg?width=1400\" width=\"1400\" height=\"933\" loading=\"lazy\" decoding=\"async\" alt=\"Palau de Torre-Saura, fa\u00e7ade seigneuriale \u00e0 Ciutadella\">\n        <figcaption>Palau de Torre-Saura. Photo : Josep Renalias (Lohen11) \/ Wikimedia Commons (CC BY-SA). <\/figcaption>\n      <\/figure>\n\n      <h3 id=\"salort\">5) Palau Salort et environnement noble<\/h3>\n      <p>Portails, blasons et patios qui racontent des lign\u00e9es. Pendant les f\u00eates de Sant Joan, cet espace vibre diff\u00e9remment ; la ville a une m\u00e9moire \u00e9questre. <\/p>\n\n      <h3 id=\"carme\">6) Claustre del Carme<\/h3>\n      <p>Un clo\u00eetre qui offre ombre et calme \u00e0 une minute de l'agitation. Id\u00e9al pour une pause caf\u00e9. <\/p>\n\n      <h3 id=\"mercats\">7) Mercat Municipal et Mercat des Peix<\/h3>\n      <p>Le pouls quotidien : fruits de saison, poisson fra\u00eechement p\u00each\u00e9 et bars o\u00f9 comprendre le \u00ab tapeo \u00bb \u00e0 la minorquine. S'il y a de la musique ou un march\u00e9, laissez-vous gagner par l'ambiance. <\/p>\n\n      <figure>\n        <img loading=\"lazy\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Mercat%20Municipal%20de%20Ciutadella%20de%20Menorca.jpg?width=1400\" width=\"1400\" height=\"900\" loading=\"lazy\" decoding=\"async\" alt=\"March\u00e9 municipal de Ciutadella sur la Pla\u00e7a de la Llibertat\">\n        <figcaption>Mercat Municipal (Pla\u00e7a de la Llibertat). Photo : Wikimedia Commons (CC0). <\/figcaption>\n      <\/figure>\n\n      <h3 id=\"majorborn\">8) Carrer Major d\u2019es Born (Ses Voltes)<\/h3>\n      <p>Arcades, artisans, fours : une bande sonore de pas sur la pierre. Cherchez les d\u00e9tails dans les sculptures et les chapiteaux. <\/p>\n\n      <h3 id=\"placanova\">9) Pla\u00e7a Nova et quartier des artisans<\/h3>\n      <p>Petites boutiques, ateliers et caf\u00e9s. Si vous voyagez avec des enfants, c'est le bon moment pour partager une ensaimada. <\/p>\n\n      <h3 id=\"port\">10) Descente vers le vieux port<\/h3>\n      <p>Soudain, tout est amphith\u00e9\u00e2tre : maisons en terrasse, quais et un canal qui sent le sel. Ici, la ville s'assoit pour regarder la mer. <\/p>\n\n      <figure>\n        <img loading=\"lazy\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Port%20de%20Ciutadella.JPG?width=1600\" width=\"1600\" height=\"1000\" loading=\"lazy\" decoding=\"async\" alt=\"Vieux port de Ciutadella avec maisons en terrasses\">\n        <figcaption>Port de Ciutadella. Photo : Peer \/ Wikimedia Commons (CC BY-SA). <\/figcaption>\n      <\/figure>\n\n      <h3 id=\"moll\">11) Moll de ponent : vieilles maisons et bateaux<\/h3>\n      <p>Une promenade le long des bateaux de travail. Si vous surprenez les anciens en train de bavarder, vous entendrez l'heure de la mer mieux que dans le bulletin. <\/p>\n\n      <h3 id=\"miradors\">12) Points de vue sur le canal<\/h3>\n      <p>Arr\u00eat photo incontournable. Attention aux reflets au cr\u00e9puscule. <\/p>\n\n      <h3 id=\"muralla\">13) Anciennes portes de la muraille<\/h3>\n      <p>Topographie de la ville fortifi\u00e9e : imaginer les portes, c'est comprendre le mouvement des gens et des marchandises.<\/p>\n\n      <h3 id=\"llibertat\">14) Plaza de la Llibertat (tapas et pause)<\/h3>\n      <p>Arcades et bars aux saveurs locales. S'il y a un march\u00e9 de produits \u2014 ou d'artisanat en \u00e9t\u00e9 \u2014, prolongez la pause. <\/p>\n\n      <h3 id=\"regreso\">15) Retour au Born<\/h3>\n      <p>La ville nous ram\u00e8ne \u00e0 la sc\u00e8ne principale pour clore l'itin\u00e9raire. Si le ciel le permet, restez pour voir comment les fa\u00e7ades se dorent. <\/p>\n\n      <blockquote class=\"local\">\n        <strong>Jeu de d\u00e9tails cach\u00e9s :<\/strong> cherchez une \u00ab t\u00eate \u00bb sculpt\u00e9e dans la pierre, une plaque avec une toponymie double (catalan\/castillan) et un fer \u00e0 cheval sur une porte. Si vous trouvez les trois, la ville vous fait un clin d'\u0153il. \n      <\/blockquote>\n    <\/section>\n\n    \n    <section id=\"mercados\" class=\"anchor\">\n      <h2>March\u00e9s et artisanat : la ville qui prend son petit-d\u00e9jeuner sur la place<\/h2>\n      <p>La <strong>Pla\u00e7a de la Llibertat<\/strong> est un rituel : caf\u00e9 sous les arcades, achat rapide et bavardage. Plusieurs matins par semaine \u2014 avec une joie particuli\u00e8re <strong>les mardis, vendredis et samedis<\/strong> \u2014 il y a de l'animation ; en \u00e9t\u00e9, il y a souvent des <strong>march\u00e9s artisanaux en soir\u00e9e<\/strong> dans le centre. Les horaires changent selon la saison : v\u00e9rifiez le programme municipal ou demandez-moi et nous ajusterons la visite.  <\/p>\n    <\/section>\n\n    \n    <section id=\"comer\" class=\"anchor\">\n      <h2>O\u00f9 manger : classiques marins, march\u00e9 et cuisine d'auteur<\/h2>\n      <div class=\"grid two\">\n        <div>\n          <h3>Mer et tradition<\/h3>\n          <p>Dans le vieux port, vous trouverez des temples du poisson et de la caldereta. R\u00e9servez \u00e0 l'avance en haute saison et renseignez-vous sur le produit du jour. <\/p>\n        <\/div>\n        <div>\n          <h3>March\u00e9 \u00e0 manger<\/h3>\n          <p>\u00c0 la Llibertat et dans les environs, il y a des bars qui servent des planches du mercat : rapide, local et savoureux. Id\u00e9al pour \u00ab grignoter \u00bb pendant le parcours. <\/p>\n        <\/div>\n        <div>\n          <h3>Tapas avec identit\u00e9<\/h3>\n          <p>Cherchez des bars o\u00f9 la carte parle minorquin : fromage Mah\u00f3n-Menorca, sobrasada, \u00ab olives trencades \u00bb, poissons \u00e0 la minorquine.<\/p>\n        <\/div>\n        <div>\n          <h3>Cuisine d'auteur<\/h3>\n          <p>Si vous avez envie d'une touche contemporaine, r\u00e9servez une table dans les propositions cr\u00e9atives de la vieille ville : produit local, technique et cave soign\u00e9e.<\/p>\n        <\/div>\n      <\/div>\n      <p class=\"small\">Remarque : confirmez les horaires et le jour de fermeture hebdomadaire (ils changent selon la saison). Si vous m'\u00e9crivez, je vous propose des tables en fonction de votre itin\u00e9raire et de vos pr\u00e9f\u00e9rences. <\/p>\n    <\/section>\n\n    \n    <section id=\"fiestas\" class=\"anchor\">\n      <h2>Festes de Sant Joan : la ville qui chevauche<\/h2>\n      <p>Elles commencent avec le <em>Diumenge des Be<\/em> et culminent les 23 et 24 juin. Le <g id=\"gid_1\">Caragol des Born<\/g> transforme la place en un battement de c\u0153ur collectif et les <g id=\"gid_2\">jocs<\/g> du 24 maintiennent vivante la tradition \u00e9questre. C'est une f\u00eate passionnante et exigeante : r\u00e9servez \u00e0 l'avance, hydratez-vous et suivez les indications locales.  <\/p>\n\n      <figure>\n        <img loading=\"lazy\" src=\"https:\/\/commons.wikimedia.org\/wiki\/Special:FilePath\/Sant%20Joan%201.jpg?width=1600\" width=\"1600\" height=\"1000\" loading=\"lazy\" decoding=\"async\" alt=\"Cavalier et cheval pendant les Festes de Sant Joan \u00e0 Ciutadella\">\n        <figcaption>Festes de Sant Joan. Photo : Wikimedia Commons (CC BY-SA 4.0). <\/figcaption>\n      <\/figure>\n    <\/section>\n\n    \n    <section class=\"cta\">\n      <h2>Tu viens te promener ?<\/h2>\n      <p>Je vous accompagne dans une <a href=\"https:\/\/voyagermenorca.com\/fr\/visite-guidee-de-ciutadella\/\">visite guid\u00e9e de Ciutadella<\/a> con\u00e7ue pour comprendre la ville et en profiter sans se presser.<\/p>\n      <ul class=\"clean\">\n        <li><a href=\"https:\/\/voyagermenorca.com\/fr\/visite-guidee-de-ciutadella\/\">R\u00e9servez : Visite guid\u00e9e de Ciutadella (2 h)<\/a><\/li>\n        <li><a href=\"https:\/\/voyagermenorca.com\/fr\/visita-guiada-privada-de-mahon\/\">Explorez aussi Mah\u00f3n\/Ma\u00f3<\/a><\/li>\n        <li><a href=\"https:\/\/voyagermenorca.com\/fr\/excursions\/\">Plus d'excursions \u00e0 Minorque<\/a><\/li>\n      <\/ul>\n      <p>Des doutes de derni\u00e8re minute ? Parlez-moi sur <a class=\"whatsapp\" href=\"https:\/\/wa.me\/34649902301\" rel=\"noopener\">WhatsApp<\/a>. <\/p>\n    <\/section>\n\n    \n    <section id=\"faqs\" class=\"anchor\">\n      <h2>Foire aux questions<\/h2>\n      <details>\n        <summary>O\u00f9 commence la visite ?<\/summary>\n        <p>Sur la <strong>Plaza de las Palmeras<\/strong>. Apr\u00e8s la r\u00e9servation, je vous envoie l&#8217;emplacement exact. <\/p>\n      <\/details>\n      <details>\n        <summary>Combien de kilom\u00e8tres marche-t-on et comment est le terrain ?<\/summary>\n        <p>Environ 2\u20132,5 km au total, dans des rues majoritairement plates en pierre. Nous faisons des arr\u00eats fr\u00e9quents. <\/p>\n      <\/details>\n      <details>\n        <summary>En quelles langues est-elle propos\u00e9e ?<\/summary>\n        <p>Espagnol, anglais, fran\u00e7ais, italien et catalan.<\/p>\n      <\/details>\n      <details>\n        <summary>Puis-je prendre des photos \u00e0 l'int\u00e9rieur des temples ?<\/summary>\n        <p>Cela d\u00e9pend du lieu et du moment. Je vous explique les r\u00e8gles \u00e0 chaque arr\u00eat pour respecter les espaces. <\/p>\n      <\/details>\n      <details>\n        <summary>Est-ce annul\u00e9 s'il pleut ?<\/summary>\n        <p>Pas n\u00e9cessairement ; nous adaptons l'itin\u00e9raire et le rythme. Si le temps n'est vraiment pas favorable, nous cherchons une alternative. <\/p>\n      <\/details>\n      <details>\n        <summary>Y a-t-il des march\u00e9s tous les jours ?<\/summary>\n        <p>Non. Cela varie selon la saison. Pour vous orienter, il y a plus d'animation <strong>les mardis, vendredis et samedis<\/strong> ; en \u00e9t\u00e9, il y a souvent de l'artisanat l'apr\u00e8s-midi.  <\/p>\n      <\/details>\n      <details>\n        <summary>Puis-je payer en esp\u00e8ces ou par Bizum ?<\/summary>\n        <p>Oui. Et si vous pr\u00e9f\u00e9rez r\u00e9server en ligne, je vous envoie un lien de paiement s\u00e9curis\u00e9. <\/p>\n      <\/details>\n    <\/section>\n\n    <p class=\"footer\">Publi\u00e9 par Daniel Vaquera \u00b7 <time datetime=\"2025-10-04\">4 octobre 2025<\/time><\/p>\n  <\/article>\n\n\n<\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>D\u00e9couvre Ciutadella \u00e0 pied avec un guide local : palais, cath\u00e9drale, march\u00e9s et port lors d'un parcours de 2 heures avec anecdotes et astuces. Point de rencontre : Plaza de las Palmeras. Langues : espagnol, anglais, fran\u00e7ais, italien et catalan. R\u00e9serve via WhatsApp ou sur le site web.   <\/p>\n","protected":false},"author":2,"featured_media":0,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[191,64],"tags":[192,198,196,193,195,194,197],"class_list":["post-1327","post","type-post","status-publish","format-standard","hentry","category-ciutadella","category-decouvrez-minorque","tag-ciutadella","tag-guide-minorque","tag-que-voir-a-minorque","tag-tour-minorque","tag-visite-guidee-citadelle","tag-visite-guidee-ciutadella","tag-voyager-a-minorque"],"yoast_head":"<!-- This site is optimized with the Yoast SEO P