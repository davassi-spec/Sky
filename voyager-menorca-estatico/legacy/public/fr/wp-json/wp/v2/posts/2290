hArray:\"8 6\"}).addTo(map);var ai=L.divIcon({className:\"\",html:DV+' class=\"sunset-arrow\" style=\"transform:rotate('+(B-90)+'deg)\">\u27a4'+DVC,iconSize:[28,28],iconAnchor:[14,14]});L.marker(e,{icon:ai,interactive:false}).addTo(map);bounds.push(e);}});regs.forEach(function(r){var ri=L.divIcon({className:\"\",html:DV+' class=\"reg-marker-ecl\">!'+DVC,iconSize:[34,34],iconAnchor:[17,17],popupAnchor:[0,-19]});L.marker([r.lat,r.lng],{icon:ri,title:r.name+\" (acceso regulado)\"}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#8a3d09;margin-bottom:5px;\">'+r.name+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+r.det+DVC);bounds.push([r.lat,r.lng]);});map.fitBounds(bounds,{padding:[32,32],maxZoom:12});L.control.scale({imperial:false,position:\"bottomleft\"}).addTo(map);var lg=L.control({position:\"topright\"});lg.onAdd=function(){var d=L.DomUtil.create(\"div\",\"eclipse-map-legend\");d.innerHTML='<strong>Leyenda<\/strong><span class=\"legend-zoo\">ZOO<\/span>Zona de observaci\u00f3n oficial<br \/><span class=\"legend-reg\">!<\/span>Acceso regulado \/ zona de riesgo<br \/><span class=\"legend-arrow\">\u27a4<\/span>Ocaso 288\u00b0 \u00b7 oeste-noroeste';return d;};lg.addTo(map);map.on(\"click\",function(){map.scrollWheelZoom.enable();});map.on(\"mouseout\",function(){map.scrollWheelZoom.disable();});}function ensureLeaflet(cb){if(window.L&&window.L.map){cb();return;}if(!document.querySelector('link[href*=\"'+LF+'\"]')){var l=document.createElement(\"link\");l.rel=\"stylesheet\";l.href=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".css\";document.head.appendChild(l);}var ex=document.querySelector('script[src*=\"'+LF+'\"]');if(ex){if(window.L&&window.L.map){cb();}else{ex.addEventListener(\"load\",cb);}}else{var js=document.createElement(\"script\");js.src=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".js\";js.onload=cb;document.head.appendChild(js);}}if(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",function(){ensureLeaflet(initEclipseMap);});}else{ensureLeaflet(initEclipseMap);}})();<\/script><\/div>\n<h2 id=\"zoo\">Les 9 zones d'observation officielles (ZOO) de Minorque<\/h2>\n<div style=\"border-left:4px solid #08243c;background:#eef4f9;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>Actualisation d'ao\u00fbt 2026.<\/strong> Le Govern de les Illes Balears a am\u00e9nag\u00e9 <strong>26 zones d'observation officielles (ZOO)<\/strong> dans l'ensemble des Bal\u00e9ares, <strong>dont neuf \u00e0 Minorque<\/strong>. Elles ont \u00e9t\u00e9 choisies parmi plus d'une centaine d&#8217;emplacements possibles en \u00e9valuant la visibilit\u00e9, l'accessibilit\u00e9, la capacit\u00e9 d'accueil, le stationnement et la possibilit\u00e9 d'intervention des services d'urgence. Le Govern lui-m\u00eame le dit clairement : <strong>ce ne sont pas n\u00e9cessairement les endroits d'o\u00f9 l'\u00e9clipse se verra le mieux<\/strong>, mais ceux o\u00f9 il peut mieux garantir la s\u00e9curit\u00e9 des personnes.  <\/p>\n<\/div>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Zone d'observation officielle<\/th>\n<th>Commune<\/th>\n<th>D\u00e9tail<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td><strong>Cala en Bosc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Depuis le parking de la promenade maritime jusqu'au phare de Cap d'Artrutx<\/td>\n<\/tr>\n<tr>\n<td><strong>Cala Blanca<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Du Clot de sa Cera au restaurant Es Mirador<\/td>\n<\/tr>\n<tr>\n<td><strong>Avinguda Los Delfines<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Urbanisation de Cala en Blanes \/ Los Delfines, c\u00f4te nord-ouest<\/td>\n<\/tr>\n<tr>\n<td><strong>Son Blanc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Bande littorale au sud du port, pr\u00e8s de Son Oleo<\/td>\n<\/tr>\n<tr>\n<td><strong>Carrer des Tamarells<\/strong><\/td>\n<td>Es Mercadal<\/td>\n<td>Platges de Fornells, c\u00f4te nord<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Son Bou<\/strong><\/td>\n<td>Alaior<\/td>\n<td>Acc\u00e8s recommand\u00e9 par Torre Sol\u00ed, avec bus navette<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Sant Tom\u00e0s<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>C\u00f4te sud<\/td>\n<\/tr>\n<tr>\n<td><strong>Talis<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>C\u00f4te sud, pr\u00e8s de Sant Tom\u00e0s<\/td>\n<\/tr>\n<tr>\n<td><strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong><\/td>\n<td>Ma\u00f3<\/td>\n<td>Fermeture possible \u00e0 la circulation \u00e0 partir de 19h00<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<p><strong>Comment je le lis, en tant que guide local.<\/strong> Les ZOO r\u00e9solvent la s\u00e9curit\u00e9 et le stationnement, pas la visibilit\u00e9. Avec le Soleil \u00e0 environ 2\u00b0 de hauteur et un azimut de 288\u00b0 (ouest-nord-ouest), les quatre zones de Ciutadella \u2014 <strong>Cala en Bosc, Cala Blanca, Son Blanc et Avinguda Los Delfines<\/strong> \u2014 sont celles qui combinent le mieux le dispositif officiel avec un horizon marin d\u00e9gag\u00e9 dans la bonne direction. Dans les zones de la c\u00f4te sud (Son Bou, Sant Tom\u00e0s, Talis) et sur le Passeig Mar\u00edtim de Ma\u00f3, la ligne du couchant est plus rasante par rapport \u00e0 la c\u00f4te elle-m\u00eame ou au centre urbain : elles sont parfaitement valables et s\u00fbres, mais il convient de <strong>v\u00e9rifier le profil r\u00e9el de l'horizon avec l'app Horitz\u00f3 Eclipsi 2026<\/strong> depuis le point pr\u00e9cis o\u00f9 tu penses te placer.  <\/p>\n<p>Et une recommandation qui vaut plus que n'importe quelle liste : si tu peux le voir depuis ton propre h\u00e9bergement ou depuis une zone o\u00f9 tu arrives \u00e0 pied, et que tu as un horizon ouest, fais-le. C'est la fa\u00e7on la plus s\u00fbre d'\u00e9viter les d\u00e9placements, les embouteillages et les surprises de derni\u00e8re minute. <\/p>\n<h2 id=\"donde\">Les meilleurs endroits pour voir l'\u00e9clipse \u00e0 Minorque<\/h2>\n<p>Comme le Soleil sera presque en train de toucher l'horizon, la cl\u00e9 n'est pas la hauteur mais <strong>un horizon ouest compl\u00e8tement ouvert et sans obstacles<\/strong> : sans montagnes, b\u00e2timents, bosquets ni nuages bas. Tous les points recommand\u00e9s sont dans la moiti\u00e9 occidentale de l'\u00eele. Je les regroupe par type pour que tu choisisses selon ton plan, mais tiens compte du <a href=\"#afluencia\">dispositif officiel d'acc\u00e8s<\/a> : plusieurs d'entre eux sont r\u00e9gul\u00e9s le 12 ao\u00fbt.  <\/p>\n<h3>Meilleures plages et criques pour l'observer<\/h3>\n<ul>\n<li><strong>Cala en Bosc (zone d\u2019observation officielle) :<\/strong> c\u00f4te ouverte sur le couchant, avec promenade au bord de la mer, bars et toilettes \u00e0 port\u00e9e de main. La ZOO s\u2019\u00e9tend depuis le parking de la promenade maritime jusqu\u2019au phare de Cap d\u2019Artrutx. Le parking est grand mais se remplira tr\u00e8s t\u00f4t ce jour-l\u00e0, et \u00e0 cette heure il ne reste presque plus d\u2019ombre. La circulation sera ferm\u00e9e \u00e0 partir de 17h00, ou plus t\u00f4t si l\u2019affluence l\u2019exige.   <\/li>\n<li><strong>Cala Blanca (zone d'observation officielle) :<\/strong> un peu moins fr\u00e9quent\u00e9e, avec un horizon ouvert \u00e0 l'ouest depuis les rochers lat\u00e9raux de la crique et des restaurants dans l'urbanisation elle-m\u00eame. La ZOO va du Clot de sa Cera au restaurant Es Mirador. On se gare dans la rue ; il convient d'arriver avec de la marge et de marcher les derniers m\u00e8tres.  <\/li>\n<li><strong>Cala Santandria :<\/strong> anse abrit\u00e9e du vent \u00e0 quelques minutes de Ciutadella, pratique pour les familles, avec des bars pr\u00e8s du sable. Ce n'est pas une zone officielle, donc il n'y aura pas de dispositif sp\u00e9cifique : le stationnement dans la rue est limit\u00e9 et plus t\u00f4t tu arrives, meilleure sera ta place. <\/li>\n<li><strong>Son Xoriguer et la zone de Cap d'Artrutx :<\/strong> l'extr\u00e9mit\u00e9 sud-ouest de l'\u00eele, avec le phare d'Artrutx comme r\u00e9f\u00e9rence, une promenade plate orient\u00e9e de plein fouet vers le coucher du soleil et les services de Cala en Bosc \u00e0 une courte distance de marche. Il y a souvent une brise marine : agr\u00e9able en ao\u00fbt, mais fixe bien ton tr\u00e9pied. <\/li>\n<\/ul>\n<h3>Meilleurs phares<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (acc\u00e8s r\u00e9gul\u00e9 le 12 ao\u00fbt) :<\/strong> offre un excellent horizon vers l'ouest, mais le dispositif officiel <strong>ferme le parking d\u00e8s 8h00<\/strong> et r\u00e9gule l'acc\u00e8s par la route CF-5. Ciutadella le consid\u00e8re en outre comme <strong>zone \u00e0 risque<\/strong>, avec Cala Morell et le Pont d'en Gil, avec contr\u00f4le de la Police locale. Ne compte pas pouvoir y arriver en voiture ce jour-l\u00e0. En dehors du 12 ao\u00fbt, \u00e7a reste une merveille : c'est en plein <a href=\"https:\/\/voyagermenorca.com\/fr\/guia-turistico-cami-de-cavalls\/\">Cam\u00ed de Cavalls<\/a> et c'est l'une des zones de plus grande obscurit\u00e9 de l'\u00eele.   <\/li>\n<li><strong>Far d'Artrutx :<\/strong> au sommet sud-ouest, avec une orientation parfaite sur le couchant, un terrain plat et un parking relativement proche. Il se trouve dans la zone d'observation officielle de Cala en Bosc : des phares, le plus pratique et le seul avec un dispositif officiel. <\/li>\n<li><strong>Far de Cavalleria (acc\u00e8s r\u00e9gul\u00e9 le 12 ao\u00fbt) :<\/strong> ses falaises ouvertes \u00e0 l'ouest offrent un horizon d\u00e9gag\u00e9 et un environnement spectaculaire, mais le <strong>Cam\u00ed de Tramuntana jusqu'au phare (CF-3) sera r\u00e9gul\u00e9<\/strong> ce jour-l\u00e0, tout comme le Cam\u00ed de Tramuntana lui-m\u00eame au rond-point d'intersection Me-15 \/ Me-7. L'alternative officielle dans cette zone de l'\u00eele est le Carrer des Tamarells, \u00e0 Platges de Fornells. <\/li>\n<\/ul>\n<p>Tu peux en savoir plus dans notre <a href=\"https:\/\/voyagermenorca.com\/fr\/guia-faros-menorca\/\">guide des 7 phares de Minorque<\/a>.<\/p>\n<h3>Meilleures falaises et points de vue<\/h3>\n<ul>\n<li><strong>Falaises de Punta Nati et de la c\u00f4te nord de Ciutadella :<\/strong> hauteur et un horizon marin de 180\u00b0, mais affect\u00e9es par le m\u00eame dispositif d'acc\u00e8s que le phare de Punta Nati.<\/li>\n<li><strong>Pont d'en Gil :<\/strong> l'arche naturelle de la c\u00f4te ouest, l'un des belv\u00e9d\u00e8res de coucher de soleil les plus c\u00e9l\u00e8bres de l'\u00eele, mais <strong>consid\u00e9r\u00e9 comme zone \u00e0 risque le 12 ao\u00fbt<\/strong>, avec contr\u00f4le policier. On y arrive \u00e0 pied depuis la zone de Cala en Blanes par un tron\u00e7on de c\u00f4te sans ombre ni services et avec une falaise ouverte : ce n'est pas l'endroit pour une nuit de forte affluence. Alternative officielle tr\u00e8s proche : l'<strong>Avinguda Los Delfines<\/strong>.  <\/li>\n<li><strong>Passeig Mar\u00edtim de Ciutadella :<\/strong> plat, pav\u00e9 et accessible, avec une vue d\u00e9gag\u00e9e sur la mer, le port et le centre historique en arri\u00e8re-plan, et des bars et services \u00e0 deux pas. Il ne figure pas comme zone officielle, mais c'est l'un des endroits les plus fr\u00e9quent\u00e9s de l'\u00eele : r\u00e9serve ta place tr\u00e8s \u00e0 l'avance. La zone officielle la plus proche est Son Blanc. Voir notre guide des <a href=\"https:\/\/voyagermenorca.com\/fr\/coucher-soleil-minorque-9-points-vue\/\">9 belv\u00e9d\u00e8res pour le coucher de soleil \u00e0 Minorque<\/a>.   <\/li>\n<\/ul>\n<h3>Depuis la mer<\/h3>\n<p>Observer l'\u00e9clipse depuis la mer peut offrir un horizon d\u00e9gag\u00e9, mais n\u00e9cessite une planification professionnelle. Cela ne doit se faire qu'avec un capitaine exp\u00e9riment\u00e9 ou une entreprise autoris\u00e9e, en consultant pr\u00e9alablement les pr\u00e9visions maritimes, les avis de navigation et les restrictions qui peuvent \u00eatre \u00e9tablies. Le Consell Insular rappelle en outre de <strong>ne pas mouiller sur les prairies de posidonie<\/strong>, de maintenir une distance de s\u00e9curit\u00e9 entre les embarcations, d'\u00e9viter les man\u0153uvres \u00e0 risque et de planifier \u00e0 l'avance le retour au port, car on pr\u00e9voit une concentration tr\u00e8s \u00e9lev\u00e9e d&#8217;embarcations juste \u00e0 la fin de l'\u00e9clipse.  <\/p>\n<h3>Sites arch\u00e9ologiques<\/h3>\n<p>Le Consell Insular d\u00e9ploiera des surveillants au <strong>castell de Santa \u00c0gueda<\/strong> et \u00e0 <strong>Torre d'en Galm\u00e8s<\/strong> et dans d'autres sites de propri\u00e9t\u00e9 publique, pour organiser les acc\u00e8s et \u00e9viter qu'on ne monte sur les talaiots, tours et structures patrimoniales. Ce sont des monuments de plus de trois mille ans : on les regarde, on ne les escalade pas. <\/p>\n<h3>Tableau comparatif des points d'observation<\/h3>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Lieu<\/th>\n<th>Type<\/th>\n<th>Horizon ouest<\/th>\n<th>Affluence pr\u00e9vue<\/th>\n<th>Acc\u00e8s le 12 ao\u00fbt<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Cala en Bosc <em>(officielle)<\/em><\/td>\n<td>Plage<\/td>\n<td>Excellent<\/td>\n<td>\u00c9lev\u00e9e<\/td>\n<td>Facile, avec services ; circulation ferm\u00e9e d\u00e8s 17h00<\/td>\n<\/tr>\n<tr>\n<td>Cala Blanca <em>(officielle)<\/em><\/td>\n<td>Plage<\/td>\n<td>Excellent<\/td>\n<td>Moyenne-\u00e9lev\u00e9e<\/td>\n<td>Facile ; circulation ferm\u00e9e d\u00e8s 17h00<\/td>\n<\/tr>\n<tr>\n<td>Son Blanc <em>(officielle)<\/em><\/td>\n<td>Littoral urbain<\/td>\n<td>Tr\u00e8s bon<\/td>\n<td>\u00c9lev\u00e9e<\/td>\n<td>\u00c0 pied depuis Ciutadella ; circulation ferm\u00e9e d\u00e8s 17h00<\/td>\n<\/tr>\n<tr>\n<td>Avinguda Los Delfines <em>(officielle)<\/em><\/td>\n<td>Promenade urbaine<\/td>\n<td>Tr\u00e8s bon<\/td>\n<td>Moyenne-\u00e9lev\u00e9e<\/td>\n<td>Facile ; circulation ferm\u00e9e d\u00e8s 17h00<\/td>\n<\/tr>\n<tr>\n<td>Cap d'Artrutx \/ Far d'Artrutx<\/td>\n<td>Phare\/c\u00f4te<\/td>\n<td>Excellent<\/td>\n<td>Moyenne<\/td>\n<td>Dans la zone officielle de Cala en Bosc<\/td>\n<\/tr>\n<tr>\n<td>Passeig Mar\u00edtim de Ciutadella<\/td>\n<td>Promenade urbaine<\/td>\n<td>Tr\u00e8s bon<\/td>\n<td>Tr\u00e8s \u00e9lev\u00e9e<\/td>\n<td>Facile, \u00e0 pied depuis le centre ; sans dispositif officiel<\/td>\n<\/tr>\n<tr>\n<td>Cala Santandria<\/td>\n<td>Crique<\/td>\n<td>Bon<\/td>\n<td>Moyenne-\u00e9lev\u00e9e<\/td>\n<td>Facile, familial ; sans dispositif officiel<\/td>\n<\/tr>\n<tr>\n<td>Far de Punta Nati<\/td>\n<td>Phare\/falaise<\/td>\n<td>Excellent<\/td>\n<td>Zone \u00e0 risque<\/td>\n<td>Route CF-5 r\u00e9gul\u00e9e et parking ferm\u00e9 d\u00e8s 8h00<\/td>\n<\/tr>\n<tr>\n<td>Far de Cavalleria<\/td>\n<td>Phare\/falaise<\/td>\n<td>Bon<\/td>\n<td>\u00c9lev\u00e9e<\/td>\n<td>Acc\u00e8s CF-3 r\u00e9gul\u00e9<\/td>\n<\/tr>\n<tr>\n<td>Depuis la mer (c\u00f4te ouest)<\/td>\n<td>Embarcation<\/td>\n<td>Totale<\/td>\n<td>\u2014<\/td>\n<td>Uniquement avec un skipper exp\u00e9riment\u00e9 ou une entreprise autoris\u00e9e<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"orientacion\">Orientation du Soleil et horizon<\/h2>\n<p>Au moment du maximum, le Soleil se trouvera vers l'<strong>ouest-nord-ouest, avec un azimut d'environ 288\u00b0<\/strong>. Traduit en pratique : place-toi face \u00e0 la mer sur la c\u00f4te ouest et cherche le point par o\u00f9 le Soleil se couche. Une boussole (ou celle de l'app Horitz\u00f3 2026) te confirmera la direction exacte. V\u00e9rifie la veille, \u00e0 la m\u00eame heure, qu'il n'y a aucun obstacle (grue, m\u00e2t, promontoire) sur cette ligne. Le Govern a effectu\u00e9 un essai officiel de visibilit\u00e9 les 29 et 30 avril pr\u00e9cis\u00e9ment pour v\u00e9rifier ces points : si le Soleil \u00e9tait visible \u00e0 cette heure ces jours-l\u00e0, il le sera aussi le 12 ao\u00fbt.    <\/p>\n<h2 id=\"meteo\">M\u00e9t\u00e9orologie : probabilit\u00e9 de ciels d\u00e9gag\u00e9s<\/h2>\n<p>Ao\u00fbt est, climatologiquement, l'un des mois les plus stables et secs de Minorque, avec pr\u00e9dominance de ciels d\u00e9gag\u00e9s et faible probabilit\u00e9 de pr\u00e9cipitation. Cela joue en notre faveur. Mais une \u00e9clipse si basse sur l'horizon a un ennemi sp\u00e9cifique : <strong>les nuages bas sur la mer<\/strong>, qui peuvent se former m\u00eame si le reste du ciel est clair. Recommandations :   <\/p>\n<ul>\n<li>Consulte la pr\u00e9vision d'<strong>AEMET<\/strong> et les cartes de n\u00e9bulosit\u00e9 les 3-4 jours pr\u00e9c\u00e9dents, en pr\u00eatant attention \u00e0 la n\u00e9bulosit\u00e9 basse sur l'horizon marin.<\/li>\n<li>Aie toujours un <strong>plan B<\/strong> vers un autre point de la c\u00f4te ouest o\u00f9 tu peux te d\u00e9placer avec de la marge, en tenant compte des restrictions de circulation pr\u00e9vues.<\/li>\n<li>Rappelle-toi que les <strong>nuages hauts<\/strong> (cirrus) permettent encore de voir le ph\u00e9nom\u00e8ne ; les bas sont ceux qui le g\u00e2chent.<\/li>\n<li>Depuis la mer, il y a plus de marge pour \u00e9viter la n\u00e9bulosit\u00e9, mais seulement avec un skipper exp\u00e9riment\u00e9 ou une entreprise autoris\u00e9e (voir la section \u00ab Depuis la mer \u00bb).<\/li>\n<\/ul>\n<h2 id=\"luminica\">Pollution lumineuse et l'avantage Starlight de Minorque<\/h2>\n<p>Minorque est <strong>R\u00e9serve et Destination Touristique Starlight<\/strong> depuis 2019 (certification de la Fondation Starlight), et toute l'\u00eele fait partie d'une R\u00e9serve de la Biosph\u00e8re. Elle dispose d'un R\u00e8glement de Protection du Ciel Nocturne et de <strong>zones d'obscurit\u00e9 maximale<\/strong> \u2014 Punta Nati, Macarella-Son Saura, Cavalleria-Cala del Pilar, Monte Toro, s'Albufera des Grau, entre autres \u2014 avec une pollution lumineuse pratiquement inexistante. <\/p>\n<p>Pour l'\u00e9clipse elle-m\u00eame, avec le Soleil encore au-dessus de l'horizon, la pollution lumineuse n'est pas d\u00e9terminante. Mais elle devient d\u00e9cisive juste apr\u00e8s : si tu restes dans un point sombre de la c\u00f4te ouest apr\u00e8s le coucher du soleil, tu auras un ciel exceptionnel pour la deuxi\u00e8me partie de la nuit (voir Pers\u00e9ides, plus bas). Tiens compte que plusieurs de ces zones ont l'acc\u00e8s r\u00e9gul\u00e9 le 12 ao\u00fbt.  <\/p>\n<h2 id=\"afluencia\">Restrictions d'acc\u00e8s, affluence et mobilit\u00e9 : le dispositif officiel<\/h2>\n<p>On s'attend \u00e0 une affluence tr\u00e8s \u00e9lev\u00e9e de \u00ab chasseurs d'\u00e9clipses \u00bb et de visiteurs de toute l'Europe, en plein mois d'ao\u00fbt et avec l'\u00eele d\u00e9j\u00e0 en haute saison. Le Govern bal\u00e9are a activ\u00e9 le protocole <strong>ECLIPBAL<\/strong>, dans le cadre du Plan territorial de protection civile, et le dispositif de s\u00e9curit\u00e9, mobilit\u00e9 et protection foresti\u00e8re est d\u00e9j\u00e0 publi\u00e9, en coordination avec le Consell Insular et les mairies. Voici les points qui t'affectent le plus en tant que visiteur.  <\/p>\n<h3>Restrictions g\u00e9n\u00e9rales<\/h3>\n<ul>\n<li>Dans les <strong>quatre zones officielles d\u2019observation de Ciutadella<\/strong>, la circulation sera ferm\u00e9e <strong>\u00e0 partir de 17h00<\/strong>, ou plus t\u00f4t si l\u2019affluence l\u2019exige.<\/li>\n<li>Dans le <strong>reste de Minorque<\/strong>, les horaires et les restrictions d\u00e9pendent de chaque route et municipalit\u00e9. De mani\u00e8re g\u00e9n\u00e9rale, les restrictions sur les voies concern\u00e9es s\u2019appliqueront <strong>entre 15h00 et 21h00<\/strong>, m\u00eame si elles pourront \u00eatre avanc\u00e9es ou prolong\u00e9es pour des raisons de s\u00e9curit\u00e9. <\/li>\n<li>Les restrictions <strong>n'affectent pas<\/strong> les r\u00e9sidents, les services essentiels, les transports publics ni les d\u00e9placements d\u00fbment justifi\u00e9s.<\/li>\n<\/ul>\n<h3>Acc\u00e8s r\u00e9gul\u00e9s ou ferm\u00e9s \u00e0 Minorque<\/h3>\n<ul>\n<li><strong>Far de Punta Nati (CF-5) :<\/strong> acc\u00e8s r\u00e9gul\u00e9 et <strong>parking ferm\u00e9 d\u00e8s 8h00<\/strong>.<\/li>\n<li><strong>Cam\u00ed de Tramuntana :<\/strong> r\u00e9gulation au rond-point d'intersection Me-15 \/ Me-7.<\/li>\n<li><strong>Far de Cavalleria (CF-3) :<\/strong> Cam\u00ed de Tramuntana jusqu'au phare, r\u00e9gul\u00e9.<\/li>\n<li><strong>Monte Toro (Me-13) :<\/strong> route d'Es Mercadal au Toro, r\u00e9gul\u00e9e.<\/li>\n<li><strong>Ferreries :<\/strong> fermeture des chemins d'acc\u00e8s \u00e0 l'Enclusa et au Cam\u00ed de Tramuntana d'Ets Alocs, avec fermetures graduelles (d'abord partielle sur la Me-1, ensuite \u00e0 l'acc\u00e8s \u00e0 la propri\u00e9t\u00e9 de Binissu\u00e8s et, finalement, acc\u00e8s uniquement pour les r\u00e9sidents des propri\u00e9t\u00e9s du Cam\u00ed de Tramuntana et h\u00e9bergements touristiques).<\/li>\n<li><strong>Sant Llu\u00eds :<\/strong> Passeig de Cap d'en Font ferm\u00e9 aux deux intersections avec le carrer del Cal\u00f3 Blanc, et Passeig de la Mar (Binissaf\u00faller Roters) aux croisements avec Llevant et Tramuntana, <strong>entre 19h00 et 21h30<\/strong>.<\/li>\n<li><strong>Ma\u00f3 :<\/strong> fermeture possible du Passeig Mar\u00edtim d\u00e8s 19h00 et restrictions \u00e0 Binidal\u00ed d\u00e8s 18h30 ; contr\u00f4les \u00e0 Es Canutells, Es Grau et autres points d'affluence ; acc\u00e8s restreint \u00e0 Fav\u00e0ritx et fermeture des batteries pendant la journ\u00e9e.<\/li>\n<li><strong>Ciutadella :<\/strong> <strong>Cala Morell, le Far de Punta Nati et le Pont d'en Gil<\/strong> sont consid\u00e9r\u00e9s comme zones \u00e0 risque, avec contr\u00f4le de la Police locale.<\/li>\n<\/ul>\n<h3>\u00c9crans pour suivre l'\u00e9clipse sans te d\u00e9placer<\/h3>\n<p>Si vous pr\u00e9f\u00e9rez \u00e9viter les routes et les foules, plusieurs municipalit\u00e9s installeront des \u00e9crans : <strong>Ciutadella<\/strong>, sur la Pla\u00e7a des Born ; <strong>Alaior<\/strong>, sur Sa Pla\u00e7a ; et <strong>Ma\u00f3<\/strong>, aux Cinemes Ocimax et au port.<\/p>\n<h3>Parking et navette<\/h3>\n<p>Pour la zone de <strong>Son Bou<\/strong>, il est recommand\u00e9 d\u2019acc\u00e9der par <strong>Torre Sol\u00ed<\/strong>, o\u00f9 un parking sera am\u00e9nag\u00e9 \u00e0 Torre Sol\u00ed II avec une <strong>navette continue entre 17h00 et 00h30<\/strong>. C\u2019est probablement l\u2019option la plus confortable de toute l\u2019\u00eele si vous n\u2019\u00eates pas press\u00e9 et que vous voulez oublier la voiture. <\/p>\n<p><strong>Cons\u00e9quence pratique :<\/strong> ne d\u00e9pends pas d\u2019un seul acc\u00e8s et n\u2019improvise pas \u00e0 la derni\u00e8re minute. Les mesures seront mises \u00e0 jour les jours pr\u00e9c\u00e9dents en fonction de l\u2019affluence pr\u00e9vue, alors <strong>consulte <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">les informations officielles du Govern<\/a> le jour m\u00eame<\/strong>, et suis \u00e0 tout moment les indications des services d\u2019urgence. <\/p>\n<h2 id=\"como-llegar\">Comment s'y rendre, parking et transports en commun<\/h2>\n<h3>Comment se rendre sur la c\u00f4te ouest<\/h3>\n<p>La plupart des points recommand\u00e9s se trouvent dans la commune de Ciutadella, \u00e0 l'extr\u00e9mit\u00e9 ouest de l'\u00eele, \u00e0 environ 45 minutes en voiture de l'a\u00e9roport de Ma\u00f3 par la route g\u00e9n\u00e9rale Me-1. Depuis Ciutadella, les urbanisations du sud-ouest (Cala en Bosc, Cala Blanca, Cala Santandria) sont \u00e0 10-15 minutes.  Ce jour-l\u00e0, pr\u00e9voyez beaucoup plus de temps que d\u2019habitude.<\/p>\n<h3>Stationnement<\/h3>\n<ul>\n<li>\u00c0 Ciutadella, il y a un parking gratuit sur le paseo de Sant Nicolau et le front de mer, ainsi qu'une zone bleue dans le centre.<\/li>\n<li>Si tu vas en voiture vers l\u2019une des zones officielles de Ciutadella, <strong>arrive avant 17h00<\/strong>, car la circulation peut \u00eatre ferm\u00e9e encore plus t\u00f4t selon l\u2019affluence. Dans la mesure du possible, viens \u00e0 pied depuis ton h\u00e9bergement ou utilise les transports publics. <\/li>\n<li>Dans les sites naturels, l\u2019espace est limit\u00e9 et plusieurs acc\u00e8s sont r\u00e9glement\u00e9s : ne vous garez jamais en dehors des zones autoris\u00e9es et ne bloquez pas les chemins ou les acc\u00e8s d\u2019urgence.<\/li>\n<\/ul>\n<h3>Transports en commun<\/h3>\n<p>Minorque dispose de lignes de bus r\u00e9guli\u00e8res qui relient Ma\u00f3 et Ciutadella toute l\u2019ann\u00e9e, et en \u00e9t\u00e9 il y a des services depuis la gare de Ciutadella vers les criques du sud et du sud-ouest. Ce jour-l\u00e0, la demande sera plus importante que d\u2019habitude et il est possible que certaines lignes soient renforc\u00e9es ou r\u00e9organis\u00e9es : v\u00e9rifiez les horaires actualis\u00e9s aupr\u00e8s de l\u2019op\u00e9rateur. Prendre les transports en commun \u2014 ou utiliser la navette de Torre Sol\u00ed pour Son Bou \u2014 et marcher le dernier tron\u00e7on peut vous \u00e9viter le probl\u00e8me du stationnement.  <\/p>\n<h2 id=\"seguridad\">S\u00e9curit\u00e9 oculaire : le plus important de tout<\/h2>\n<p>On ne peut jamais regarder directement le Soleil sans protection adapt\u00e9e, <strong>sauf lorsque le disque solaire est enti\u00e8rement couvert par la Lune pendant la totalit\u00e9<\/strong>.<\/p>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-seguridad-eclipse-eso.jpg?w=800&#038;ssl=1\" alt=\"Infographie en espagnol sur comment observer une \u00e9clipse solaire avec s\u00e9curit\u00e9 oculaire\"><figcaption>Comment observer l'\u00e9clipse avec s\u00e9curit\u00e9 oculaire. Cr\u00e9dit : ESO \/ B. Tafreshi (twanight.org) \/ P. Hor\u00e1lek. <\/figcaption><\/figure>\n<ul>\n<li>Utilise toujours des <strong>lunettes d\u2019\u00e9clipse homologu\u00e9es<\/strong> (norme <strong>ISO 12312-2<\/strong>) chaque fois que tu regardes directement le Soleil pendant les phases partielles. Des lunettes de soleil normales, aussi sombres qu\u2019elles paraissent, ne prot\u00e8gent pas : elles laissent passer un rayonnement infrarouge et ultraviolet qui peut endommager la r\u00e9tine sans que tu t\u2019en rendes compte. Les radiographies, verres fum\u00e9s et filtres maison ne conviennent pas non plus.  <\/li>\n<li>Achetez les lunettes \u00e0 l'avance et aupr\u00e8s d'un fournisseur fiable : elles sont en rupture de stock dans les jours pr\u00e9c\u00e9dents. Le Govern a rappel\u00e9 au secteur commercial que seuls les produits conformes \u00e0 la norme internationale doivent \u00eatre vendus. <\/li>\n<li><strong>Enl\u00e8ve les lunettes uniquement lorsque le Soleil est enti\u00e8rement couvert et qu\u2019aucune partie brillante n\u2019est visible. Remets-les imm\u00e9diatement d\u00e8s que r\u00e9appara\u00eet le premier \u00e9clat de lumi\u00e8re. <\/strong> Les horaires sont seulement indicatifs : fie-toi \u00e0 ce que tu vois, pas \u00e0 la montre.<\/li>\n<li>Si vous utilisez un appareil photo, des jumelles ou un t\u00e9lescope, ils n\u00e9cessitent leur <strong>propre filtre solaire<\/strong> pendant la phase partielle ; regarder le Soleil \u00e0 travers une optique sans filtre est particuli\u00e8rement dangereux.<\/li>\n<li>Une m\u00e9thode alternative et totalement s\u00fbre est la <strong>projection indirecte<\/strong> : fais un petit trou dans un carton et projette l'image du Soleil sur une autre surface, sans jamais regarder directement.<\/li>\n<\/ul>\n<h2 id=\"equipo\">\u00c9quipement recommand\u00e9<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Indispensable<\/th>\n<th>Recommand\u00e9<\/th>\n<th>Pour la photographie<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Lunettes d'\u00e9clipse ISO 12312-2 (une par personne + rechange)<\/td>\n<td>Chaise pliante ou couverture<\/td>\n<td>Tr\u00e9pied stable<\/td>\n<\/tr>\n<tr>\n<td>Eau et quelque chose \u00e0 manger<\/td>\n<td>Casquette et protection solaire<\/td>\n<td>Filtre solaire pour l'objectif<\/td>\n<\/tr>\n<tr>\n<td>Montre\/portable \u00e0 l'heure locale<\/td>\n<td>Batterie externe<\/td>\n<td>T\u00e9l\u00e9objectif (200-500 mm id\u00e9al)<\/td>\n<\/tr>\n<tr>\n<td>Protection pour le portable si vous photographiez la phase partielle<\/td>\n<td>Lampe rouge (n'\u00e9blouit pas)<\/td>\n<td>D\u00e9clencheur \u00e0 distance ou retardateur<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"fotografia\">Photographie de l'\u00e9clipse<\/h2>\n<p>Photographier une \u00e9clipse avec le Soleil \u00e0 2\u00b0 au-dessus de la mer est difficile et magnifique \u00e0 la fois. Id\u00e9es pour que cela r\u00e9ussisse : <\/p>\n<ul>\n<li><strong>Phase partielle :<\/strong> filtre solaire obligatoire sur l'objectif. Sans lui, vous endommagerez le capteur (et votre vue si vous utilisez un viseur optique). <\/li>\n<li><strong>Totalit\u00e9 :<\/strong> lorsque le Soleil est enti\u00e8rement couvert, retire le filtre pour capter la couronne. Utilise des expositions vari\u00e9es (bracketing) car la plage de luminosit\u00e9 est \u00e9norme. Remets le filtre d\u00e8s que r\u00e9appara\u00eet le premier \u00e9clat.  <\/li>\n<li><strong>Avec un portable :<\/strong> filtre solaire devant l'objectif pendant la phase partielle ; pendant la totalit\u00e9, vous pouvez le retirer. Verrouillez la mise au point et l'exposition manuellement. <\/li>\n<li><strong>Composition :<\/strong> profitez du fait que le Soleil est tr\u00e8s bas pour inclure la mer, un phare ou une silhouette de c\u00f4te. C'est la grande valeur diff\u00e9rentielle de Minorque. <\/li>\n<li><strong>Conseil d\u2019or :<\/strong> consacre la majeure partie de ce peu plus d\u2019une minute \u00e0 <strong>regarder<\/strong>, pas \u00e0 l\u2019\u00e9cran. La couronne en direct ne tient dans aucune photo. <\/li>\n<\/ul>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" loading=\"lazy\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-ajustes-camara-eclipse-menorca-2026.jpg?w=800&#038;ssl=1\" alt=\"Infographie avec les r\u00e9glages rapides de l\u2019appareil photo pour photographier l\u2019\u00e9clipse solaire : filtre solaire, ISO, ouverture, vitesse et mise au point pour la phase partielle et la totalit\u00e9\"><figcaption>R\u00e9glages indicatifs de l\u2019appareil photo pour la phase partielle (avec filtre solaire obligatoire) et la totalit\u00e9. V\u00e9rifie l\u2019histogramme et adapte l\u2019exposition \u00e0 ton \u00e9quipement. <\/figcaption><\/figure>\n<h2 id=\"familias\">Conseils pour les familles, les enfants, les personnes \u00e2g\u00e9es et \u00e0 mobilit\u00e9 r\u00e9duite<\/h2>\n<h3>Pour les familles et les enfants<\/h3>\n<ul>\n<li>C'est une exp\u00e9rience \u00e9ducative magnifique : expliquez-leur au pr\u00e9alable comment fonctionne le syst\u00e8me Soleil-Terre-Lune avec une lampe de poche et deux balles.<\/li>\n<li><strong>Le Govern recommande que les enfants de moins de six ans n\u2019observent pas directement l\u2019\u00e9clipse.<\/strong> Pour eux, il est conseill\u00e9 d\u2019utiliser une projection indirecte, un \u00e9cran ou la retransmission t\u00e9l\u00e9vis\u00e9e.<\/li>\n<li>Les autres mineurs doivent \u00eatre <strong>constamment surveill\u00e9s par un adulte<\/strong>, avec leurs propres lunettes homologu\u00e9es pendant toute la phase partielle.<\/li>\n<li>Choisissez un endroit confortable avec des services \u00e0 proximit\u00e9 (Cala en Bosc, Cala Blanca, Son Bou avec navette) pour avoir des toilettes et de l\u2019ombre pendant la longue attente.<\/li>\n<li>Transformez l'apr\u00e8s-midi en pique-nique : cela rendra l'attente supportable et cr\u00e9era le souvenir.<\/li>\n<\/ul>\n<h3>Pour les personnes \u00e2g\u00e9es<\/h3>\n<ul>\n<li>Privil\u00e9giez les points avec un acc\u00e8s facile et peu de marche : Son Blanc, l\u2019Avinguda Los Delfines ou Cala Santandria.<\/li>\n<li>Chaise avec dossier, eau abondante et protection solaire ; l'attente peut durer plusieurs heures avec de la chaleur.<\/li>\n<li>\u00c9vitez les acc\u00e8s par route \u00e9troite et les tron\u00e7ons \u00e0 pied des phares, qui sont \u00e9galement r\u00e9glement\u00e9s ce jour-l\u00e0.<\/li>\n<li>Les \u00e9crans de la Pla\u00e7a des Born (Ciutadella), Sa Pla\u00e7a (Alaior) ou du port de Ma\u00f3 sont une alternative tr\u00e8s confortable.<\/li>\n<\/ul>\n<h3>Pour les personnes \u00e0 mobilit\u00e9 r\u00e9duite<\/h3>\n<ul>\n<li>Les zones officielles plates et pav\u00e9es de Ciutadella \u2014<strong>Son Blanc et l\u2019Avinguda Los Delfines<\/strong>\u2014 et le <strong>Passeig Mar\u00edtim de Ciutadella<\/strong> sont les meilleures options : sol plat, horizon ouest et services \u00e0 proximit\u00e9.<\/li>\n<li>Certaines plages de Ciutadella disposent de passerelles ; renseignez-vous sur celles qui maintiennent l'acc\u00e8s ce jour-l\u00e0.<\/li>\n<li>Arrivez bien avant 17h00 pour vous assurer une place de parking accessible \u00e0 proximit\u00e9, compte tenu du dispositif sp\u00e9cial de circulation.<\/li>\n<li>Consultez sur <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">le site officiel<\/a> si les zones d\u2019observation pr\u00e9voient des espaces r\u00e9serv\u00e9s.<\/li>\n<\/ul>\n<h2 id=\"errores\">Erreurs que commet la majorit\u00e9 des visiteurs<\/h2>\n<ul>\n<li><strong>Choisir l\u2019endroit pour le paysage et non pour l\u2019horizon ouest.<\/strong> Un belv\u00e9d\u00e8re magnifique orient\u00e9 \u00e0 l\u2019est ou masqu\u00e9 par une colline ne convient pas pour cette \u00e9clipse.<\/li>\n<li><strong>Tenir pour acquis qu\u2019une zone officielle est celle qui offre la meilleure vue.<\/strong> Les ZOO ont \u00e9t\u00e9 choisies pour leur s\u00e9curit\u00e9 et leur capacit\u00e9, pas pour leur visibilit\u00e9. V\u00e9rifiez votre point avec Horitz\u00f3 2026. <\/li>\n<li><strong>Arriver tard.<\/strong> Dans les zones officielles de Ciutadella, la circulation est ferm\u00e9e d\u00e8s 17h00 et certaines routes sont r\u00e9gul\u00e9es : ceux qui partent au dernier moment peuvent se retrouver \u00e0 l\u2019arr\u00eat pendant la totalit\u00e9.<\/li>\n<li><strong>Compter arriver en voiture \u00e0 Punta Nati ou Cavalleria.<\/strong> Les deux acc\u00e8s sont r\u00e9glement\u00e9s le 12 ao\u00fbt et le parking de Punta Nati ferme \u00e0 8h00.<\/li>\n<li><strong>Utiliser des lunettes de soleil ordinaires.<\/strong>  Elles ne prot\u00e8gent pas. Seules les lunettes homologu\u00e9es ISO 12312-2 conviennent. <\/li>\n<li><strong>Acheter les lunettes le jour m\u00eame.<\/strong> Elles sont en rupture de stock ; achetez-les \u00e0 l\u2019avance.<\/li>\n<li><strong>Ne pas v\u00e9rifier l\u2019horizon r\u00e9el.<\/strong> Un m\u00e2t, une grue ou un banc de nuages bas peuvent masquer 2\u00b0.<\/li>\n<li><strong>Regarder la totalit\u00e9 \u00e0 travers le mobile.<\/strong> Vivez-la avec vos yeux ; l\u2019appareil photo ne capte pas ce que l\u2019\u0153il voit.<\/li>\n<li><strong>Oublier que c\u2019est au coucher du soleil.<\/strong> Ensuite, il n\u2019y a plus de marge : le Soleil se couche. Il n\u2019y aura pas de \u00ab seconde chance \u00bb ce jour-l\u00e0. <\/li>\n<\/ul>\n<h2 id=\"historia\">Curiosit\u00e9s historiques : comment les \u00e9clipses pr\u00e9c\u00e9dentes ont \u00e9t\u00e9 v\u00e9cues en Espagne<\/h2>\n<p>Le 12 ao\u00fbt 2026 ne sera pas la premi\u00e8re fois que les Bal\u00e9ares deviennent la sc\u00e8ne mondiale d'une \u00e9clipse. Le <strong>30 ao\u00fbt 1905<\/strong>, une \u00e9clipse solaire totale a travers\u00e9 l'Espagne et a \u00e9t\u00e9 visible comme totale depuis les \u00eeles. Contrairement \u00e0 celle de 2026, celle-ci s'est produite \u00e0 <strong>midi<\/strong> (vers 12h02 aux Bal\u00e9ares) et la totalit\u00e9 a dur\u00e9 pr\u00e8s de <strong>quatre minutes<\/strong>, ce qui en a fait une occasion scientifique extraordinaire.  <\/p>\n<p>Ce fut un \u00e9v\u00e9nement social et scientifique de premier ordre. Des dizaines d'exp\u00e9ditions internationales se sont d\u00e9plac\u00e9es vers la p\u00e9ninsule et les \u00eeles : commissions anglaises, allemandes et de l'Acad\u00e9mie des sciences de Russie. \u00c0 Burgos, des ballons a\u00e9rostatiques ont \u00e9t\u00e9 lanc\u00e9s \u2014 le <em>Jupiter<\/em>, l'<em>Uranus<\/em> et le <em>Mars<\/em> \u2014 et le jeune ing\u00e9nieur <strong>Emilio Herrera<\/strong> est devenu l'une des premi\u00e8res personnes \u00e0 observer la totalit\u00e9 depuis les airs, laissant une description m\u00e9morable de la couronne au-dessus d'une mer de nuages. \u00c0 Majorque, les exp\u00e9ditions se sont install\u00e9es au V\u00e9lodrome de Son Espanyolet et au Grand Hotel ; on a m\u00eame ordonn\u00e9 aux usines de fermer pendant l'\u00e9clipse pour que la fum\u00e9e ne trouble pas l'atmosph\u00e8re. L'un des promoteurs de l'exp\u00e9dition britannique, G. F. Chambers, a fini par l'observer <strong>depuis la mer<\/strong> \u2014 une option qui, avec une planification professionnelle ad\u00e9quate, garde tout son sens 121 ans plus tard.    <\/p>\n<p>\u00c0 l\u2019\u00e9chelle de l\u2019Espagne, la derni\u00e8re \u00e9clipse solaire totale avant celle de 2026 \u00e9tait celle du <strong>17 avril 1912<\/strong>. Ces premi\u00e8res ann\u00e9es du XXe si\u00e8cle ont form\u00e9 un \u00ab trio \u00bb historique (1900, 1905 et 1912) que la communaut\u00e9 astronomique internationale a baptis\u00e9 \u00ab les \u00e9clipses espagnoles \u00bb. L\u2019histoire rime : 2026, 2027 et 2028 forment le nouveau trio ib\u00e9rique.  <\/p>\n<h2 id=\"perseidas\">Une touche finale pour la nuit : les Pers\u00e9ides<\/h2>\n<p>La date de l'\u00e9clipse co\u00efncide presque exactement avec le maximum des <strong>Pers\u00e9ides<\/strong>, la c\u00e9l\u00e8bre pluie d'\u00e9toiles d'ao\u00fbt. Si le ciel reste d\u00e9gag\u00e9 et que vous vous trouvez dans un point sombre de la c\u00f4te ouest \u2014 l'une des zones Starlight de maximum d'obscurit\u00e9 \u2014, vous pouvez rester apr\u00e8s le coucher du soleil et profiter d'un second spectacle astronomique cette m\u00eame nuit : deux ph\u00e9nom\u00e8nes c\u00e9lestes en une seule soir\u00e9e, quelque chose de vraiment exceptionnel. Minorque, en tant que R\u00e9serve Starlight, est l'un des meilleurs endroits de la M\u00e9diterran\u00e9e pour cela.  <\/p>\n<h2 id=\"planificacion\">Planification compl\u00e8te de la journ\u00e9e : checklist finale<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Avant le jour<\/th>\n<th>Le 12 ao\u00fbt<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Acheter des lunettes ISO 12312-2 (\u00e0 l\u2019avance)<\/td>\n<td>Arriver \u00e0 ton point avant 17h00 (zones de Ciutadella)<\/td>\n<\/tr>\n<tr>\n<td>Choisir 1 zone d\u2019observation officielle + 1 plan B<\/td>\n<td>Se garer t\u00f4t ou utiliser les transports en commun \/ la navette<\/td>\n<\/tr>\n<tr>\n<td>T\u00e9l\u00e9charger l'appli Horitz\u00f3 Eclipsi 2026 et v\u00e9rifier l'horizon<\/td>\n<td>Se placer face \u00e0 l'ouest-nord-ouest (azimut \u2248 288\u00b0)<\/td>\n<\/tr>\n<tr>\n<td>Consulter les pr\u00e9visions AEMET 3-4 jours avant<\/td>\n<td>Lunettes mises d\u00e8s 19h37:16 (premier contact)<\/td>\n<\/tr>\n<tr>\n<td>Consulter les acc\u00e8s et restrictions sur caib.es<\/td>\n<td>Enlever les lunettes uniquement lorsque le Soleil est totalement couvert<\/td>\n<\/tr>\n<tr>\n<td>Charger appareil photo\/portable et pr\u00e9parer le filtre solaire<\/td>\n<td>Remettre les lunettes au premier \u00e9clat de lumi\u00e8re<\/td>\n<\/tr>\n<tr>\n<td>Pr\u00e9parer pique-nique, eau, chaise, protection solaire<\/td>\n<td>Rester pour les Pers\u00e9ides si le ciel le permet<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"faq\">Foire aux questions<\/h2>\n<h3>\u00c0 quelle heure est l'\u00e9clipse \u00e0 Minorque ?<\/h3>\n<p>\u00c0 Ciutadella, selon l\u2019IGN, l\u2019\u00e9clipse partielle commence \u00e0 <strong>19h37:16<\/strong> et la totalit\u00e9 va de <strong>20h30:16 \u00e0 20h31:27<\/strong> (avec un maximum \u00e0 20h30:51). Le coucher du soleil a lieu \u00e0 <strong>20h45:28<\/strong>. Les horaires peuvent varier de quelques secondes selon le point exact d\u2019observation.  <\/p>\n<h3>Combien de temps dure la totalit\u00e9 ?<\/h3>\n<p>\u00c0 Ciutadella, <strong>environ 1 minute et 11 secondes<\/strong> (donn\u00e9e IGN pour la municipalit\u00e9). Minorque est le premier point des Bal\u00e9ares o\u00f9 commence la totalit\u00e9, avec le Soleil entre 1,4\u00b0 et 2\u00b0 au-dessus de l\u2019horizon selon l\u2019emplacement : la hauteur la plus basse de toute l\u2019Espagne. <\/p>\n<h3>Quelles sont les zones d\u2019observation officielles \u00e0 Minorque ?<\/h3>\n<p>Neuf : <strong>Cala en Bosc, Cala Blanca, Avinguda Los Delfines et Son Blanc<\/strong> (Ciutadella), <strong>Carrer des Tamarells<\/strong> (Platges de Fornells), <strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong> et les plages de <strong>Son Bou, Sant Tom\u00e0s et Talis<\/strong>. Dans les quatre zones de Ciutadella, la circulation est ferm\u00e9e d\u00e8s 17h00. Le Govern rappelle que ce sont les points les plus s\u00fbrs et accessibles, pas n\u00e9cessairement ceux offrant la meilleure visibilit\u00e9.  <\/p>\n<h3>Fera-t-il nuit \u00e0 Minorque ?<\/h3>\n<p>Pas compl\u00e8tement, car elle se produit tr\u00e8s pr\u00e8s du coucher du soleil. Le ciel s'obscurcira notablement, avec un ton cr\u00e9pusculaire \u00e0 360\u00b0, et la temp\u00e9rature baissera, mais ce ne sera pas une nuit noire. <\/p>\n<h3>Dois-je aller \u00e0 un endroit sp\u00e9cial ou puis-je la voir depuis n'importe quelle partie de Minorque ?<\/h3>\n<p>Toute l\u2019\u00eele est dans la bande de totalit\u00e9, donc techniquement on peut la voir de n\u2019importe quel point. Ce qui fait la diff\u00e9rence, c\u2019est d\u2019avoir un <strong>horizon ouest d\u00e9gag\u00e9<\/strong>, car le Soleil sera tr\u00e8s bas. Si vous pouvez le voir depuis votre logement avec un horizon ouest, c\u2019est l\u2019option la plus confortable et la plus s\u00fbre.  <\/p>\n<h3>Et s'il y a des nuages ce jour-l\u00e0 ?<\/h3>\n<p>Le mois d\u2019ao\u00fbt offre g\u00e9n\u00e9ralement des ciels stables \u00e0 Minorque, mais personne ne peut le garantir. Les nuages hauts permettent de voir une partie du ph\u00e9nom\u00e8ne ; les nuages bas sur l\u2019horizon ouest pourraient masquer la totalit\u00e9. V\u00e9rifie les pr\u00e9visions les jours pr\u00e9c\u00e9dents, contr\u00f4le ton emplacement avec l\u2019application Horitz\u00f3 2026 et pr\u00e9vois un plan B.  <\/p>\n<h3>Comment prot\u00e9ger ma vue ?<\/h3>\n<p>Avec des lunettes d\u2019\u00e9clipse homologu\u00e9es <strong>ISO 12312-2<\/strong> chaque fois que tu regardes le Soleil pendant les phases partielles. Tu ne peux les enlever que lorsque le Soleil est enti\u00e8rement couvert, et tu dois les remettre d\u00e8s que r\u00e9appara\u00eet le premier \u00e9clat. Les lunettes de soleil, radiographies ou verres fum\u00e9s ne conviennent pas.  <\/p>\n<h3>Puis-je faire des photos avec le portable ?<\/h3>\n<p>Oui, avec un filtre solaire sur l\u2019objectif pendant la phase partielle. Quand le Soleil est enti\u00e8rement couvert, tu peux le retirer. Bloque la mise au point et l\u2019exposition manuellement et pr\u00e9pare le cadrage \u00e0 l\u2019avance, car la totalit\u00e9 dure un peu plus d\u2019une minute.  <\/p>\n<h3>Est-ce sans danger pour les enfants ?<\/h3>\n<p>Le Govern recommande que les <strong>enfants de moins de six ans n\u2019observent pas directement<\/strong> l\u2019\u00e9clipse : pour eux, projection indirecte, un \u00e9cran ou la retransmission t\u00e9l\u00e9vis\u00e9e. Les autres mineurs peuvent l\u2019observer avec des lunettes homologu\u00e9es pendant toute la phase partielle et sous la surveillance constante d\u2019un adulte. C\u2019est une exp\u00e9rience \u00e9ducative magnifique.  <\/p>\n<h3>Quand a eu lieu la derni\u00e8re \u00e9clipse totale visible aux Bal\u00e9ares ?<\/h3>\n<p>Le 30 ao\u00fbt 1905. \u00c0 l\u2019\u00e9chelle de l\u2019Espagne, la derni\u00e8re \u00e9clipse totale avant celle de 2026 \u00e9tait celle du <strong>17 avril 1912<\/strong>. Apr\u00e8s l\u2019\u00e9clipse totale du 2 ao\u00fbt 2027, il n\u2019y aura pas d\u2019autre \u00e9clipse totale en Espagne avant <strong>2053<\/strong> ; celle de 2028 sera <strong>annulaire<\/strong>, pas totale.  <\/p>\n<h3>Y aura-t-il des coupures de circulation ou beaucoup de monde ?<\/h3>\n<p>Oui. Dans les quatre zones officielles de Ciutadella, la circulation est ferm\u00e9e <strong>d\u00e8s 17h00<\/strong> (plus t\u00f4t s\u2019il y a beaucoup d\u2019affluence). Dans le reste de l\u2019\u00eele, les restrictions d\u00e9pendent de chaque voie et municipalit\u00e9, g\u00e9n\u00e9ralement <strong>entre 15h00 et 21h00<\/strong>. Les acc\u00e8s au Far de Punta Nati (CF-5, avec le parking ferm\u00e9 d\u00e8s 8h00), au Cam\u00ed de Tramuntana, au Far de Cavalleria (CF-3) et au Monte Toro (Me-13) sont r\u00e9gul\u00e9s, ainsi que des fermetures \u00e0 Ferreries et Sant Llu\u00eds. Consulte le d\u00e9tail dans la section <a href=\"#afluencia\">du dispositif officiel<\/a>.    <\/p>\n<h2 id=\"fuentes\">Sources officielles et scientifiques<\/h2>\n<p style=\"font-size:0.95em;\">Les donn\u00e9es de ce guide proviennent de sources officielles et scientifiques, que nous recommandons de consulter directement pour obtenir les informations les plus \u00e0 jour :<\/p>\n<ul style=\"font-size:0.95em;\">\n<li><strong>Institut g\u00e9ographique national (IGN)<\/strong> \u2014 <a href=\"https:\/\/eclipses.ign.es\/\" target=\"_blank\" rel=\"noopener\">eclipses.ign.es<\/a>, <a href=\"https:\/\/astronomia.ign.es\/eclipses-de-sol-y-luna\/eclipse-total-sol-de-12-de-agosto-2026\" target=\"_blank\" rel=\"noopener\">fiche de l\u2019\u00e9clipse<\/a> et <a href=\"https:\/\/visualizadores.ign.es\/eclipses\" target=\"_blank\" rel=\"noopener\">visualiseur d\u2019\u00e9clipses<\/a> (horaires et donn\u00e9es par municipalit\u00e9).<\/li>\n<li><strong>Govern de les Illes Balears<\/strong> \u2014 <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">informations officielles sur l\u2019\u00e9clipse et les restrictions<\/a> et <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/zones-d-observaci%C3%B3-oficial-zoo-\" target=\"_blank\" rel=\"noopener\">zones d\u2019observation officielles (ZOO)<\/a>.<\/li>\n<li><strong>Consell Insular de Menorca et mairies<\/strong> \u2014 dispositif insulaire de mobilit\u00e9, acc\u00e8s et protection du patrimoine.<\/li>\n<li><strong>Horitz\u00f3 Eclipsi 2026<\/strong> \u2014 <a href=\"https:\/\/www.horitzo2026.com\" target=\"_blank\" rel=\"noopener\">horitzo2026.com<\/a> (application officielle de visibilit\u00e9 selon l'horizon r\u00e9el).<\/li>\n<li><strong>Minist\u00e8re des Transports et de la Mobilit\u00e9 Durable<\/strong> \u2014 <a href=\"https:\/\/www.transportes.gob.es\/movilidad-sostenible\/estudios-movilidad-big-data\/el-trio-de-eclipses-solares-y-la-movilidad\" target=\"_blank\" rel=\"noopener\">visualiseur HERMES et \u00e9tude de mobilit\u00e9 du trio d\u2019\u00e9clipses<\/a>.<\/li>\n<li><strong>NASA<\/strong> \u2014 <a href=\"https:\/\/science.nasa.gov\/eclipses\/safety\/\" target=\"_blank\" rel=\"noopener\">science.nasa.gov\/eclipses\/safety<\/a> (s\u00e9curit\u00e9 oculaire) et <a href=\"https:\/\/ciencia.nasa.gov\/eclipses\/lo-que-necesitas-saber-sobre-los-eclipses-solares\/\" target=\"_blank\" rel=\"noopener\">ciencia.nasa.gov<\/a>.<\/li>\n<li><strong>European Southern Observatory (ESO)<\/strong> \u2014 mat\u00e9riel de s\u00e9curit\u00e9 oculaire.<\/li>\n<li><strong>Fundaci\u00f3n Starlight<\/strong> et <strong>Consell Insular de Menorca<\/strong> \u2014 certification Starlight et ciel nocturne.<\/li>\n<li><strong>AEMET<\/strong> \u2014 pr\u00e9visions m\u00e9t\u00e9orologiques.<\/li>\n<\/ul>\n<div style=\"border:1px solid #d7a553;background:#fbf6ec;padding:22px 24px;margin:32px 0;border-radius:14px;text-align:center;\">\n<p style=\"margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:1.25em;color:#08243c;font-weight:700;\">Tu vas passer plusieurs jours \u00e0 Minorque ?<\/p>\n<p style=\"margin:0 0 18px;color:#4d5f6d;\">D\u00e9couvre Ciutadella et l\u2019histoire de l\u2019\u00eele accompagn\u00e9 par un guide officiel local.<\/p>\n<p style=\"margin:0;\">\n<a href=\"https:\/\/voyagermenorca.com\/fr\/excursions\/\" style=\"display:inline-block;background:#08243c;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Voir les visites guid\u00e9es<\/a><br \/>\n<a href=\"https:\/\/api.whatsapp.com\/send?phone=34649902301\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#1f7a4d;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Contacter via WhatsApp<\/a>\n<\/p>\n<\/div>\n<p style=\"font-size:0.9em;color:#666;\">Guide \u00e9labor\u00e9 par <strong>Daniel Vaquera Sintes<\/strong>, guide officiel de tourisme de Minorque (GT-0138-ME). <strong>Derni\u00e8re mise \u00e0 jour : 7 ao\u00fbt 2026<\/strong>, avec les neuf zones d\u2019observation officielles (ZOO) de Minorque, les horaires municipaux de l\u2019IGN et le dispositif de mobilit\u00e9 et d\u2019acc\u00e8s publi\u00e9 par le Govern, le Consell Insular et les mairies. Les mesures peuvent varier les jours pr\u00e9c\u00e9dents selon l\u2019affluence : consulte toujours les informations officielles avant de te d\u00e9placer. <\/p>\n","protected":false},"excerpt":{"rendered":"<p>Le 12 ao\u00fbt 2026, Minorque vivra sa premi\u00e8re \u00e9clipse solaire totale en plus d\u2019un 