Math.cos(ad)+Math.cos(la1)*Math.sin(ad)*Math.cos(br));var lo2=lo1+Math.atan2(Math.sin(br)*Math.sin(ad)*Math.cos(la1),Math.cos(ad)-Math.sin(la1)*Math.sin(la2));return[la2*180\/Math.PI,lo2*180\/Math.PI];}var bounds=[];zoos.forEach(function(z){var zi=L.divIcon({className:\"\",html:DV+' class=\"zoo-marker-ecl\">ZOO'+DVC,iconSize:[46,26],iconAnchor:[23,13],popupAnchor:[0,-14]});L.marker([z.lat,z.lng],{icon:zi,title:\"Zona de observaci\u00f3n oficial: \"+z.name}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#1f5f3f;margin-bottom:5px;\">'+z.name+' (ZOO)'+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+z.det+' \u00b7 ubicaci\u00f3n orientativa'+DVC);bounds.push([z.lat,z.lng]);if(z.arrow){var e=dp(z.lat,z.lng,B,K);L.polyline([[z.lat,z.lng],e],{color:\"#f2a533\",weight:4,opacity:0.95,dashArray:\"8 6\"}).addTo(map);var ai=L.divIcon({className:\"\",html:DV+' class=\"sunset-arrow\" style=\"transform:rotate('+(B-90)+'deg)\">\u27a4'+DVC,iconSize:[28,28],iconAnchor:[14,14]});L.marker(e,{icon:ai,interactive:false}).addTo(map);bounds.push(e);}});regs.forEach(function(r){var ri=L.divIcon({className:\"\",html:DV+' class=\"reg-marker-ecl\">!'+DVC,iconSize:[34,34],iconAnchor:[17,17],popupAnchor:[0,-19]});L.marker([r.lat,r.lng],{icon:ri,title:r.name+\" (acceso regulado)\"}).addTo(map).bindPopup(DV+' style=\"font-weight:800;color:#8a3d09;margin-bottom:5px;\">'+r.name+DVC+DV+' style=\"color:#4d5f6d;font-size:13px;\">'+r.det+DVC);bounds.push([r.lat,r.lng]);});map.fitBounds(bounds,{padding:[32,32],maxZoom:12});L.control.scale({imperial:false,position:\"bottomleft\"}).addTo(map);var lg=L.control({position:\"topright\"});lg.onAdd=function(){var d=L.DomUtil.create(\"div\",\"eclipse-map-legend\");d.innerHTML='<strong>Leyenda<\/strong><span class=\"legend-zoo\">ZOO<\/span>Zona de observaci\u00f3n oficial<br \/><span class=\"legend-reg\">!<\/span>Acceso regulado \/ zona de riesgo<br \/><span class=\"legend-arrow\">\u27a4<\/span>Ocaso 288\u00b0 \u00b7 oeste-noroeste';return d;};lg.addTo(map);map.on(\"click\",function(){map.scrollWheelZoom.enable();});map.on(\"mouseout\",function(){map.scrollWheelZoom.disable();});}function ensureLeaflet(cb){if(window.L&&window.L.map){cb();return;}if(!document.querySelector('link[href*=\"'+LF+'\"]')){var l=document.createElement(\"link\");l.rel=\"stylesheet\";l.href=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".css\";document.head.appendChild(l);}var ex=document.querySelector('script[src*=\"'+LF+'\"]');if(ex){if(window.L&&window.L.map){cb();}else{ex.addEventListener(\"load\",cb);}}else{var js=document.createElement(\"script\");js.src=\"https:\/\/unpkg.com\/\"+LF+\"@1.9.4\/dist\/\"+LF+\".js\";js.onload=cb;document.head.appendChild(js);}}if(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",function(){ensureLeaflet(initEclipseMap);});}else{ensureLeaflet(initEclipseMap);}})();<\/script><\/div>\n<h2 id=\"zoo\">The 9 official observation zones (ZOO) in Menorca<\/h2>\n<div style=\"border-left:4px solid #08243c;background:#eef4f9;padding:16px 20px;margin:24px 0;border-radius:0 8px 8px 0;\">\n<p style=\"margin:0;\"><strong>August 2026 Update.<\/strong> The Government of the Balearic Islands has enabled <strong>26 official observation zones (ZOO)<\/strong> across the Balearic Islands, <strong>nine of them in Menorca<\/strong>. They were chosen from over a hundred possible locations, evaluating visibility, accessibility, capacity, parking, and the possibility of emergency services intervention. The Government itself states clearly: <strong>these are not necessarily the best places to view the eclipse<\/strong>, but rather those where the safety of people can be best guaranteed.  <\/p>\n<\/div>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Official Observation Zone<\/th>\n<th>Municipality<\/th>\n<th>Detail<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td><strong>Cala en Bosc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>From the promenade car park to Cap d&#8217;Artrutx lighthouse<\/td>\n<\/tr>\n<tr>\n<td><strong>Cala Blanca<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>From Clot de sa Cera to Es Mirador restaurant<\/td>\n<\/tr>\n<tr>\n<td><strong>Avinguda Los Delfines<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Cala en Blanes \/ Los Delfines urbanization, northwest coast<\/td>\n<\/tr>\n<tr>\n<td><strong>Son Blanc<\/strong><\/td>\n<td>Ciutadella<\/td>\n<td>Coastal strip south of the port, next to Son Oleo<\/td>\n<\/tr>\n<tr>\n<td><strong>Carrer des Tamarells<\/strong><\/td>\n<td>Es Mercadal<\/td>\n<td>Platges de Fornells, north coast<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Son Bou<\/strong><\/td>\n<td>Alaior<\/td>\n<td>Recommended access via Torre Sol\u00ed, with shuttle bus<\/td>\n<\/tr>\n<tr>\n<td><strong>Platja de Sant Tom\u00e0s<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>South coast<\/td>\n<\/tr>\n<tr>\n<td><strong>Talis<\/strong><\/td>\n<td>Es Migjorn Gran<\/td>\n<td>South coast, next to Sant Tom\u00e0s<\/td>\n<\/tr>\n<tr>\n<td><strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong><\/td>\n<td>Ma\u00f3<\/td>\n<td>Possible traffic closure from 7:00 PM<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<p><strong>How I read it, as a local guide.<\/strong> The ZOOs solve safety and parking issues, not visibility. With the Sun about 2\u00b0 high and an azimuth of 288\u00b0 (west-northwest), the four Ciutadella zones\u2014<strong>Cala en Bosc, Cala Blanca, Son Blanc, and Avinguda Los Delfines<\/strong>\u2014are the ones that best combine the official arrangements with a clear sea horizon in the correct direction. In the zones on the south coast (Son Bou, Sant Tom\u00e0s, Talis) and on the Passeig Mar\u00edtim de Ma\u00f3, the sunset line is lower relative to the coast itself or the urban area: they are perfectly valid and safe, but it is advisable to <strong>check the actual horizon profile with the Horitz\u00f3 Eclipsi 2026 app<\/strong> from the specific spot where you plan to position yourself.  <\/p>\n<p>And a recommendation worth more than any list: if you can see it from your own accommodation or from an area you can reach on foot, and you have a western horizon, do it. It&#8217;s the safest way to avoid travel, congestion, and last-minute surprises. <\/p>\n<h2 id=\"donde\">The best places to watch the eclipse in Menorca<\/h2>\n<p>Since the Sun will be almost touching the horizon, the key is not height but <strong>a completely open and unobstructed western horizon<\/strong>: no mountains, buildings, groves, or low clouds. All recommended points are in the western half of the island. I&#8217;ve grouped them by type for you to choose according to your plan, but keep in mind the <a href=\"#afluencia\">official access arrangements<\/a>: several of them are regulated on August 12.  <\/p>\n<h3>Best beaches and coves to watch it<\/h3>\n<ul>\n<li><strong>Cala en Bosc (official observation zone):<\/strong> coast open to the sunset, with a promenade by the sea, bars, and restrooms nearby. The ZOO covers from the promenade car park to the Cap d&#8217;Artrutx lighthouse. Parking is ample but will fill up very quickly that day, and there&#8217;s little shade left by that time. Traffic will be closed from 5:00 PM, or earlier if crowd levels demand it.   <\/li>\n<li><strong>Cala Blanca (official observation zone):<\/strong> somewhat less crowded, with an open western horizon from the side rocks of the cove and restaurants in the urbanization itself. The ZOO runs from Clot de sa Cera to Es Mirador restaurant. Street parking is available; it&#8217;s advisable to arrive early and walk the last few meters.  <\/li>\n<li><strong>Cala Santandria:<\/strong> a wind-sheltered cove a few minutes from Ciutadella, comfortable for families, with bars by the sand. It is not an official zone, so there will be no specific arrangements: street parking is limited, and the earlier you arrive, the better your spot. <\/li>\n<li><strong>Son Xoriguer and the Cap d&#8217;Artrutx area:<\/strong> the southwestern tip of the island, with the Artrutx lighthouse as a reference, a flat promenade facing the sunset directly, and Cala en Bosc services a short walk away. There is usually a sea breeze: pleasant in August, but secure your tripod. <\/li>\n<\/ul>\n<h3>Best lighthouses<\/h3>\n<ul>\n<li><strong>Punta Nati Lighthouse (regulated access on August 12):<\/strong> offers an excellent western horizon, but the official arrangements <strong>close the car park from 8:00 AM<\/strong> and regulate access via the CF-5 road. Ciutadella also considers it a <strong>risk zone<\/strong>, along with Cala Morell and Pont d&#8217;en Gil, with Local Police control. Do not expect to be able to arrive by car that day. Outside of August 12, it&#8217;s still wonderful: it&#8217;s on the <a href=\"https:\/\/voyagermenorca.com\/en\/tourist-guide-cami-de-cavalls\/\">Cam\u00ed de Cavalls<\/a> and is one of the darkest areas on the island.   <\/li>\n<li><strong>Artrutx Lighthouse:<\/strong> at the southwest vertex, with perfect sunset orientation, flat terrain, and relatively close parking. It is within the official observation zone of Cala en Bosc: of the lighthouses, it is the most convenient and the only one with official arrangements. <\/li>\n<li><strong>Cavalleria Lighthouse (regulated access on August 12):<\/strong> its cliffs open to the west offer a clear horizon and a spectacular setting, but the <strong>Cam\u00ed de Tramuntana to the lighthouse (CF-3) will be regulated<\/strong> that day, as will the Cam\u00ed de Tramuntana itself at the Me-15 \/ Me-7 intersection roundabout. The official alternative in that area of the island is Carrer des Tamarells, in Platges de Fornells. <\/li>\n<\/ul>\n<p>You can read more in our <a href=\"https:\/\/voyagermenorca.com\/en\/guia-faros-menorca\/\">guide to Menorca\u2019s 7 lighthouses<\/a>.<\/p>\n<h3>Best cliffs and viewpoints<\/h3>\n<ul>\n<li><strong>Cliffs of Punta Nati and the north coast of Ciutadella:<\/strong> height and a 180\u00b0 sea horizon, but affected by the same access arrangements as the Punta Nati lighthouse.<\/li>\n<li><strong>Pont d&#8217;en Gil:<\/strong> the natural arch on the west coast, one of the island&#8217;s most famous sunset viewpoints, but <strong>considered a risk zone on August 12<\/strong>, with police control. It can be reached on foot from the Cala en Blanes area via a stretch of coast with no shade or services and an open cliff: it&#8217;s not the place for a night of maximum attendance. Very close official alternative: <strong>Avinguda Los Delfines<\/strong>.  <\/li>\n<li><strong>Passeig Mar\u00edtim de Ciutadella:<\/strong> flat, paved, and accessible, with clear views of the sea, the port, and the old town in the background, and bars and services nearby. It is not listed as an official zone, but it is one of the busiest on the island: reserve your spot well in advance. The nearest official zone is Son Blanc. See our guide to <a href=\"https:\/\/voyagermenorca.com\/en\/sunset-menorca-9-viewpoints\/\">9 sunset viewpoints in Menorca<\/a>.   <\/li>\n<\/ul>\n<h3>From the sea<\/h3>\n<p>Observing the eclipse from the sea can offer a clear horizon, but it requires professional planning. It should only be done with an experienced skipper or an authorized company, after consulting the marine forecast, navigation warnings, and any restrictions that may be established. The Island Council also reminds you <strong>not to anchor over Posidonia meadows<\/strong>, maintain a safe distance between vessels, avoid risky maneuvers, and plan your return to port in advance, as a very high concentration of boats is expected right at the end of the eclipse.  <\/p>\n<h3>Archaeological sites<\/h3>\n<p>The Island Council will deploy wardens at <strong>Castell de Santa \u00c0gueda<\/strong> and <strong>Torre d&#8217;en Galm\u00e8s<\/strong> and other publicly owned sites, to manage access and prevent climbing on talayots, towers, and heritage structures. These are monuments over three thousand years old: they are to be looked at, not climbed. <\/p>\n<h3>Comparison table of viewing points<\/h3>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Location<\/th>\n<th>Type<\/th>\n<th>Western Horizon<\/th>\n<th>Expected Attendance<\/th>\n<th>Access on August 12<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Cala en Bosc <em>(official)<\/em><\/td>\n<td>Beach<\/td>\n<td>Excellent<\/td>\n<td>High<\/td>\n<td>Easy, with services; traffic closed from 5:00 PM<\/td>\n<\/tr>\n<tr>\n<td>Cala Blanca <em>(official)<\/em><\/td>\n<td>Beach<\/td>\n<td>Excellent<\/td>\n<td>Medium-High<\/td>\n<td>Easy; traffic closed from 5:00 PM<\/td>\n<\/tr>\n<tr>\n<td>Son Blanc <em>(official)<\/em><\/td>\n<td>Urban Coast<\/td>\n<td>Very Good<\/td>\n<td>High<\/td>\n<td>On foot from Ciutadella; traffic closed from 5:00 PM<\/td>\n<\/tr>\n<tr>\n<td>Avinguda Los Delfines <em>(official)<\/em><\/td>\n<td>Urban Promenade<\/td>\n<td>Very Good<\/td>\n<td>Medium-High<\/td>\n<td>Easy; traffic closed from 5:00 PM<\/td>\n<\/tr>\n<tr>\n<td>Cap d&#8217;Artrutx \/ Artrutx Lighthouse<\/td>\n<td>Lighthouse\/Coast<\/td>\n<td>Excellent<\/td>\n<td>Medium<\/td>\n<td>Within the official zone of Cala en Bosc<\/td>\n<\/tr>\n<tr>\n<td>Passeig Mar\u00edtim de Ciutadella<\/td>\n<td>Urban Promenade<\/td>\n<td>Very Good<\/td>\n<td>Very High<\/td>\n<td>Easy, on foot from the center; no official arrangements<\/td>\n<\/tr>\n<tr>\n<td>Cala Santandria<\/td>\n<td>Cove<\/td>\n<td>Good<\/td>\n<td>Medium-High<\/td>\n<td>Easy, family-friendly; no official arrangements<\/td>\n<\/tr>\n<tr>\n<td>Punta Nati Lighthouse<\/td>\n<td>Lighthouse\/Cliff<\/td>\n<td>Excellent<\/td>\n<td>Risk Zone<\/td>\n<td>CF-5 road regulated and car park closed from 8:00 AM<\/td>\n<\/tr>\n<tr>\n<td>Cavalleria Lighthouse<\/td>\n<td>Lighthouse\/Cliff<\/td>\n<td>Good<\/td>\n<td>High<\/td>\n<td>CF-3 access regulated<\/td>\n<\/tr>\n<tr>\n<td>From the sea (west coast)<\/td>\n<td>Boat<\/td>\n<td>Total<\/td>\n<td>\u2014<\/td>\n<td>Only with an experienced skipper or authorized company<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"orientacion\">Sun direction and horizon<\/h2>\n<p>At maximum eclipse, the Sun will be towards the <strong>west-northwest, with an azimuth of about 288\u00b0<\/strong>. In practice: stand facing the sea on the west coast and look for the point where the Sun is setting. A compass (or the one in the Horitz\u00f3 2026 app) will confirm the exact direction. The day before, at the same time, check that there\u2019s no obstacle (crane, mast, headland) on that line. The Govern carried out an official visibility rehearsal on April 29 and 30 precisely to verify these points: if the Sun was visible at that time on those days, it will also be visible on August 12.    <\/p>\n<h2 id=\"meteo\">Weather: chances of clear skies<\/h2>\n<p>Climatologically, August is one of Menorca\u2019s most stable and driest months, with predominantly clear skies and a low chance of rain. That\u2019s in your favour. But an eclipse this low on the horizon has a specific enemy: <strong>low clouds over the sea<\/strong>, which can form even if the rest of the sky is clear. Recommendations:   <\/p>\n<ul>\n<li>Check the <strong>AEMET<\/strong> forecast and cloud maps in the 3\u20134 days beforehand, paying attention to low cloud on the sea horizon.<\/li>\n<li>Always have a <strong>plan B<\/strong> at another point on the west coast that you can move to with enough time, considering the planned traffic restrictions.<\/li>\n<li>Remember that <strong>high clouds<\/strong> (cirrus) can still allow you to see the event; low clouds are what ruin it.<\/li>\n<li>From the sea there is more room to avoid cloud cover, but only with an experienced skipper or an authorized company (see the &#8220;From the sea&#8221; section).<\/li>\n<\/ul>\n<h2 id=\"luminica\">Light pollution and Menorca\u2019s Starlight advantage<\/h2>\n<p>Menorca has been a <strong>Starlight Reserve and Tourist Destination<\/strong> since 2019 (certified by the Starlight Foundation), and the whole island is part of a Biosphere Reserve. It has a Night Sky Protection Regulation and <strong>maximum darkness zones<\/strong>\u2014Punta Nati, Macarella-Son Saura, Cavalleria-Cala del Pilar, Monte Toro, s&#8217;Albufera des Grau, among others\u2014with virtually no light pollution. <\/p>\n<p>For the eclipse itself, with the Sun still above the horizon, light pollution is not a decisive factor. But it becomes crucial right after: if you stay at a dark spot on the west coast after sunset, you will have an exceptional sky for the second part of the night (see Perseids, below). Keep in mind that several of these areas have regulated access on August 12.  <\/p>\n<h2 id=\"afluencia\">Access restrictions, attendance, and mobility: the official arrangements<\/h2>\n<p>A very high influx of &#8220;eclipse hunters&#8221; and visitors from all over Europe is expected, in the middle of August and with the island already in high season. The Balearic Government activated the <strong>ECLIPBAL<\/strong> protocol, within the Territorial Civil Protection Plan, and the security, mobility, and forest protection arrangements have already been published, in coordination with the Island Council and the municipalities. These are the points that most affect you as a visitor.  <\/p>\n<h3>General restrictions<\/h3>\n<ul>\n<li>In the <strong>four official observation zones of Ciutadella<\/strong>, traffic will be closed <strong>from 5:00 PM<\/strong>, or earlier if crowd levels demand it.<\/li>\n<li>In the <strong>rest of Menorca<\/strong>, schedules and restrictions depend on each road and municipality. Generally, restrictions on affected roads will apply <strong>between 3:00 PM and 9:00 PM<\/strong>, although they may be brought forward or extended for safety reasons. <\/li>\n<li>The restrictions <strong>do not affect<\/strong> residents, essential services, public transport, or duly justified displacements.<\/li>\n<\/ul>\n<h3>Regulated or closed accesses in Menorca<\/h3>\n<ul>\n<li><strong>Punta Nati Lighthouse (CF-5):<\/strong> regulated access and <strong>car park closed from 8:00 AM<\/strong>.<\/li>\n<li><strong>Cam\u00ed de Tramuntana:<\/strong> regulation at the Me-15 \/ Me-7 intersection roundabout.<\/li>\n<li><strong>Cavalleria Lighthouse (CF-3):<\/strong> Cam\u00ed de Tramuntana to the lighthouse, regulated.<\/li>\n<li><strong>Monte Toro (Me-13):<\/strong> road from Es Mercadal to El Toro, regulated.<\/li>\n<li><strong>Ferreries:<\/strong> closure of access roads to l&#8217;Enclusa and Cam\u00ed de Tramuntana d&#8217;Ets Alocs, with gradual closures (first partial on the Me-1, then at the access to the Binissu\u00e8s estate and, finally, access only for residents of the Cam\u00ed de Tramuntana estates and tourist accommodations).<\/li>\n<li><strong>Sant Llu\u00eds:<\/strong> Passeig de Cap d&#8217;en Font closed at both intersections with Carrer del Cal\u00f3 Blanc, and Passeig de la Mar (Binissaf\u00faller Roters) at the crossings with Llevant and Tramuntana, <strong>between 7:00 PM and 9:30 PM<\/strong>.<\/li>\n<li><strong>Ma\u00f3:<\/strong> possible closure of Passeig Mar\u00edtim from 7:00 PM and restrictions in Binidal\u00ed from 6:30 PM; controls in Es Canutells, Es Grau, and other high-traffic points; restricted access to Fav\u00e0ritx and closure of the batteries during the day.<\/li>\n<li><strong>Ciutadella:<\/strong> <strong>Cala Morell, Punta Nati Lighthouse, and Pont d&#8217;en Gil<\/strong> are considered risk zones, with Local Police control.<\/li>\n<\/ul>\n<h3>Screens to follow the eclipse without traveling<\/h3>\n<p>If you prefer to avoid roads and crowds, several municipalities will install screens: <strong>Ciutadella<\/strong>, in Pla\u00e7a des Born; <strong>Alaior<\/strong>, in Sa Pla\u00e7a; and <strong>Ma\u00f3<\/strong>, at Cinemes Ocimax and in the port.<\/p>\n<h3>Parking and shuttle bus<\/h3>\n<p>For the <strong>Son Bou<\/strong> area, it is recommended to access via <strong>Torre Sol\u00ed<\/strong>, where a car park will be set up in Torre Sol\u00ed II with a <strong>continuous shuttle bus between 5:00 PM and 12:30 AM<\/strong>. This is probably the most convenient option on the entire island if you are not in a hurry and want to forget about the car. <\/p>\n<p><strong>Practical consequence:<\/strong> do not rely on a single access point or improvise at the last minute. Measures will be updated in the days leading up to the event based on expected crowd levels, so <strong>check <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">the official Government information<\/a> on the day itself<\/strong>, and always follow the instructions of emergency services. <\/p>\n<h2 id=\"como-llegar\">How to get there, parking and public transport<\/h2>\n<h3>How to get to the west coast<\/h3>\n<p>Most recommended spots are in the municipality of Ciutadella, at the western end of the island, about 45 minutes by car from Ma\u00f3 airport via the main road Me-1. From Ciutadella, the southwest resorts (Cala en Bosc, Cala Blanca, Cala Santandria) are 10\u201315 minutes away.  That day, allow much more time than usual.<\/p>\n<h3>Parking<\/h3>\n<ul>\n<li>In Ciutadella there is free parking on the Sant Nicolau promenade and the seafront, as well as paid parking (blue zone) in the centre.<\/li>\n<li>If you go by car to one of the official zones in Ciutadella, <strong>arrive before 5:00 PM<\/strong>, because traffic may be closed even earlier depending on crowd levels. Whenever possible, walk from your accommodation or use public transport. <\/li>\n<li>In natural areas, space is limited and several accesses are regulated: never park outside permitted areas or block roads or emergency accesses.<\/li>\n<\/ul>\n<h3>Public transport<\/h3>\n<p>Menorca has regular bus lines connecting Ma\u00f3 and Ciutadella year-round, and in summer there are services from Ciutadella station to the southern and southwestern coves. That day demand will be higher than usual and some lines may be reinforced or reorganized: check updated timetables with the operator. Taking public transport\u2014or using the Torre Sol\u00ed shuttle bus for Son Bou\u2014and walking the last stretch can save you the parking hassle.  <\/p>\n<h2 id=\"seguridad\">Eye Safety: The Most Important Thing<\/h2>\n<p>You should never look directly at the Sun without adequate protection, <strong>except when the solar disk is completely covered by the Moon during totality<\/strong>.<\/p>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-seguridad-eclipse-eso.jpg?w=800&#038;ssl=1\" alt=\"Infographic in Spanish on how to safely observe a solar eclipse with eye protection\"><figcaption>How to safely observe the eclipse with eye protection. Credit: ESO \/ B. Tafreshi (twanight.org) \/ P. Hor\u00e1lek. <\/figcaption><\/figure>\n<ul>\n<li>Always use <strong>certified eclipse glasses<\/strong> (standard <strong>ISO 12312-2<\/strong>) whenever you look directly at the Sun during the partial phases. Regular sunglasses, no matter how dark they seem, do not protect: they allow infrared and ultraviolet radiation to pass through, which can damage the retina without you noticing. X-rays, smoked glass, or homemade filters are also not suitable.  <\/li>\n<li>Buy your glasses in advance from a reliable supplier: they sell out in the days beforehand. The Govern has reminded the retail sector that only products that meet international standards should be sold. <\/li>\n<li><strong>Only remove your glasses when the Sun is completely covered and no bright part is visible. Put them back on immediately when the first flash of light reappears. <\/strong> The times are only indicative: be guided by what you see, not by the clock.<\/li>\n<li>If you use a camera, binoculars or a telescope, they need their <strong>own solar filter<\/strong> during the partial phase; looking at the Sun through optics without a filter is especially dangerous.<\/li>\n<li>An alternative and completely safe method is <strong>indirect projection<\/strong>: make a small hole in a cardboard sheet and project the Sun&#8217;s image onto another surface, never looking directly.<\/li>\n<\/ul>\n<h2 id=\"equipo\">Recommended equipment<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Essential<\/th>\n<th>Recommended<\/th>\n<th>For photography<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>ISO 12312-2 eclipse glasses (one per person + spare)<\/td>\n<td>Folding chair or blanket<\/td>\n<td>Sturdy tripod<\/td>\n<\/tr>\n<tr>\n<td>Water and something to eat<\/td>\n<td>Cap and sun protection<\/td>\n<td>Lens solar filter<\/td>\n<\/tr>\n<tr>\n<td>Watch\/phone set to local time<\/td>\n<td>Power bank<\/td>\n<td>Telephoto lens (200\u2013500 mm ideal)<\/td>\n<\/tr>\n<tr>\n<td>Phone protection if you\u2019re photographing the partial phase<\/td>\n<td>Red torch (won\u2019t dazzle)<\/td>\n<td>Remote shutter or timer<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"fotografia\">Eclipse photography<\/h2>\n<p>Photographing an eclipse with the Sun at 2\u00b0 above the sea is difficult and beautiful at the same time. Ideas to get it right: <\/p>\n<ul>\n<li><strong>Partial phase:<\/strong> a solar filter on the lens is mandatory. Without it, you\u2019ll damage the sensor (and your eyesight if you use an optical viewfinder). <\/li>\n<li><strong>Totality:<\/strong> when the Sun is completely covered, remove the filter to capture the corona. Use varied exposures (bracketing) because the brightness range is enormous. Put the filter back on as soon as the first flash reappears.  <\/li>\n<li><strong>With a phone:<\/strong> solar filter in front of the lens during the partial phase; during totality you can remove it. Lock focus and exposure manually. <\/li>\n<li><strong>Composition:<\/strong> take advantage of how low the Sun is to include the sea, a lighthouse or a coastline silhouette. That\u2019s Menorca\u2019s big differentiator. <\/li>\n<li><strong>Golden tip:<\/strong> dedicate most of that little more than a minute to <strong>watching<\/strong>, not to the screen. The live corona cannot be captured in any photo. <\/li>\n<\/ul>\n<figure><img data-recalc-dims=\"1\" decoding=\"async\" loading=\"lazy\" style=\"max-width: 100%; height: auto;\" src=\"https:\/\/i0.wp.com\/voyagermenorca.com\/wp-content\/uploads\/2026\/07\/infografia-ajustes-camara-eclipse-menorca-2026.jpg?w=800&#038;ssl=1\" alt=\"Infographic with quick camera settings for photographing the solar eclipse: solar filter, ISO, aperture, shutter speed, and focus for the partial phase and totality\"><figcaption>Indicative camera settings for the partial phase (with mandatory solar filter) and totality. Check the histogram and adapt the exposure to your equipment. <\/figcaption><\/figure>\n<h2 id=\"familias\">Tips for families, children, older people and reduced mobility<\/h2>\n<h3>For families and children<\/h3>\n<ul>\n<li>It\u2019s a fantastic educational experience: explain beforehand how the Sun\u2013Earth\u2013Moon system works using a torch and two balls.<\/li>\n<li><strong>The Government recommends that children under six years of age do not directly observe the eclipse.<\/strong> For them, indirect projection, a screen, or television broadcast is advised.<\/li>\n<li>Other minors must be <strong>constantly supervised by an adult<\/strong>, with their own certified glasses throughout the partial phase.<\/li>\n<li>Choose a comfortable spot with nearby services (Cala en Bosc, Cala Blanca, Son Bou with shuttle bus) to have restrooms and shade during the long wait.<\/li>\n<li>Turn the afternoon into a picnic: it\u2019ll make the wait easier and create the memory.<\/li>\n<\/ul>\n<h3>For older people<\/h3>\n<ul>\n<li>Prioritize points with easy access and little walking: Son Blanc, Avinguda Los Delfines, or Cala Santandria.<\/li>\n<li>A chair with a backrest, plenty of water and sun protection; the wait can be several hours in the heat.<\/li>\n<li>Avoid narrow road accesses and the walking sections of the lighthouses, which are also regulated that day.<\/li>\n<li>The screens in Pla\u00e7a des Born (Ciutadella), Sa Pla\u00e7a (Alaior), or Ma\u00f3 port are a very convenient alternative.<\/li>\n<\/ul>\n<h3>For people with reduced mobility<\/h3>\n<ul>\n<li>The flat and paved official zones of Ciutadella\u2014<strong>Son Blanc and Avinguda Los Delfines<\/strong>\u2014and the <strong>Passeig Mar\u00edtim de Ciutadella<\/strong> are the best options: flat ground, western horizon, and services nearby.<\/li>\n<li>Some Ciutadella beaches have boardwalks; check which ones will keep access that day.<\/li>\n<li>Arrive well before 5:00 PM to secure an accessible parking space nearby, given the special traffic arrangements.<\/li>\n<li>Check <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">the official website<\/a> to see if the observation zones provide reserved spaces.<\/li>\n<\/ul>\n<h2 id=\"errores\">Mistakes most visitors make<\/h2>\n<ul>\n<li><strong>Choosing the site for the landscape and not for the western horizon.<\/strong> A beautiful viewpoint facing east or covered by a hill is not suitable for this eclipse.<\/li>\n<li><strong>Assuming an official zone is the best for viewing.<\/strong> ZOOs were chosen for safety and capacity, not visibility. Check your spot with Horitz\u00f3 2026. <\/li>\n<li><strong>Arriving late.<\/strong> In the official zones of Ciutadella, traffic closes from 5:00 PM and there are regulated roads: anyone leaving at the last minute may get stuck during totality.<\/li>\n<li><strong>Counting on arriving by car at Punta Nati or Cavalleria.<\/strong> Both accesses are regulated on August 12 and Punta Nati car park closes at 8:00 AM.<\/li>\n<li><strong>Using regular sunglasses.<\/strong>  They don\u2019t protect you. Only ISO 12312-2 certified glasses work. <\/li>\n<li><strong>Buying glasses on the day.<\/strong> They sell out; buy them in advance.<\/li>\n<li><strong>Not checking the actual horizon.<\/strong> A mast, a crane, or a bank of low clouds can block 2\u00b0.<\/li>\n<li><strong>Watching totality through your phone.<\/strong> Experience it with your eyes; the camera doesn&#8217;t capture what the eye sees.<\/li>\n<li><strong>Forgetting that it&#8217;s at sunset.<\/strong> Afterwards there&#8217;s no margin: the Sun sets. There will be no &#8220;second chance&#8221; that day. <\/li>\n<\/ul>\n<h2 id=\"historia\">Historical curiosities: how previous eclipses were experienced in Spain<\/h2>\n<p>August 12, 2026 won\u2019t be the first time the Balearics become a global stage for an eclipse. On <strong>August 30, 1905<\/strong>, a total solar eclipse crossed Spain and was visible as total from the islands. Unlike the 2026 eclipse, that one happened at <strong>midday<\/strong> (around 12:02 in the Balearics) and totality lasted almost <strong>four minutes<\/strong>, making it an extraordinary scientific opportunity.  <\/p>\n<p>It was a major social and scientific event. Dozens of international expeditions travelled to the mainland and the islands: British and German commissions and the Russian Academy of Sciences. In Burgos, hot-air balloons\u2014the <em>J\u00fapiter<\/em>, the <em>Urano<\/em> and the <em>Marte<\/em>\u2014were launched, and the young engineer <strong>Emilio Herrera<\/strong> became one of the first people to observe totality from the air, leaving a memorable description of the corona above a sea of clouds. In Mallorca, expeditions set up at the Son Espanyolet Velodrome and the Grand Hotel; factories were even ordered to close during the eclipse so smoke wouldn\u2019t cloud the atmosphere. One of the drivers of the British expedition, G. F. Chambers, ended up observing it <strong>from the sea<\/strong>\u2014an option that, with proper professional planning, still makes sense 121 years later.    <\/p>\n<p>In Spain as a whole, the last total solar eclipse before 2026 was on <strong>April 17, 1912<\/strong>. Those early years of the 20th century formed a historic &#8220;trio&#8221; (1900, 1905, and 1912) that the international astronomical community dubbed &#8220;the Spanish eclipses.&#8221; History rhymes: 2026, 2027, and 2028 form the new Iberian trio.  <\/p>\n<h2 id=\"perseidas\">A Golden End to the Night: The Perseids<\/h2>\n<p>The eclipse date coincides almost exactly with the peak of the <strong>Perseids<\/strong>, the famous August meteor shower. If the sky stays clear and you\u2019re at a dark spot on the west coast\u2014one of the Starlight maximum-darkness zones\u2014you can stay after sunset and enjoy a second astronomical show that same night: two celestial events in a single evening, something truly exceptional. Menorca, as a Starlight Reserve, is one of the best places in the Mediterranean for it.  <\/p>\n<h2 id=\"planificacion\">Complete day plan: final checklist<\/h2>\n<div style=\"overflow-x:auto;max-width:100%;-webkit-overflow-scrolling:touch;\">\n<table>\n<thead>\n<tr>\n<th>Before the day<\/th>\n<th>On August 12<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>Buy ISO 12312-2 glasses (in advance)<\/td>\n<td>Arrive at your spot before 5:00 PM (Ciutadella zones)<\/td>\n<\/tr>\n<tr>\n<td>Choose 1 official observation zone + 1 plan B<\/td>\n<td>Park early or use public transport \/ shuttle bus<\/td>\n<\/tr>\n<tr>\n<td>Download the Horitz\u00f3 Eclipsi 2026 app and check the horizon<\/td>\n<td>Position yourself facing west-northwest (azimuth \u2248 288\u00b0)<\/td>\n<\/tr>\n<tr>\n<td>Check AEMET forecast 3-4 days beforehand<\/td>\n<td>Glasses on from 7:37:16 PM (first contact)<\/td>\n<\/tr>\n<tr>\n<td>Consult access and restrictions on caib.es<\/td>\n<td>Remove glasses only when the Sun is completely covered<\/td>\n<\/tr>\n<tr>\n<td>Charge camera\/phone and prepare solar filter<\/td>\n<td>Put glasses back on at the first flash of light<\/td>\n<\/tr>\n<tr>\n<td>Prepare picnic, water, chair, sun protection<\/td>\n<td>Stay for the Perseids if the sky cooperates<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/div>\n<h2 id=\"faq\">Frequently Asked Questions<\/h2>\n<h3>What time is the eclipse in Menorca?<\/h3>\n<p>In Ciutadella, according to the IGN, the partial eclipse begins at <strong>7:37:16 PM<\/strong> and totality runs from <strong>8:30:16 PM to 8:31:27 PM<\/strong> (with the maximum at 8:30:51 PM). Sunset occurs at <strong>8:45:28 PM<\/strong>. Times may vary by a few seconds depending on the exact observation point.  <\/p>\n<h3>How long does totality last?<\/h3>\n<p>In Ciutadella, <strong>approximately 1 minute and 11 seconds<\/strong> (IGN data for the municipality). Menorca is the first point in the Balearic Islands where totality begins, with the Sun between 1.4\u00b0 and 2\u00b0 above the horizon depending on the location: the lowest altitude in all of Spain. <\/p>\n<h3>What are the official observation zones in Menorca?<\/h3>\n<p>Nine: <strong>Cala en Bosc, Cala Blanca, Avinguda Los Delfines, and Son Blanc<\/strong> (Ciutadella), <strong>Carrer des Tamarells<\/strong> (Platges de Fornells), <strong>Passeig Mar\u00edtim de Ma\u00f3<\/strong>, and the beaches of <strong>Son Bou, Sant Tom\u00e0s, and Talis<\/strong>. In the four Ciutadella zones, traffic closes from 5:00 PM. The Government reminds that these are the safest and most accessible points, not necessarily those with the best visibility.  <\/p>\n<h3>Will it get dark in Menorca?<\/h3>\n<p>Not completely, since it happens very close to sunset. The sky will darken noticeably, with a twilight tone in 360\u00b0, and the temperature will drop, but it won\u2019t be full night. <\/p>\n<h3>Do I need to go to a special place or can I see it from anywhere in Menorca?<\/h3>\n<p>The entire island is within the path of totality, so technically it can be seen from anywhere. What makes the difference is having a <strong>clear western horizon<\/strong>, because the Sun will be very low. If you can see it from your accommodation with a western horizon, it is the most comfortable and safest option.  <\/p>\n<h3>What if it&#8217;s cloudy that day?<\/h3>\n<p>August usually brings stable skies in Menorca, but no one guarantees it. High clouds allow you to see part of the phenomenon; low clouds on the western horizon could obscure totality. Check the forecast in the days leading up to it, verify your spot with the Horitz\u00f3 2026 app, and have a Plan B.  <\/p>\n<h3>How do I protect my eyes?<\/h3>\n<p>With <strong>ISO 12312-2 certified eclipse glasses<\/strong> whenever you look at the Sun during the partial phases. You can only remove them when the Sun is completely covered, and you must put them back on as soon as the first flash reappears. Sunglasses, X-rays, or smoked glass are not suitable.  <\/p>\n<h3>Can I take photos with my phone?<\/h3>\n<p>Yes, with a solar filter on the lens during the partial phase. You can remove it during totality. Manually lock focus and exposure and prepare your shot beforehand, because totality lasts little more than a minute.  <\/p>\n<h3>Is it safe for children?<\/h3>\n<p>The Government recommends that <strong>children under six years of age do not directly observe<\/strong> the eclipse: for them, indirect projection, a screen, or television broadcast. Other minors can observe it with certified glasses throughout the partial phase and under constant adult supervision. It is a magnificent educational experience.  <\/p>\n<h3>When was the last total eclipse visible in the Balearic Islands?<\/h3>\n<p>August 30, 1905. In Spain as a whole, the last total eclipse before 2026 was on <strong>April 17, 1912<\/strong>. After the total eclipse of August 2, 2027, there will be no other total eclipse in Spain until <strong>2053<\/strong>; the 2028 one will be <strong>annular<\/strong>, not total.  <\/p>\n<h3>Will there be traffic cuts or many people?<\/h3>\n<p>Yes. In the four official zones of Ciutadella, traffic closes <strong>from 5:00 PM<\/strong> (earlier if there are large crowds). In the rest of the island, restrictions depend on each road and municipality, generally <strong>between 3:00 PM and 9:00 PM<\/strong>. Access to Far de Punta Nati (CF-5, with parking closed from 8:00 AM), Cam\u00ed de Tramuntana, Far de Cavalleria (CF-3), and Monte Toro (Me-13) are regulated, in addition to closures in Ferreries and Sant Llu\u00eds. Consult the details in the <a href=\"#afluencia\">official arrangements<\/a> section.    <\/p>\n<h2 id=\"fuentes\">Official and Scientific Sources<\/h2>\n<p style=\"font-size:0.95em;\">The data in this guide comes from official and scientific sources, which we recommend consulting directly for the most up-to-date information:<\/p>\n<ul style=\"font-size:0.95em;\">\n<li><strong>National Geographic Institute (IGN)<\/strong> \u2014 <a href=\"https:\/\/eclipses.ign.es\/\" target=\"_blank\" rel=\"noopener\">eclipses.ign.es<\/a>, <a href=\"https:\/\/astronomia.ign.es\/eclipses-de-sol-y-luna\/eclipse-total-sol-de-12-de-agosto-2026\" target=\"_blank\" rel=\"noopener\">eclipse fact sheet<\/a>, and <a href=\"https:\/\/visualizadores.ign.es\/eclipses\" target=\"_blank\" rel=\"noopener\">eclipse viewer<\/a> (times and data by municipality).<\/li>\n<li><strong>Government of the Balearic Islands<\/strong> \u2014 <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/saber-ne-m%C3%A9s-preguntes-m%C3%A9s-freq%C3%BCents\" target=\"_blank\" rel=\"noopener\">official eclipse information and restrictions<\/a> and <a href=\"https:\/\/www.caib.es\/webgoib\/es\/-\/zones-d-observaci%C3%B3-oficial-zoo-\" target=\"_blank\" rel=\"noopener\">official observation zones (ZOO)<\/a>.<\/li>\n<li><strong>Island Council of Menorca and municipalities<\/strong> \u2014 island-wide mobility, access, and heritage protection arrangements.<\/li>\n<li><strong>Horitz\u00f3 Eclipsi 2026<\/strong> \u2014 <a href=\"https:\/\/www.horitzo2026.com\" target=\"_blank\" rel=\"noopener\">horitzo2026.com<\/a> (official visibility app based on the real horizon).<\/li>\n<li><strong>Ministry of Transport and Sustainable Mobility<\/strong> \u2014 <a href=\"https:\/\/www.transportes.gob.es\/movilidad-sostenible\/estudios-movilidad-big-data\/el-trio-de-eclipses-solares-y-la-movilidad\" target=\"_blank\" rel=\"noopener\">HERMES viewer and mobility study of the eclipse trio<\/a>.<\/li>\n<li><strong>NASA<\/strong> \u2014 <a href=\"https:\/\/science.nasa.gov\/eclipses\/safety\/\" target=\"_blank\" rel=\"noopener\">science.nasa.gov\/eclipses\/safety<\/a> (eye safety) and <a href=\"https:\/\/ciencia.nasa.gov\/eclipses\/lo-que-necesitas-saber-sobre-los-eclipses-solares\/\" target=\"_blank\" rel=\"noopener\">ciencia.nasa.gov<\/a>.<\/li>\n<li><strong>European Southern Observatory (ESO)<\/strong> \u2014 eye safety material.<\/li>\n<li><strong>Starlight Foundation<\/strong> and <strong>Island Council of Menorca<\/strong> \u2014 Starlight certification and night sky.<\/li>\n<li><strong>AEMET<\/strong> \u2014 weather forecast.<\/li>\n<\/ul>\n<div style=\"border:1px solid #d7a553;background:#fbf6ec;padding:22px 24px;margin:32px 0;border-radius:14px;text-align:center;\">\n<p style=\"margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:1.25em;color:#08243c;font-weight:700;\">Are you going to spend several days in Menorca?<\/p>\n<p style=\"margin:0 0 18px;color:#4d5f6d;\">Discover Ciutadella and the island&#8217;s history accompanied by a local official guide.<\/p>\n<p style=\"margin:0;\">\n<a href=\"https:\/\/voyagermenorca.com\/en\/field-trips\/\" style=\"display:inline-block;background:#08243c;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">See guided tours<\/a><br \/>\n<a href=\"https:\/\/api.whatsapp.com\/send?phone=34649902301\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;background:#1f7a4d;color:#fff;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:9px;margin:4px 6px;\">Contact via WhatsApp<\/a>\n<\/p>\n<\/div>\n<p style=\"font-size:0.9em;color:#666;\">Guide prepared by <strong>Daniel Vaquera Sintes<\/strong>, official tourism guide of Menorca (GT-0138-ME). <strong>Last updated: August 7, 2026<\/strong>, with the nine official observation zones (ZOO) of Menorca, the municipal times from the IGN, and the mobility and access arrangements published by the Government, the Island Council, and the municipalities. Measures may vary in the days leading up to the event depending on crowd levels: always check official information before traveling. <\/p>\n","protected":false},"excerpt":{"rendered":"<p>On August 12, 2026, Menorca will experience its first total solar eclipse in more than a century. Exact timings, the 9 official viewing zones (ZOO), the map of the west coast, and how to watch it safely. <\/p>\n","protected":false},"author":2,"featured_media":2328,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[72,322,272,97],"tags":[325,324,323],"class_list":["post-2286","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-discover-menorca","category-eclipse","category-starlight-destination","category-sunsets-in-menorca","tag-eclipse-2026","tag-menorca-eclipse","tag-starlight"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v28.3 (Yoast SEO v28.8) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Total Solar Eclipse in Menorca 2026: Time, Map, and Where to See It<\/title>\n<meta name=\"description\" content=\"Exact timings, interactive map, and the best places to see the total solar eclipse in Menorca on August 12, 2026, with safety tips.\" \/>\n<meta name=\"robots\" content